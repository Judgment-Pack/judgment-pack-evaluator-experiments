{
  "comment": "Cohort 2 case registry \u2014 the single source of truth. fixtures, Forge scenario YAML, and the jpack project matrix are GENERATED from this file by harness/generate.py; goldens/ verifies the `expect` member against the pinned evaluator. If a golden disagrees with `expect`, the golden governs and the discrepancy is recorded before freeze. Expected dispositions were derived by hand from JPS Core 0.2.0-draft \u00a77-\u00a78 and are a registered prediction, not an authority. Triage cases carry embargoedInformationToUnauthorizedRecipients explicitly: the pack's exception has onUnknown: escalate, so an absent embargo fact would add reason `unknown` to every disposition (confirmed by the quickstart project's fixtures, which always set it).",
  "packActionMaps": {
    "data-request-intake-triage.json": {
      "proceed": "execute:accept-request",
      "clarify-return": "record",
      "decline-redirect": "record"
    },
    "decimal-threshold-fee.json": {
      "standard-fee": "execute:charge-standard-fee",
      "reduced-fee": "execute:charge-reduced-fee",
      "exempt": "record"
    },
    "direct-exception-escalation.json": {
      "approve": "execute:release-request",
      "hold": "record"
    },
    "partial-trigger-conflict.json": {
      "track-a": "execute:route-track-a",
      "track-b": "execute:route-track-b"
    },
    "exception-force-outcome.json": {
      "accept": "execute:accept-item",
      "reject": "record"
    },
    "exception-suppress-rule.json": {
      "accept": "execute:accept-item",
      "reject": "record"
    }
  },

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:judgmentpack:experiment:semantic-source-response:1",
  "title": "Study 005 acquisition response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "facts",
    "evidenceAvailability",
    "acquisitionStatus",
    "sourceId",
    "explanation"
  ],
  "properties": {
    "facts": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {},
          "required": []
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["screening"],
          "properties": {
            "screening": {
              "type": "object",
              "additionalProperties": false,
              "required": ["matchCount"],
              "properties": {
                "matchCount": {
                  "type": "string"
                }
              }
            }
          }
        }
      ]
    },
    "evidenceAvailability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["screening-record"],
      "properties": {
        "screening-record": {
          "enum": ["present", "absent", "unknown"]
        }
      }
    },
    "acquisitionStatus": {
      "enum": ["resolved", "absent", "unknown", "ambiguous"]
    },
    "sourceId": {
      "type": ["string", "null"]
    },
    "explanation": {
      "type": "string"
    }
  }
}

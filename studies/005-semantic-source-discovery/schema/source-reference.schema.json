{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:judgmentpack:experiment:semantic-source-reference:1",
  "title": "Experimental semantic input-source reference",
  "description": "Study 005 treatment artifact. This is not JPS, not jpack.json, and never names or configures a connector.",
  "type": "object",
  "additionalProperties": false,
  "required": ["source", "sourceRef"],
  "properties": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$",
          "maxLength": 256
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      }
    },
    "sourceRef": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$",
      "maxLength": 256
    },
    "hint": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    }
  }
}

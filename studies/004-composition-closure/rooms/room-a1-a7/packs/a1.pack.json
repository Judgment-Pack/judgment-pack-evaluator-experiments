{
  "specVersion": "0.2.0-draft",
  "id": "https://example.com/judgment-packs/airline-agent/book-flight",
  "version": "0.1.0",
  "title": "Book flight — may this booking be made?",
  "description": "Encodes the Book flight section of the Airline Agent Policy as a gate on a proposed new reservation. Scope is limited to that section; preamble obligations and other sections are not encoded.",
  "decision": {
    "intent": "Decide whether a proposed new flight reservation satisfies every requirement stated in the Book flight section of the Airline Agent Policy before the booking is written to the booking database.",
    "question": "May this booking be made?"
  },
  "applicability": {
    "op": "fact",
    "path": "/request/type",
    "operator": "equals",
    "value": "book-flight"
  },
  "evidenceRequirements": [
    {
      "id": "user-id",
      "description": "The user id, obtained from the user before anything else in the booking flow.",
      "required": true,
      "kind": "fact"
    },
    {
      "id": "trip-parameters",
      "description": "Trip type, origin, and destination, asked of the user.",
      "required": true,
      "kind": "fact"
    },
    {
      "id": "passenger-details",
      "description": "First name, last name, and date of birth collected for every passenger on the reservation.",
      "required": true,
      "kind": "fact"
    },
    {
      "id": "travel-insurance-offer",
      "description": "A record that the agent asked the user whether they want to buy travel insurance.",
      "required": true,
      "kind": "attestation"
    }
  ],
  "sources": [
    {
      "id": "book-flight-identification",
      "title": "Airline Agent Policy — Book flight (identification and trip parameters)",
      "publisher": "Airline Agent Policy",
      "locator": {
        "kind": "path",
        "value": "reference/policy.md"
      },
      "citation": {
        "location": "## Book flight, opening paragraphs",
        "excerpt": "The agent must first obtain the user id from the user. The agent should then ask for the trip type, origin, destination."
      },
      "rights": "Exercise material supplied with the assignment."
    },
    {
      "id": "book-flight-cabin",
      "title": "Airline Agent Policy — Book flight (Cabin)",
      "publisher": "Airline Agent Policy",
      "locator": {
        "kind": "path",
        "value": "reference/policy.md"
      },
      "citation": {
        "location": "## Book flight → Cabin",
        "excerpt": "Cabin class must be the same across all the flights in a reservation."
      },
      "rights": "Exercise material supplied with the assignment."
    },
    {
      "id": "book-flight-passengers",
      "title": "Airline Agent Policy — Book flight (Passengers)",
      "publisher": "Airline Agent Policy",
      "locator": {
        "kind": "path",
        "value": "reference/policy.md"
      },
      "citation": {
        "location": "## Book flight → Passengers",
        "excerpt": "Each reservation can have at most five passengers. The agent needs to collect the first name, last name, and date of birth for each passenger. All passengers must fly the same flights in the same cabin."
      },
      "rights": "Exercise material supplied with the assignment."
    },
    {
      "id": "book-flight-payment",
      "title": "Airline Agent Policy — Book flight (Payment)",
      "publisher": "Airline Agent Policy",
      "locator": {
        "kind": "path",
        "value": "reference/policy.md"
      },
      "citation": {
        "location": "## Book flight → Payment",
        "excerpt": "Each reservation can use at most one travel certificate, at most one credit card, and at most three gift cards. The remaining amount of a travel certificate is not refundable. All payment methods must already be in user profile for safety reasons."
      },
      "rights": "Exercise material supplied with the assignment."
    },
    {
      "id": "book-flight-baggage",
      "title": "Airline Agent Policy — Book flight (Checked bag allowance)",
      "publisher": "Airline Agent Policy",
      "locator": {
        "kind": "path",
        "value": "reference/policy.md"
      },
      "citation": {
        "location": "## Book flight → Checked bag allowance",
        "excerpt": "If the booking user is a regular member: 0 free checked bag for each basic economy passenger; 1 free checked bag for each economy passenger; 2 free checked bags for each business passenger. If the booking user is a silver member: 1 / 2 / 3. If the booking user is a gold member: 2 / 3 / 4. Each extra baggage is 50 dollars. Do not add checked bags that the user does not need."
      },
      "rights": "Exercise material supplied with the assignment."
    },
    {
      "id": "book-flight-insurance",
      "title": "Airline Agent Policy — Book flight (Travel insurance)",
      "publisher": "Airline Agent Policy",
      "locator": {
        "kind": "path",
        "value": "reference/policy.md"
      },
      "citation": {
        "location": "## Book flight → Travel insurance",
        "excerpt": "The agent should ask if the user wants to buy the travel insurance. The travel insurance is 30 dollars per passenger and enables full refund if the user needs to cancel the flight given health or weather reasons."
      },
      "rights": "Exercise material supplied with the assignment."
    }
  ],
  "outcomes": [
    {
      "id": "book-allowed",
      "label": "Booking may be made",
      "description": "Every requirement stated in the Book flight section is satisfied by the proposed reservation. This is not an authorization to call the booking API; obligations outside the Book flight section are not evaluated here."
    },
    {
      "id": "book-denied",
      "label": "Booking must not be made as proposed",
      "description": "At least one requirement stated in the Book flight section is violated by the proposed reservation."
    }
  ],

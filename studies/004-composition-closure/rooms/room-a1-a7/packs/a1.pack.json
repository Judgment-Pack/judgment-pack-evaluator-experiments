    {
      "id": "deny-extra-baggage-fee-not-fifty",
      "description": "Deny when the reservation carries extra checked bags but does not charge 50 dollars for each of them.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/booking/baggage/extraCheckedBags",
            "operator": "not-equals",
            "value": 0
          },
          {
            "op": "fact",
            "path": "/booking/baggage/extraBaggageFeePerBagUsd",
            "operator": "not-equals",
            "value": 50
          }
        ]
      },
      "outcome": "book-denied",
      "onUnknown": "ignore",
      "sourceRefs": [
        "book-flight-baggage"
      ],
      "rationale": "\"Each extra baggage is 50 dollars.\" Read as a term the reservation must carry, so a proposed booking that prices extra bags differently is not the booking the section authorizes."
    },
    {
      "id": "deny-travel-insurance-price-not-thirty",
      "description": "Deny when travel insurance is purchased at a price other than 30 dollars per passenger.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/booking/travelInsurance/purchased",
            "operator": "equals",
            "value": true
          },
          {
            "op": "fact",
            "path": "/booking/travelInsurance/pricePerPassengerUsd",
            "operator": "not-equals",
            "value": 30
          }
        ]
      },
      "outcome": "book-denied",
      "onUnknown": "ignore",
      "sourceRefs": [
        "book-flight-insurance"
      ],
      "rationale": "\"The travel insurance is 30 dollars per passenger...\" Read as a term the reservation must carry when insurance is bought."
    }
  ],
  "escalation": {
    "triggers": [
      "missing-required-evidence",
      "unknown",
      "conflict",
      "no-match"
    ],
    "target": {
      "kind": "human-role",
      "name": "Airline human agent"
    },
    "message": "The Book flight requirements could not be resolved for this proposed reservation. If the reason is missing-required-evidence or unknown because information was simply not collected yet, the agent should collect it from the user and re-evaluate; the Airline Agent Policy transfers to a human only when the request cannot be handled within the agent's scope."
  },

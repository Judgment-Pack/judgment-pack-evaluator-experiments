        }
      },
      "outcome": "book-denied",
      "onUnknown": "ignore",
      "sourceRefs": [
        "book-flight-payment"
      ],
      "rationale": "\"...and at most three gift cards.\""
    },
    {
      "id": "deny-payment-method-not-in-user-profile",
      "description": "Deny when any payment method on the reservation is not already stored in the user profile.",
      "when": {
        "op": "fact",
        "path": "/booking/payment/allMethodsInUserProfile",
        "operator": "equals",
        "value": false
      },
      "outcome": "book-denied",
      "onUnknown": "ignore",
      "sourceRefs": [
        "book-flight-payment"
      ],
      "rationale": "\"All payment methods must already be in user profile for safety reasons.\""
    },
    {
      "id": "deny-unrequested-checked-bags",
      "description": "Deny when the reservation adds checked bags the user does not need.",
      "when": {
        "op": "fact",
        "path": "/booking/baggage/onlyBagsUserRequested",
        "operator": "equals",
        "value": false
      },
      "outcome": "book-denied",
      "onUnknown": "ignore",
      "sourceRefs": [
        "book-flight-baggage"
      ],
      "rationale": "\"Do not add checked bags that the user does not need.\""
    },

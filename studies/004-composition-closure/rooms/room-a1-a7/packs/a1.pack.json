      "rationale": "The Book flight section states its requirements as constraints on the reservation being created. A booking may be made only when none of them is violated, so this rule is the conjunction of the negations of every deny rule plus the collection obligations. onUnknown is escalate because an unverified requirement must never be read as a satisfied requirement."
    },
    {
      "id": "deny-cabin-class-not-uniform",
      "description": "Deny when the cabin class is not the same across all flights in the reservation.",
      "when": {
        "op": "fact",
        "path": "/booking/cabinClassUniformAcrossFlights",
        "operator": "equals",
        "value": false
      },
      "outcome": "book-denied",
      "onUnknown": "ignore",
      "sourceRefs": [
        "book-flight-cabin"
      ],
      "rationale": "\"Cabin class must be the same across all the flights in a reservation.\" onUnknown is ignore because the allow rule already blocks on the same unknown; a violation that cannot be established must not be asserted."
    },
    {
      "id": "deny-more-than-five-passengers",
      "description": "Deny when the reservation does not have between one and five passengers.",
      "when": {
        "op": "not",
        "condition": {
          "op": "fact",
          "path": "/booking/passengerCount",
          "operator": "in",
          "value": [
            1,
            2,
            3,
            4,
            5
          ]
        }
      },
      "outcome": "book-denied",
      "onUnknown": "ignore",
      "sourceRefs": [
        "book-flight-passengers"
      ],
      "rationale": "\"Each reservation can have at most five passengers.\" Membership in the explicit set 1..5 is used instead of an ordered comparison because §2.2 assigns no portable ordering to decimal operands."
    },
    {
      "id": "deny-passengers-not-on-same-flights-and-cabin",
      "description": "Deny when the passengers do not all fly the same flights in the same cabin.",
      "when": {
        "op": "fact",
        "path": "/booking/allPassengersOnSameFlightsAndCabin",
        "operator": "equals",
        "value": false
      },
      "outcome": "book-denied",
      "onUnknown": "ignore",
      "sourceRefs": [
        "book-flight-passengers"
      ],
      "rationale": "\"All passengers must fly the same flights in the same cabin.\""
    },
    {
      "id": "deny-more-than-one-travel-certificate",
      "description": "Deny when the reservation uses more than one travel certificate.",
      "when": {
        "op": "not",
        "condition": {
          "op": "fact",
          "path": "/booking/payment/travelCertificateCount",
          "operator": "in",
          "value": [
            0,
            1
          ]
        }
      },
      "outcome": "book-denied",
      "onUnknown": "ignore",
      "sourceRefs": [
        "book-flight-payment"
      ],
      "rationale": "\"Each reservation can use at most one travel certificate...\""
    },
    {
      "id": "deny-more-than-one-credit-card",

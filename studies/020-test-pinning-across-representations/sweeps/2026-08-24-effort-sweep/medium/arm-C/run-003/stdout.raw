package study_test

import data.study

financial_evidence := {"financial-evidence": "present"}

test_p1_absent_financial_evidence_prevents_rejection if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["missing-required-evidence"],
	} with input as {
		"vendor": {
			"riskScore": 95,
			"requestedSpend": 100,
			"sanctionsStatus": "MATCH",
			"countryRisk": "HIGH",
		},
		"evidence": {"financial-evidence": "absent"},
	}
}

test_p1_unreported_financial_evidence_is_unknown if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["unknown"],
	} with input as {
		"vendor": {
			"riskScore": 10,
			"requestedSpend": 100,
			"sanctionsStatus": "CLEAR",
			"countryRisk": "LOW",
		},
	}
}

test_d1_sanctions_match_rejects if {

POLICY:
```rego
package study

default decision := {"disposition": "unresolved", "reasons": ["no-match"]}

vendor := object.get(input, "vendor", {})

evidence := object.get(input, "evidence", {})

financial_status := object.get(evidence, "financial-evidence", "unreported")

insurance_status := object.get(evidence, "insurance-certificate", "unreported")

decision := {"disposition": "unresolved", "reasons": ["missing-required-evidence"]} if {
	financial_status == "absent"
} else := {"disposition": "unresolved", "reasons": ["unknown"]} if {
	financial_status == "unreported"
} else := result if {
	financial_status == "present"
	outcomes := candidate_outcomes
	count(outcomes) == 1
	some result in outcomes
} else := {"disposition": "unresolved", "reasons": ["unknown"]} if {
	financial_status == "present"
	count(candidate_outcomes) > 1
}

candidate_outcomes := {
	result |
	some risk in risk_values
	some spend in spend_values
	some country in country_values
	result := readable_outcome(risk, spend, country)
}

risk_values := [risk] if {
	risk := object.get(vendor, "riskScore", -1)
	risk != -1
} else := numbers.range(0, 100)

spend_values := [spend] if {
	spend := object.get(vendor, "requestedSpend", -1)
	spend != -1
} else := [
	0,
	100000,
	100000.01,
	500000,
	500000.01,
	2000000,
	2000000.01,
]

country_values := [country] if {
	country := object.get(vendor, "countryRisk", "")
	country != ""
} else := ["LOW", "MEDIUM", "HIGH"]

readable_outcome(risk, spend, country) := {
	"disposition": "unresolved",
	"reasons": ["exception-escalation"],
} if {
	object.get(vendor, "sanctionsStatus", "") == "CLEAR"
	country == "HIGH"
	spend > 2000000
} else := {
	"disposition": "reject",
	"reasons": [],
} if {
	object.get(vendor, "sanctionsStatus", "") == "MATCH"
} else := {
	"disposition": "unresolved",
	"reasons": ["no-match"],
} if {
	object.get(vendor, "sanctionsStatus", "") == "UNKNOWN"
} else := {
	"disposition": "review",
	"reasons": [],
} if {
	object.get(vendor, "sanctionsStatus", "") == "CLEAR"
	object.get(vendor, "criticalSupplier", "no") == "yes"
} else := {
	"disposition": "reject",
	"reasons": [],
} if {
	object.get(vendor, "sanctionsStatus", "") == "CLEAR"
	risk >= 90
} else := {
	"disposition": "reject",
	"reasons": [],
} if {
	object.get(vendor, "sanctionsStatus", "") == "CLEAR"
	country == "HIGH"
	risk >= 70
} else := {
	"disposition": "reject",
	"reasons": [],
} if {
	object.get(vendor, "sanctionsStatus", "") == "CLEAR"
	object.get(vendor, "priorEnforcement", "no") == "yes"
} else := {
	"disposition": "approve",
	"reasons": [],
} if {
	object.get(vendor, "sanctionsStatus", "") == "CLEAR"
	country == "LOW"
	risk < 40
	spend <= 500000
} else := {
	"disposition": "approve",
	"reasons": [],
} if {
	object.get(vendor, "sanctionsStatus", "") == "CLEAR"
	country == "LOW"
	risk < 40
	spend > 500000
	spend <= 2000000
	insurance_status == "present"
} else := {
	"disposition": "enhanced-review",
	"reasons": [],
} if {
	object.get(vendor, "sanctionsStatus", "") == "CLEAR"
	country == "LOW"
	risk < 40
	spend > 500000
	spend <= 2000000
	insurance_status == "absent"
} else := {
	"disposition": "unresolved",
	"reasons": ["unknown"],
} if {
	object.get(vendor, "sanctionsStatus", "") == "CLEAR"
	country == "LOW"
	risk < 40
	spend > 500000
	spend <= 2000000
	insurance_status == "unreported"
} else := {
	"disposition": "approve",
	"reasons": [],
} if {
	object.get(vendor, "sanctionsStatus", "") == "CLEAR"
	country == "LOW"
	risk >= 40
	risk < 70
	spend <= 100000
	object.get(vendor, "newVendor", "no") != "yes"
} else := {
	"disposition": "approve",
	"reasons": [],
} if {
	object.get(vendor, "sanctionsStatus", "") == "CLEAR"
	country == "MEDIUM"
	risk < 40
	spend <= 100000
} else := {
	"disposition": "review",
	"reasons": [],
} if {
	object.get(vendor, "sanctionsStatus", "") == "CLEAR"
}
```


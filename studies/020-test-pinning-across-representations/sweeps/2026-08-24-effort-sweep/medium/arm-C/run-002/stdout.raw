POLICY:
```rego
package study

default decision := {"disposition": "unresolved", "reasons": ["no-match"]}

decision := {"disposition": "unresolved", "reasons": ["missing-required-evidence"]} if {
	evidence := object.get(input, "evidence", {})
	object.get(evidence, "financial-evidence", "unreported") == "absent"
} else := {"disposition": "unresolved", "reasons": ["unknown"]} if {
	evidence := object.get(input, "evidence", {})
	object.get(evidence, "financial-evidence", "unreported") == "unreported"
} else := {"disposition": "reject", "reasons": []} if {
	vendor := object.get(input, "vendor", {})
	object.get(vendor, "sanctionsStatus", "unreported") == "MATCH"
} else := {"disposition": "unresolved", "reasons": ["no-match"]} if {
	vendor := object.get(input, "vendor", {})
	object.get(vendor, "sanctionsStatus", "unreported") == "UNKNOWN"
} else := result if {
	vendor := object.get(input, "vendor", {})
	object.get(vendor, "sanctionsStatus", "unreported") == "CLEAR"
	count(possible_outcomes) == 1
	some result in possible_outcomes
} else := {"disposition": "unresolved", "reasons": ["unknown"]} if {
	vendor := object.get(input, "vendor", {})
	object.get(vendor, "sanctionsStatus", "unreported") == "CLEAR"
	count(possible_outcomes) > 1
}

risk_values contains risk if {
	vendor := object.get(input, "vendor", {})
	"riskScore" in object.keys(vendor)
	risk := vendor.riskScore
}

risk_values contains risk if {
	vendor := object.get(input, "vendor", {})
	not "riskScore" in object.keys(vendor)
	some risk in numbers.range(0, 100)
}

spend_values contains spend if {
	vendor := object.get(input, "vendor", {})
	"requestedSpend" in object.keys(vendor)
	spend := vendor.requestedSpend
}

spend_values contains spend if {
	vendor := object.get(input, "vendor", {})
	not "requestedSpend" in object.keys(vendor)
	some spend in [
		0,
		100000,
		100000.01,
		500000,
		500000.01,
		2000000,
		2000000.01,
	]
}

country_values contains country if {
	vendor := object.get(input, "vendor", {})
	"countryRisk" in object.keys(vendor)
	country := vendor.countryRisk
}

country_values contains country if {
	vendor := object.get(input, "vendor", {})
	not "countryRisk" in object.keys(vendor)
	some country in ["LOW", "MEDIUM", "HIGH"]
}

possible_outcomes := {
	result |
	some risk in risk_values
	some spend in spend_values
	some country in country_values
	result := outcome(risk, spend, country)
}

outcome(_, spend, country) := {
	"disposition": "unresolved",
	"reasons": ["exception-escalation"],
} if {
	country == "HIGH"
	spend > 2000000
} else := {"disposition": "review", "reasons": []} if {
	vendor := object.get(input, "vendor", {})
	object.get(vendor, "criticalSupplier", "no") == "yes"
} else := {"disposition": "reject", "reasons": []} if {
	risk >= 90
} else := {"disposition": "reject", "reasons": []} if {
	country == "HIGH"
	risk >= 70
} else := {"disposition": "reject", "reasons": []} if {
	vendor := object.get(input, "vendor", {})
	object.get(vendor, "priorEnforcement", "no") == "yes"
} else := {"disposition": "approve", "reasons": []} if {
	country == "LOW"
	risk < 40
	spend <= 500000
} else := {"disposition": "approve", "reasons": []} if {
	country == "LOW"
	risk < 40
	spend > 500000
	spend <= 2000000
	evidence := object.get(input, "evidence", {})
	object.get(evidence, "insurance-certificate", "unreported") == "present"
} else := {"disposition": "enhanced-review", "reasons": []} if {
	country == "LOW"
	risk < 40
	spend > 500000
	spend <= 2000000
	evidence := object.get(input, "evidence", {})
	object.get(evidence, "insurance-certificate", "unreported") == "absent"
} else := {"disposition": "unresolved", "reasons": ["unknown"]} if {
	country == "LOW"
	risk < 40
	spend > 500000
	spend <= 2000000
	evidence := object.get(input, "evidence", {})
	object.get(evidence, "insurance-certificate", "unreported") == "unreported"
} else := {"disposition": "approve", "reasons": []} if {
	country == "LOW"
	risk >= 40
	risk < 70
	spend <= 100000
	vendor := object.get(input, "vendor", {})
	object.get(vendor, "newVendor", "no") != "yes"
} else := {"disposition": "approve", "reasons": []} if {
	country == "MEDIUM"
	risk < 40
	spend <= 100000
} else := {"disposition": "review", "reasons": []} if {
	true
}
```

TESTS:
```rego
package study_test

import data.study

test_financial_evidence_absent_precedes_rejection if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["missing-required-evidence"],
	} with input as {
		"vendor": {
			"riskScore": 99,
			"requestedSpend": 100,
			"sanctionsStatus": "MATCH",
			"countryRisk": "HIGH",
			"priorEnforcement": "yes",
		},
		"evidence": {"financial-evidence": "absent"},
	}
}

test_unreported_financial_evidence_is_unknown if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["unknown"],
	} with input as {
		"vendor": {
			"riskScore": 10,
			"requestedSpend": 100,
			"sanctionsStatus": "CLEAR",
			"countryRisk": "LOW",
		},
		"evidence": {},
	}
}

test_sanctions_match_rejects if {
	study.decision == {"disposition": "reject", "reasons": []} with input as {
		"vendor": {
			"sanctionsStatus": "MATCH",
			"criticalSupplier": "yes",
		},
		"evidence": {"financial-evidence": "present"},
	}
}


            "operator": "equals",
            "value": "HIGH"
          },
          {
            "op": "fact",
            "path": "/vendor/requestedSpend",
            "operator": "greater-than",
            "value": "2000000.00"
          }
        ]
      },
      "effect": "escalate",
      "onUnknown": "escalate"
    },
    {
      "id": "o-two-critical-supplier",
      "description": "O2 forces review for a critical supplier with a clear screening result when O3 does not block resolution.",
      "when": {

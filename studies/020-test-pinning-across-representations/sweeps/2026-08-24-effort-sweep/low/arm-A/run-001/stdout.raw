  "exceptions": [
    {
      "id": "o-three-large-high-risk-exposure",
      "description": "O3: escalate a clear-screened high-country-risk request above 2000000 dollars for human determination.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "fact",
            "path": "/vendor/countryRisk",
            "operator": "equals",
            "value": "HIGH"
          },
          {
            "op": "fact",
            "path": "/vendor/requestedSpend",
            "operator": "greater-than",
            "value": "2000000.00"
          }
        ]
      },
      "effect": "escalate",
      "onUnknown": "escalate"
    },
    {
      "id": "o-two-critical-supplier",
      "description": "O2: force review for a critical supplier with a clear sanctions result.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "fact",
            "path": "/vendor/criticalSupplier",
            "operator": "equals",
            "value": "yes"
          }
        ]
      },
      "effect": "force-outcome",
      "outcome": "review",
      "onUnknown": "ignore"
    },
    {
      "id": "o-one-new-vendor-suspension",
      "description": "O1: suppress D6c for a new vendor.",
      "when": {
        "op": "fact",
        "path": "/vendor/newVendor",
        "operator": "equals",
        "value": "yes"
      },
      "effect": "suppress-rule",
      "targetRule": "d-six-c-low-moderate-risk-approval",
      "onUnknown": "ignore"
    },
    {
      "id": "prior-enforcement-suppresses-d-six-a",
      "description": "Prior enforcement prevents D6a approval.",
      "when": {
        "op": "fact",
        "path": "/vendor/priorEnforcement",
        "operator": "equals",
        "value": "yes"
      },
      "effect": "suppress-rule",
      "targetRule": "d-six-a-low-basic-approval",
      "onUnknown": "ignore"
    },
    {
      "id": "prior-enforcement-suppresses-d-six-b-approve",
      "description": "Prior enforcement prevents D6b approval.",
      "when": {
        "op": "fact",
        "path": "/vendor/priorEnforcement",
        "operator": "equals",
        "value": "yes"
      },
      "effect": "suppress-rule",
      "targetRule": "d-six-b-insured-approval",
      "onUnknown": "ignore"
    },
    {
      "id": "prior-enforcement-suppresses-d-six-b-enhanced",
      "description": "Prior enforcement prevents D6b enhanced review because D5 rejects first.",
      "when": {
        "op": "fact",
        "path": "/vendor/priorEnforcement",
        "operator": "equals",
        "value": "yes"
      },
      "effect": "suppress-rule",
      "targetRule": "d-six-b-uninsured-enhanced-review",
      "onUnknown": "ignore"
    },
    {
      "id": "prior-enforcement-suppresses-d-six-c",
      "description": "Prior enforcement prevents D6c approval.",
      "when": {
        "op": "fact",
        "path": "/vendor/priorEnforcement",
        "operator": "equals",
        "value": "yes"
      },
      "effect": "suppress-rule",
      "targetRule": "d-six-c-low-moderate-risk-approval",
      "onUnknown": "ignore"
    },
    {
      "id": "prior-enforcement-suppresses-d-seven",
      "description": "Prior enforcement prevents D7 approval.",
      "when": {
        "op": "fact",
        "path": "/vendor/priorEnforcement",
        "operator": "equals",
        "value": "yes"
      },
      "effect": "suppress-rule",
      "targetRule": "d-seven-medium-approval",
      "onUnknown": "ignore"
    }
  ],
  "escalation": {
    "triggers": [
      "missing-required-evidence",
      "no-match",
      "unknown"
    ],
    "target": {
      "kind": "queue",
      "name": "vendor-compliance-desk"
    }
  }
}

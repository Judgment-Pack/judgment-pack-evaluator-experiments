  ],
  "exceptions": [
    {
      "id": "o3-large-high-country-exposure",
      "description": "Escalate a CLEAR HIGH-country request above 2000000.00 for human determination.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "fact",
            "path": "/vendor/countryRisk",
            "operator": "equals",
            "value": "HIGH"
          },
          {
            "op": "fact",
            "path": "/vendor/requestedSpend",
            "operator": "greater-than",
            "value": "2000000.00"
          }
        ]
      },
      "effect": "escalate",
      "onUnknown": "escalate"
    },
    {
      "id": "o2-critical-supplier",
      "description": "Force review for a critical supplier with a CLEAR screening result.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "fact",
            "path": "/vendor/criticalSupplier",
            "operator": "equals",
            "value": "yes"
          }
        ]
      },
      "effect": "force-outcome",
      "outcome": "review",
      "onUnknown": "ignore"
    },
    {
      "id": "o1-suppress-d6c",
      "description": "Suspend D6c for a reported new vendor.",
      "when": {
        "op": "fact",
        "path": "/vendor/newVendor",
        "operator": "equals",
        "value": "yes"
      },
      "effect": "suppress-rule",
      "targetRule": "d6c-moderate-risk-low-spend",
      "onUnknown": "ignore"
    },
    {
      "id": "d5-suppress-d6a",
      "description": "Prevent D6a from competing with prior-enforcement rejection.",
      "when": {
        "op": "fact",
        "path": "/vendor/priorEnforcement",
        "operator": "equals",
        "value": "yes"
      },
      "effect": "suppress-rule",
      "targetRule": "d6a-low-risk-low-spend",
      "onUnknown": "ignore"
    },
    {
      "id": "d5-suppress-d6b-approval",
      "description": "Prevent insured D6b approval from competing with prior-enforcement rejection.",
      "when": {
        "op": "fact",
        "path": "/vendor/priorEnforcement",
        "operator": "equals",
        "value": "yes"
      },
      "effect": "suppress-rule",
      "targetRule": "d6b-insured-approval",
      "onUnknown": "ignore"
    },
    {
      "id": "d5-suppress-d6b-enhanced",
      "description": "Prevent D6b enhanced review from competing with prior-enforcement rejection.",
      "when": {
        "op": "fact",
        "path": "/vendor/priorEnforcement",
        "operator": "equals",
        "value": "yes"
      },
      "effect": "suppress-rule",
      "targetRule": "d6b-uninsured-enhanced-review",
      "onUnknown": "ignore"
    },
    {
      "id": "d5-suppress-d6c",
      "description": "Prevent D6c approval from competing with prior-enforcement rejection.",
      "when": {
        "op": "fact",
        "path": "/vendor/priorEnforcement",
        "operator": "equals",
        "value": "yes"
      },
      "effect": "suppress-rule",
      "targetRule": "d6c-moderate-risk-low-spend",
      "onUnknown": "ignore"
    },
    {
      "id": "d5-suppress-d7",
      "description": "Prevent D7 approval from competing with prior-enforcement rejection.",
      "when": {
        "op": "fact",
        "path": "/vendor/priorEnforcement",
        "operator": "equals",
        "value": "yes"
      },
      "effect": "suppress-rule",
      "targetRule": "d7-medium-country-approval",
      "onUnknown": "ignore"
    },
    {
      "id": "d5-suppress-d8",
      "description": "Prevent residual review from competing with prior-enforcement rejection.",
      "when": {
        "op": "fact",
        "path": "/vendor/priorEnforcement",
        "operator": "equals",
        "value": "yes"
      },
      "effect": "suppress-rule",
      "targetRule": "d8-residual-review",
      "onUnknown": "ignore"
    },
    {
      "id": "d5-suppress-o1-review",
      "description": "Prevent O1 review from competing with prior-enforcement rejection.",
      "when": {
        "op": "fact",
        "path": "/vendor/priorEnforcement",
        "operator": "equals",
        "value": "yes"
      },
      "effect": "suppress-rule",
      "targetRule": "o1-new-vendor-review",
      "onUnknown": "ignore"
    }
  ],
  "escalation": {
    "triggers": [
      "missing-required-evidence",
      "no-match",
      "unknown"
    ],
    "target": {
      "kind": "queue",
      "name": "vendor-compliance-desk"
    }
  }
}

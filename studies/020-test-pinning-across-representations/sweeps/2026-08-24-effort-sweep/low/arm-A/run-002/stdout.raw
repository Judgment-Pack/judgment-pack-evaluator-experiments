{
  "matrixVersion": "2",
  "cases": [
    {
      "id": "p1-financial-evidence-absent-blocks-match-rejection",
      "facts": {
        "vendor": {
          "riskScore": "95",
          "requestedSpend": "3000000.00",
          "sanctionsStatus": "MATCH",
          "countryRisk": "HIGH",
          "newVendor": "no",
          "criticalSupplier": "no",
          "priorEnforcement": "yes"
        }
      },
      "evidenceAvailability": {
        "financial-evidence": "absent"
      },
      "expectedDisposition": {
        "kind": "unresolved",
        "reasons": [
          "missing-required-evidence"
        ],
        "handoff": {
          "state": "requested",
          "triggeredBy": [
            "missing-required-evidence"
          ]
        }
      },

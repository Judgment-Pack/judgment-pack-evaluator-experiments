POLICY:
```rego
package study

default decision := {"disposition": "unresolved", "reasons": ["no-match"]}

vendor := object.get(input, "vendor", {})

evidence := object.get(input, "evidence", {})

determination(disposition) := {
	"disposition": disposition,
	"reasons": [],
}

unresolved(reason) := {
	"disposition": "unresolved",
	"reasons": [reason],
}

risk_values := {0, 39, 40, 69, 70, 89, 90, 100}

spend_values := {
	0,
	100000,
	500000,
	500001,
	2000000,
	2000001,
	10000000,
}

country_values := {"LOW", "MEDIUM", "HIGH"}

candidate_risks contains risk if {
	"riskScore" in vendor
	risk := vendor.riskScore
}

candidate_risks contains risk if {
	not "riskScore" in vendor
	some risk in risk_values
}

candidate_spends contains spend if {
	"requestedSpend" in vendor
	spend := vendor.requestedSpend
}

candidate_spends contains spend if {
	not "requestedSpend" in vendor
	some spend in spend_values
}

candidate_countries contains country if {
	"countryRisk" in vendor
	country := vendor.countryRisk
}

candidate_countries contains country if {
	not "countryRisk" in vendor
	some country in country_values
}

# This function evaluates one fully readable assignment. Its else chain encodes
# O3, O2, and D1-D8 in their required precedence order.
readable_outcome(risk, spend, country) := determination("reject") if {
	vendor.sanctionsStatus == "MATCH"
} else := unresolved("no-match") if {
	vendor.sanctionsStatus == "UNKNOWN"
} else := unresolved("exception-escalation") if {
	vendor.sanctionsStatus == "CLEAR"
	country == "HIGH"
	spend > 2000000
} else := determination("review") if {
	vendor.sanctionsStatus == "CLEAR"
	object.get(vendor, "criticalSupplier", "no") == "yes"
} else := determination("reject") if {
	vendor.sanctionsStatus == "CLEAR"
	risk >= 90
} else := determination("reject") if {
	vendor.sanctionsStatus == "CLEAR"
	country == "HIGH"
	risk >= 70
} else := determination("reject") if {
	vendor.sanctionsStatus == "CLEAR"
	object.get(vendor, "priorEnforcement", "no") == "yes"
} else := determination("approve") if {
	vendor.sanctionsStatus == "CLEAR"
	object.get(vendor, "priorEnforcement", "no") != "yes"
	country == "LOW"
	risk < 40
	spend <= 500000
} else := determination("approve") if {
	vendor.sanctionsStatus == "CLEAR"
	object.get(vendor, "priorEnforcement", "no") != "yes"
	country == "LOW"
	risk < 40
	spend > 500000
	spend <= 2000000
	evidence["insurance-certificate"] == "present"
} else := determination("enhanced-review") if {
	vendor.sanctionsStatus == "CLEAR"
	object.get(vendor, "priorEnforcement", "no") != "yes"
	country == "LOW"
	risk < 40
	spend > 500000
	spend <= 2000000
	evidence["insurance-certificate"] == "absent"
} else := unresolved("unknown") if {
	vendor.sanctionsStatus == "CLEAR"
	object.get(vendor, "priorEnforcement", "no") != "yes"
	country == "LOW"
	risk < 40
	spend > 500000
	spend <= 2000000
	not "insurance-certificate" in evidence
} else := determination("approve") if {
	vendor.sanctionsStatus == "CLEAR"
	object.get(vendor, "priorEnforcement", "no") != "yes"
	country == "LOW"
	risk >= 40
	risk < 70
	spend <= 100000
	object.get(vendor, "newVendor", "no") != "yes"
} else := determination("approve") if {
	vendor.sanctionsStatus == "CLEAR"
	object.get(vendor, "priorEnforcement", "no") != "yes"
	country == "MEDIUM"
	risk < 40
	spend <= 100000
} else := determination("review") if {
	vendor.sanctionsStatus == "CLEAR"
}

possible_outcomes := {outcome |
	some risk in candidate_risks
	some spend in candidate_spends
	some country in candidate_countries
	outcome := readable_outcome(risk, spend, country)
}

decision := unresolved("missing-required-evidence") if {
	evidence["financial-evidence"] == "absent"
} else := unresolved("unknown") if {
	not "financial-evidence" in evidence
} else := outcome if {
	evidence["financial-evidence"] == "present"
	count(possible_outcomes) == 1
	some outcome in possible_outcomes
} else := unresolved("unknown") if {
	evidence["financial-evidence"] == "present"
	count(possible_outcomes) != 1
}
```

TESTS:
```rego
package study_test

import data.study

present_financial := {
	"financial-evidence": "present",
}

test_missing_financial_evidence_precedes_sanctions_rejection if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["missing-required-evidence"],
	} with input as {
		"vendor": {
			"riskScore": 100,
			"requestedSpend": 100,
			"sanctionsStatus": "MATCH",
			"countryRisk": "HIGH",
		},
		"evidence": {
			"financial-evidence": "absent",
		},
	}
}

test_unreported_financial_evidence_is_unknown if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["unknown"],
	} with input as {
		"vendor": {
			"riskScore": 10,
			"requestedSpend": 100,
			"sanctionsStatus": "CLEAR",
			"countryRisk": "LOW",
		},
		"evidence": {},
	}
}

test_sanctions_match_rejects if {
	study.decision == {
		"disposition": "reject",
		"reasons": [],
	} with input as {
		"vendor": {
			"riskScore": 10,
			"requestedSpend": 100,
			"sanctionsStatus": "MATCH",
			"countryRisk": "LOW",
			"criticalSupplier": "yes",
		},
		"evidence": present_financial,
	}
}

test_unknown_sanctions_has_no_match if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["no-match"],
	} with input as {
		"vendor": {
			"riskScore": 10,
			"requestedSpend": 100,
			"sanctionsStatus": "UNKNOWN",
			"countryRisk": "LOW",
		},
		"evidence": present_financial,
	}
}

test_o3_escalation_precedes_critical_supplier_and_rejection if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["exception-escalation"],
	} with input as {
		"vendor": {
			"riskScore": 100,
			"requestedSpend": 2000000.01,
			"sanctionsStatus": "CLEAR",
			"countryRisk": "HIGH",
			"criticalSupplier": "yes",
			"priorEnforcement": "yes",
		},
		"evidence": present_financial,
	}
}

test_critical_supplier_override_reviews if {
	study.decision == {
		"disposition": "review",
		"reasons": [],
	} with input as {
		"vendor": {
			"riskScore": 95,
			"requestedSpend": 100,
			"sanctionsStatus": "CLEAR",
			"countryRisk": "LOW",
			"criticalSupplier": "yes",
		},
		"evidence": present_financial,
	}
}

test_d3_boundary_rejects if {
	study.decision.disposition == "reject" with input as {
		"vendor": {
			"riskScore": 90,
			"requestedSpend": 100,
			"sanctionsStatus": "CLEAR",
			"countryRisk": "MEDIUM",
		},
		"evidence": present_financial,
	}
}

test_d4_boundary_rejects if {
	study.decision.disposition == "reject" with input as {
		"vendor": {
			"riskScore": 70,
			"requestedSpend": 100,
			"sanctionsStatus": "CLEAR",
			"countryRisk": "HIGH",
		},
		"evidence": present_financial,

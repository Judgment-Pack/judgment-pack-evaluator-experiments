POLICY:
```rego
package study

default decision := {"disposition": "unresolved", "reasons": ["no-match"]}

decision := {"disposition": "unresolved", "reasons": ["missing-required-evidence"]} if {
	evidence := object.get(input, "evidence", {})
	evidence["financial-evidence"] == "absent"
} else := {"disposition": "unresolved", "reasons": ["unknown"]} if {
	evidence := object.get(input, "evidence", {})
	not "financial-evidence" in object.keys(evidence)
} else := {"disposition": "reject", "reasons": []} if {
	input.evidence["financial-evidence"] == "present"
	input.vendor.sanctionsStatus == "MATCH"
} else := {"disposition": "unresolved", "reasons": ["no-match"]} if {
	input.evidence["financial-evidence"] == "present"
	input.vendor.sanctionsStatus == "UNKNOWN"
} else := result if {
	input.evidence["financial-evidence"] == "present"
	input.vendor.sanctionsStatus == "CLEAR"
	results := possible_results
	count(results) == 1
	some result in results
} else := {"disposition": "unresolved", "reasons": ["unknown"]} if {
	input.evidence["financial-evidence"] == "present"
	input.vendor.sanctionsStatus == "CLEAR"
	count(possible_results) > 1
}

risk_values := [input.vendor.riskScore] if {
	"riskScore" in object.keys(input.vendor)
} else := [0, 39, 40, 69, 70, 89, 90, 100] if {
	not "riskScore" in object.keys(input.vendor)
}

spend_values := [input.vendor.requestedSpend] if {
	"requestedSpend" in object.keys(input.vendor)
} else := [
	0,
	100000,
	100000.01,
	500000,
	500000.01,
	2000000,
	2000000.01,
	10000000,
] if {
	not "requestedSpend" in object.keys(input.vendor)
}

country_values := [input.vendor.countryRisk] if {
	"countryRisk" in object.keys(input.vendor)
} else := ["LOW", "MEDIUM", "HIGH"] if {
	not "countryRisk" in object.keys(input.vendor)
}

possible_results contains result if {
	some risk in risk_values
	some spend in spend_values
	some country in country_values
	vendor := object.union(input.vendor, {
		"riskScore": risk,
		"requestedSpend": spend,
		"countryRisk": country,
	})
	result := readable_result(vendor)
}

readable_result(vendor) := {"disposition": "unresolved", "reasons": ["exception-escalation"]} if {
	vendor.countryRisk == "HIGH"
	vendor.requestedSpend > 2000000
} else := {"disposition": "review", "reasons": []} if {
	object.get(vendor, "criticalSupplier", "no") == "yes"
} else := {"disposition": "reject", "reasons": []} if {
	vendor.riskScore >= 90
} else := {"disposition": "reject", "reasons": []} if {
	vendor.countryRisk == "HIGH"
	vendor.riskScore >= 70
} else := {"disposition": "reject", "reasons": []} if {
	object.get(vendor, "priorEnforcement", "no") == "yes"
} else := {"disposition": "approve", "reasons": []} if {
	vendor.countryRisk == "LOW"
	vendor.riskScore < 40
	vendor.requestedSpend <= 500000
} else := {"disposition": "approve", "reasons": []} if {
	vendor.countryRisk == "LOW"
	vendor.riskScore < 40
	vendor.requestedSpend > 500000
	vendor.requestedSpend <= 2000000
	input.evidence["insurance-certificate"] == "present"
} else := {"disposition": "enhanced-review", "reasons": []} if {
	vendor.countryRisk == "LOW"
	vendor.riskScore < 40
	vendor.requestedSpend > 500000
	vendor.requestedSpend <= 2000000
	input.evidence["insurance-certificate"] == "absent"
} else := {"disposition": "unresolved", "reasons": ["unknown"]} if {
	vendor.countryRisk == "LOW"
	vendor.riskScore < 40
	vendor.requestedSpend > 500000
	vendor.requestedSpend <= 2000000
	not "insurance-certificate" in object.keys(input.evidence)
} else := {"disposition": "approve", "reasons": []} if {
	vendor.countryRisk == "LOW"
	vendor.riskScore >= 40
	vendor.riskScore < 70
	vendor.requestedSpend <= 100000
	object.get(vendor, "newVendor", "no") != "yes"
} else := {"disposition": "approve", "reasons": []} if {
	vendor.countryRisk == "MEDIUM"
	vendor.riskScore < 40
	vendor.requestedSpend <= 100000
} else := {"disposition": "review", "reasons": []}
```

TESTS:
```rego
package study_test

import data.study

present_evidence := {"financial-evidence": "present"}

test_missing_financial_evidence if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["missing-required-evidence"],
	} with input as {
		"vendor": {"sanctionsStatus": "MATCH"},
		"evidence": {"financial-evidence": "absent"},
	}
}

test_unreported_financial_evidence if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["unknown"],
	} with input as {
		"vendor": {"sanctionsStatus": "MATCH"},
		"evidence": {},
	}
}

test_sanctions_match_rejects if {
	study.decision == {"disposition": "reject", "reasons": []} with input as {
		"vendor": {"sanctionsStatus": "MATCH"},
		"evidence": present_evidence,
	}
}

test_unknown_sanctions_has_no_match if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["no-match"],
	} with input as {
		"vendor": {"sanctionsStatus": "UNKNOWN"},
		"evidence": present_evidence,
	}
}

test_critical_risk_rejects if {
	study.decision == {"disposition": "reject", "reasons": []} with input as {
		"vendor": {
			"sanctionsStatus": "CLEAR",
			"riskScore": 90,
			"requestedSpend": 100,
			"countryRisk": "LOW",
		},
		"evidence": present_evidence,
	}
}

test_high_country_rejects_at_seventy if {
	study.decision == {"disposition": "reject", "reasons": []} with input as {
		"vendor": {
			"sanctionsStatus": "CLEAR",
			"riskScore": 70,
			"requestedSpend": 2000000,
			"countryRisk": "HIGH",
		},
		"evidence": present_evidence,
	}
}

test_prior_enforcement_rejects if {
	study.decision == {"disposition": "reject", "reasons": []} with input as {
		"vendor": {
			"sanctionsStatus": "CLEAR",
			"riskScore": 5,
			"requestedSpend": 100,
			"countryRisk": "LOW",
			"priorEnforcement": "yes",
		},
		"evidence": present_evidence,
	}
}

test_low_risk_low_spend_approves if {
	study.decision == {"disposition": "approve", "reasons": []} with input as {
		"vendor": {
			"sanctionsStatus": "CLEAR",
			"riskScore": 39,
			"requestedSpend": 500000,
			"countryRisk": "LOW",
		},
		"evidence": present_evidence,
	}
}


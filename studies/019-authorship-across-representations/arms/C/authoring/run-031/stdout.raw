POLICY:
```rego
package study

default decision := {"disposition": "unresolved", "reasons": ["no-match"]}

decision := result if {
	result := evaluate
}

vendor := object.get(input, "vendor", {})
evidence := object.get(input, "evidence", {})

evaluate := {"disposition": "unresolved", "reasons": ["missing-required-evidence"]} if {
	evidence["financial-evidence"] == "absent"
} else := {"disposition": "unresolved", "reasons": ["unknown"]} if {
	not "financial-evidence" in evidence
} else := {"disposition": "reject", "reasons": []} if {
	evidence["financial-evidence"] == "present"
	vendor.sanctionsStatus == "MATCH"
} else := {"disposition": "unresolved", "reasons": ["no-match"]} if {
	evidence["financial-evidence"] == "present"
	vendor.sanctionsStatus == "UNKNOWN"
} else := result if {
	evidence["financial-evidence"] == "present"
	vendor.sanctionsStatus == "CLEAR"
	result := clear_result
}

clear_result := result if {
	risks := risk_values(vendor)
	spends := spend_values(vendor)
	countries := country_values(vendor)
	outcomes := {
		outcome |
		some risk in risks
		some spend in spends
		some country in countries
		outcome := readable_outcome(risk, spend, country)
	}
	count(outcomes) == 1
	some result in outcomes
} else := {"disposition": "unresolved", "reasons": ["unknown"]}

risk_values(v) := [v.riskScore] if {
	"riskScore" in v
} else := numbers.range(0, 100)

spend_values(v) := [v.requestedSpend] if {
	"requestedSpend" in v
} else := [
	0,
	100000,
	100000.01,
	500000,
	500000.01,
	2000000,
	2000000.01,
	10000000,
]

country_values(v) := [v.countryRisk] if {
	"countryRisk" in v
} else := ["LOW", "MEDIUM", "HIGH"]

readable_outcome(risk, spend, country) := {
	"disposition": "unresolved",
	"reasons": ["exception-escalation"],
} if {
	country == "HIGH"
	spend > 2000000
} else := {"disposition": "review", "reasons": []} if {
	object.get(vendor, "criticalSupplier", "no") == "yes"
} else := {"disposition": "reject", "reasons": []} if {
	risk >= 90
} else := {"disposition": "reject", "reasons": []} if {
	country == "HIGH"
	risk >= 70
} else := {"disposition": "reject", "reasons": []} if {
	object.get(vendor, "priorEnforcement", "no") == "yes"
} else := {"disposition": "approve", "reasons": []} if {
	country == "LOW"
	risk < 40
	spend <= 500000
} else := {"disposition": "approve", "reasons": []} if {
	country == "LOW"
	risk < 40
	spend > 500000
	spend <= 2000000
	evidence["insurance-certificate"] == "present"
} else := {"disposition": "enhanced-review", "reasons": []} if {
	country == "LOW"
	risk < 40
	spend > 500000
	spend <= 2000000
	evidence["insurance-certificate"] == "absent"
} else := {"disposition": "unresolved", "reasons": ["unknown"]} if {
	country == "LOW"
	risk < 40
	spend > 500000
	spend <= 2000000
	not "insurance-certificate" in evidence
} else := {"disposition": "approve", "reasons": []} if {
	country == "LOW"
	risk >= 40
	risk < 70
	spend <= 100000
	object.get(vendor, "newVendor", "no") != "yes"
} else := {"disposition": "approve", "reasons": []} if {
	country == "MEDIUM"
	risk < 40
	spend <= 100000
} else := {"disposition": "review", "reasons": []}
```

TESTS:
```rego
package study_test

import data.study

financial_present := {"financial-evidence": "present"}
financial_and_insurance_present := {
	"financial-evidence": "present",
	"insurance-certificate": "present",
}
financial_present_insurance_absent := {
	"financial-evidence": "present",
	"insurance-certificate": "absent",
}

test_missing_financial_evidence_precedes_sanctions_match if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["missing-required-evidence"],
	} with input as {
		"vendor": {"sanctionsStatus": "MATCH"},
		"evidence": {"financial-evidence": "absent"},
	}
}

test_unreported_financial_evidence_is_unknown if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["unknown"],
	} with input as {
		"vendor": {"sanctionsStatus": "MATCH"},
		"evidence": {},
	}
}

test_sanctions_match_rejects_even_critical_supplier if {
	study.decision == {"disposition": "reject", "reasons": []} with input as {
		"vendor": {
			"sanctionsStatus": "MATCH",
			"criticalSupplier": "yes",
		},
		"evidence": financial_present,
	}
}

test_unknown_sanctions_has_no_match if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["no-match"],
	} with input as {
		"vendor": {"sanctionsStatus": "UNKNOWN"},
		"evidence": financial_present,
	}
}

test_low_risk_low_spend_approves if {
	study.decision == {"disposition": "approve", "reasons": []} with input as {
		"vendor": {
			"sanctionsStatus": "CLEAR",
			"countryRisk": "LOW",
			"riskScore": 39,
			"requestedSpend": 500000,
		},
		"evidence": financial_present,
	}
}

test_d6b_with_insurance_approves_at_upper_boundary if {
	study.decision == {"disposition": "approve", "reasons": []} with input as {
		"vendor": {
			"sanctionsStatus": "CLEAR",
			"countryRisk": "LOW",
			"riskScore": 39,
			"requestedSpend": 2000000,
		},
		"evidence": financial_and_insurance_present,
	}
}

test_d6b_absent_insurance_gets_enhanced_review if {
	study.decision == {
		"disposition": "enhanced-review",
		"reasons": [],
	} with input as {
		"vendor": {
			"sanctionsStatus": "CLEAR",
			"countryRisk": "LOW",
			"riskScore": 10,
			"requestedSpend": 500000.01,
		},
		"evidence": financial_present_insurance_absent,
	}
}

test_d6b_unreported_insurance_is_unknown if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["unknown"],
	} with input as {
		"vendor": {
			"sanctionsStatus": "CLEAR",
			"countryRisk": "LOW",
			"riskScore": 10,
			"requestedSpend": 600000,
		},
		"evidence": financial_present,
	}
}

test_new_vendor_suspends_d6c if {
	study.decision == {"disposition": "review", "reasons": []} with input as {
		"vendor": {
			"sanctionsStatus": "CLEAR",
			"countryRisk": "LOW",
			"riskScore": 40,
			"requestedSpend": 100000,
			"newVendor": "yes",
		},
		"evidence": financial_present,
	}
}

test_unreported_new_vendor_is_treated_as_no if {
	study.decision == {"disposition": "approve", "reasons": []} with input as {
		"vendor": {
			"sanctionsStatus": "CLEAR",
			"countryRisk": "LOW",
			"riskScore": 69,
			"requestedSpend": 100000,
		},
		"evidence": financial_present,
	}
}

test_medium_country_approval_boundary if {
	study.decision == {"disposition": "approve", "reasons": []} with input as {
		"vendor": {
			"sanctionsStatus": "CLEAR",
			"countryRisk": "MEDIUM",
			"riskScore": 39,
			"requestedSpend": 100000,
		},
		"evidence": financial_present,
	}
}

test_high_country_rejects_at_risk_70 if {
	study.decision == {"disposition": "reject", "reasons": []} with input as {
		"vendor": {
			"sanctionsStatus": "CLEAR",
			"countryRisk": "HIGH",
			"riskScore": 70,
			"requestedSpend": 2000000,
		},
		"evidence": financial_present,
	}
}

test_prior_enforcement_rejects if {
	study.decision == {"disposition": "reject", "reasons": []} with input as {
		"vendor": {
			"sanctionsStatus": "CLEAR",
			"countryRisk": "LOW",
			"riskScore": 1,
			"requestedSpend": 1,
			"priorEnforcement": "yes",
		},
		"evidence": financial_present,
	}
}

test_critical_supplier_overrides_rejection if {
	study.decision == {"disposition": "review", "reasons": []} with input as {
		"vendor": {
			"sanctionsStatus": "CLEAR",
			"countryRisk": "LOW",
			"riskScore": 95,
			"requestedSpend": 100,
			"criticalSupplier": "yes",
		},
		"evidence": financial_present,
	}
}

test_o3_escalation_precedes_critical_supplier_override if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["exception-escalation"],
	} with input as {
		"vendor": {
			"sanctionsStatus": "CLEAR",
			"countryRisk": "HIGH",
			"riskScore": 95,
			"requestedSpend": 2000000.01,
			"criticalSupplier": "yes",
		},
		"evidence": financial_present,
	}
}

test_unreadable_country_still_rejects_at_risk_95 if {
	study.decision == {"disposition": "reject", "reasons": []} with input as {
		"vendor": {
			"sanctionsStatus": "CLEAR",
			"riskScore": 95,
			"requestedSpend": 1000000,
		},
		"evidence": financial_present,
	}
}

test_unreadable_spend_in_high_country_can_change_to_escalation if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["unknown"],
	} with input as {
		"vendor": {
			"sanctionsStatus": "CLEAR",
			"countryRisk": "HIGH",
			"riskScore": 50,
		},
		"evidence": financial_present,
	}
}

test_critical_supplier_with_unreadable_risk_still_reviews if {
	study.decision == {"disposition": "review", "reasons": []} with input as {
		"vendor": {
			"sanctionsStatus": "CLEAR",
			"countryRisk": "LOW",
			"requestedSpend": 100,
			"criticalSupplier": "yes",
		},
		"evidence": financial_present,
	}
}

test_critical_supplier_with_unreadable_country_and_spend_is_unknown if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["unknown"],
	} with input as {
		"vendor": {
			"sanctionsStatus": "CLEAR",
			"riskScore": 10,
			"criticalSupplier": "yes",
		},
		"evidence": financial_present,
	}
}

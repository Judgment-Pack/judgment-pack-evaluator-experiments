POLICY:
```rego
package study

default decision := {"disposition": "unresolved", "reasons": ["no-match"]}

financial_evidence := object.get(object.get(input, "evidence", {}), "financial-evidence", "unreported")

insurance_certificate := object.get(object.get(input, "evidence", {}), "insurance-certificate", "unreported")

critical_supplier := object.get(input.vendor, "criticalSupplier", "no")

new_vendor := object.get(input.vendor, "newVendor", "no")

prior_enforcement := object.get(input.vendor, "priorEnforcement", "no")

risk_domain := [input.vendor.riskScore] if {
	"riskScore" in input.vendor
}

risk_domain := [0, 39, 40, 69, 70, 89, 90, 100] if {
	not "riskScore" in input.vendor
}

spend_domain := [input.vendor.requestedSpend] if {
	"requestedSpend" in input.vendor
}

spend_domain := [0, 100000, 500000, 500000.01, 2000000, 2000000.01, 10000000] if {
	not "requestedSpend" in input.vendor
}

country_domain := [input.vendor.countryRisk] if {
	"countryRisk" in input.vendor
}

country_domain := ["LOW", "MEDIUM", "HIGH"] if {
	not "countryRisk" in input.vendor
}

possible_outcomes := {
	result |
	some risk in risk_domain
	some spend in spend_domain
	some country in country_domain
	result := outcome(risk, spend, country)
}

decision := {"disposition": "unresolved", "reasons": ["missing-required-evidence"]} if {
	financial_evidence == "absent"
} else := {"disposition": "unresolved", "reasons": ["unknown"]} if {
	financial_evidence == "unreported"
} else := result if {
	financial_evidence == "present"
	count(possible_outcomes) == 1
	some result in possible_outcomes
}

outcome(risk, spend, country) := {"disposition": "reject", "reasons": []} if {
	input.vendor.sanctionsStatus == "MATCH"
} else := {"disposition": "unresolved", "reasons": ["no-match"]} if {
	input.vendor.sanctionsStatus == "UNKNOWN"
} else := {"disposition": "unresolved", "reasons": ["exception-escalation"]} if {
	input.vendor.sanctionsStatus == "CLEAR"
	country == "HIGH"
	spend > 2000000
} else := {"disposition": "review", "reasons": []} if {
	input.vendor.sanctionsStatus == "CLEAR"
	critical_supplier == "yes"
} else := {"disposition": "reject", "reasons": []} if {
	input.vendor.sanctionsStatus == "CLEAR"
	risk >= 90
} else := {"disposition": "reject", "reasons": []} if {
	input.vendor.sanctionsStatus == "CLEAR"
	country == "HIGH"
	risk >= 70
} else := {"disposition": "reject", "reasons": []} if {
	input.vendor.sanctionsStatus == "CLEAR"
	prior_enforcement == "yes"
} else := {"disposition": "approve", "reasons": []} if {
	input.vendor.sanctionsStatus == "CLEAR"
	prior_enforcement != "yes"
	country == "LOW"
	risk < 40
	spend <= 500000
} else := {"disposition": "approve", "reasons": []} if {
	input.vendor.sanctionsStatus == "CLEAR"
	prior_enforcement != "yes"
	country == "LOW"
	risk < 40
	spend > 500000
	spend <= 2000000
	insurance_certificate == "present"
} else := {"disposition": "enhanced-review", "reasons": []} if {
	input.vendor.sanctionsStatus == "CLEAR"
	prior_enforcement != "yes"
	country == "LOW"
	risk < 40
	spend > 500000
	spend <= 2000000
	insurance_certificate == "absent"
} else := {"disposition": "unresolved", "reasons": ["unknown"]} if {
	input.vendor.sanctionsStatus == "CLEAR"
	prior_enforcement != "yes"
	country == "LOW"
	risk < 40
	spend > 500000
	spend <= 2000000
	insurance_certificate == "unreported"
} else := {"disposition": "approve", "reasons": []} if {
	input.vendor.sanctionsStatus == "CLEAR"
	prior_enforcement != "yes"
	country == "LOW"
	risk >= 40
	risk < 70
	spend <= 100000
	new_vendor != "yes"
} else := {"disposition": "approve", "reasons": []} if {
	input.vendor.sanctionsStatus == "CLEAR"
	prior_enforcement != "yes"
	country == "MEDIUM"
	risk < 40
	spend <= 100000
} else := {"disposition": "review", "reasons": []} if {
	input.vendor.sanctionsStatus == "CLEAR"
}
```

TESTS:
```rego
package study_test

import data.study

present_financial := {"financial-evidence": "present"}

test_p1_absent_precedes_match if {
	study.decision == {"disposition": "unresolved", "reasons": ["missing-required-evidence"]} with input as {
		"vendor": {"sanctionsStatus": "MATCH"},
		"evidence": {"financial-evidence": "absent"},
	}
}

test_p1_unreported_is_unknown if {
	study.decision == {"disposition": "unresolved", "reasons": ["unknown"]} with input as {
		"vendor": {"sanctionsStatus": "MATCH"},
		"evidence": {},
	}
}

test_sanctions_match_rejects if {
	study.decision == {"disposition": "reject", "reasons": []} with input as {
		"vendor": {"sanctionsStatus": "MATCH"},
		"evidence": present_financial,
	}
}

test_unknown_sanctions_has_no_match if {
	study.decision == {"disposition": "unresolved", "reasons": ["no-match"]} with input as {
		"vendor": {"sanctionsStatus": "UNKNOWN"},
		"evidence": present_financial,
	}
}

test_o3_precedes_critical_and_rejection if {
	study.decision == {"disposition": "unresolved", "reasons": ["exception-escalation"]} with input as {
		"vendor": {
			"sanctionsStatus": "CLEAR",
			"countryRisk": "HIGH",
			"requestedSpend": 2000000.01,
			"riskScore": 95,
			"criticalSupplier": "yes",
			"priorEnforcement": "yes",
		},
		"evidence": present_financial,
	}
}

test_critical_supplier_review if {
	study.decision == {"disposition": "review", "reasons": []} with input as {
		"vendor": {
			"sanctionsStatus": "CLEAR",
			"countryRisk": "LOW",
			"requestedSpend": 100,
			"riskScore": 95,
			"criticalSupplier": "yes",
		},
		"evidence": present_financial,
	}
}

test_critical_supplier_does_not_override_match if {
	study.decision.disposition == "reject" with input as {
		"vendor": {"sanctionsStatus": "MATCH", "criticalSupplier": "yes"},
		"evidence": present_financial,
	}
}

test_high_country_rejects_at_70 if {
	study.decision.disposition == "reject" with input as {
		"vendor": {
			"sanctionsStatus": "CLEAR",
			"countryRisk": "HIGH",
			"requestedSpend": 100,
			"riskScore": 70,
		},
		"evidence": present_financial,
	}
}

test_prior_enforcement_rejects if {
	study.decision.disposition == "reject" with input as {
		"vendor": {
			"sanctionsStatus": "CLEAR",
			"countryRisk": "LOW",
			"requestedSpend": 100,
			"riskScore": 1,
			"priorEnforcement": "yes",
		},
		"evidence": present_financial,
	}
}

test_low_country_basic_approval_boundary if {
	study.decision.disposition == "approve" with input as {
		"vendor": {
			"sanctionsStatus": "CLEAR",
			"countryRisk": "LOW",
			"requestedSpend": 500000,
			"riskScore": 39,
		},
		"evidence": present_financial,
	}
}

test_d6b_present_insurance_approves if {
	study.decision.disposition == "approve" with input as {
		"vendor": {
			"sanctionsStatus": "CLEAR",
			"countryRisk": "LOW",
			"requestedSpend": 2000000,
			"riskScore": 39,
		},
		"evidence": {
			"financial-evidence": "present",
			"insurance-certificate": "present",
		},
	}
}

test_d6b_absent_insurance_enhanced_review if {
	study.decision.disposition == "enhanced-review" with input as {
		"vendor": {
			"sanctionsStatus": "CLEAR",
			"countryRisk": "LOW",
			"requestedSpend": 500000.01,
			"riskScore": 0,
		},
		"evidence": {
			"financial-evidence": "present",
			"insurance-certificate": "absent",
		},
	}
}

test_d6b_unreported_insurance_unknown if {
	study.decision == {"disposition": "unresolved", "reasons": ["unknown"]} with input as {
		"vendor": {
			"sanctionsStatus": "CLEAR",
			"countryRisk": "LOW",
			"requestedSpend": 500000.01,
			"riskScore": 0,
		},
		"evidence": present_financial,
	}
}

test_o1_suspends_d6c if {
	study.decision.disposition == "review" with input as {
		"vendor": {
			"sanctionsStatus": "CLEAR",
			"countryRisk": "LOW",
			"requestedSpend": 100000,
			"riskScore": 40,
			"newVendor": "yes",
		},
		"evidence": present_financial,
	}
}

test_medium_country_approval_boundary if {
	study.decision.disposition == "approve" with input as {
		"vendor": {
			"sanctionsStatus": "CLEAR",
			"countryRisk": "MEDIUM",
			"requestedSpend": 100000,
			"riskScore": 39,
		},
		"evidence": present_financial,

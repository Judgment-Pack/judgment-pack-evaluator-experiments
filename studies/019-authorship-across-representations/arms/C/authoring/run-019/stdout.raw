}

test_u1_unreadable_spend_high_country_is_unknown if {
	study.decision == {"disposition": "unresolved", "reasons": ["unknown"]} with input as {
		"vendor": {
			"sanctionsStatus": "CLEAR",
			"countryRisk": "HIGH",
			"riskScore": 50,
		},
		"evidence": present_financial,
	}
}

test_u1_critical_supplier_ignores_unreadable_risk if {
	study.decision.disposition == "review" with input as {
		"vendor": {
			"sanctionsStatus": "CLEAR",
			"countryRisk": "LOW",
			"requestedSpend": 100,
			"criticalSupplier": "yes",
		},
		"evidence": present_financial,
	}
}

test_u1_critical_with_unreadable_country_and_spend_is_unknown if {
	study.decision == {"disposition": "unresolved", "reasons": ["unknown"]} with input as {
		"vendor": {
			"sanctionsStatus": "CLEAR",
			"riskScore": 10,
			"criticalSupplier": "yes",
		},
		"evidence": present_financial,

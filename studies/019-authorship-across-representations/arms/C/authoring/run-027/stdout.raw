POLICY:
```rego
package study

default decision := {"disposition": "unresolved", "reasons": ["no-match"]}

decision := {"disposition": "unresolved", "reasons": ["missing-required-evidence"]} if {
	evidence := object.get(input, "evidence", {})
	object.get(evidence, "financial-evidence", "unreported") == "absent"
} else := {"disposition": "unresolved", "reasons": ["unknown"]} if {
	evidence := object.get(input, "evidence", {})
	object.get(evidence, "financial-evidence", "unreported") == "unreported"
} else := result if {
	results := {
		outcome(candidate) |
		some risk in risk_values
		some spend in spend_values
		some country in country_values
		base_vendor := object.get(input, "vendor", {})
		candidate := object.union(base_vendor, {
			"riskScore": risk,
			"requestedSpend": spend,
			"countryRisk": country,
		})
	}
	count(results) == 1
	some result in results
} else := {"disposition": "unresolved", "reasons": ["unknown"]} if {
	evidence := object.get(input, "evidence", {})
	object.get(evidence, "financial-evidence", "unreported") == "present"
}

risk_values := [risk] if {
	vendor := object.get(input, "vendor", {})
	risk := object.get(vendor, "riskScore", -1)
	risk != -1
} else := [0, 39, 40, 69, 70, 89, 90, 100]

spend_values := [spend] if {
	vendor := object.get(input, "vendor", {})
	spend := object.get(vendor, "requestedSpend", -1)
	spend != -1
} else := [0, 100000, 100000.01, 500000, 500000.01, 2000000, 2000000.01, 10000000]

country_values := [country] if {
	vendor := object.get(input, "vendor", {})
	country := object.get(vendor, "countryRisk", "unreported")
	country != "unreported"
} else := ["LOW", "MEDIUM", "HIGH"]

outcome(vendor) := {"disposition": "unresolved", "reasons": ["no-match"]} if {
	vendor.sanctionsStatus == "UNKNOWN"
} else := {"disposition": "reject", "reasons": []} if {
	vendor.sanctionsStatus == "MATCH"
} else := {"disposition": "unresolved", "reasons": ["exception-escalation"]} if {
	vendor.sanctionsStatus == "CLEAR"
	vendor.countryRisk == "HIGH"
	vendor.requestedSpend > 2000000
} else := {"disposition": "review", "reasons": []} if {
	vendor.sanctionsStatus == "CLEAR"
	object.get(vendor, "criticalSupplier", "no") == "yes"
} else := {"disposition": "reject", "reasons": []} if {
	vendor.sanctionsStatus == "CLEAR"
	vendor.riskScore >= 90
} else := {"disposition": "reject", "reasons": []} if {
	vendor.sanctionsStatus == "CLEAR"
	vendor.countryRisk == "HIGH"
	vendor.riskScore >= 70
} else := {"disposition": "reject", "reasons": []} if {
	vendor.sanctionsStatus == "CLEAR"
	object.get(vendor, "priorEnforcement", "no") == "yes"
} else := {"disposition": "approve", "reasons": []} if {
	vendor.sanctionsStatus == "CLEAR"
	vendor.countryRisk == "LOW"
	vendor.riskScore < 40
	vendor.requestedSpend <= 500000
} else := {"disposition": "approve", "reasons": []} if {
	vendor.sanctionsStatus == "CLEAR"
	vendor.countryRisk == "LOW"
	vendor.riskScore < 40
	vendor.requestedSpend > 500000
	vendor.requestedSpend <= 2000000
	evidence := object.get(input, "evidence", {})
	object.get(evidence, "insurance-certificate", "unreported") == "present"
} else := {"disposition": "enhanced-review", "reasons": []} if {
	vendor.sanctionsStatus == "CLEAR"
	vendor.countryRisk == "LOW"
	vendor.riskScore < 40
	vendor.requestedSpend > 500000
	vendor.requestedSpend <= 2000000
	evidence := object.get(input, "evidence", {})
	object.get(evidence, "insurance-certificate", "unreported") == "absent"
} else := {"disposition": "unresolved", "reasons": ["unknown"]} if {
	vendor.sanctionsStatus == "CLEAR"
	vendor.countryRisk == "LOW"
	vendor.riskScore < 40
	vendor.requestedSpend > 500000
	vendor.requestedSpend <= 2000000
	evidence := object.get(input, "evidence", {})
	object.get(evidence, "insurance-certificate", "unreported") == "unreported"
} else := {"disposition": "approve", "reasons": []} if {
	vendor.sanctionsStatus == "CLEAR"
	vendor.countryRisk == "LOW"
	vendor.riskScore >= 40
	vendor.riskScore < 70
	vendor.requestedSpend <= 100000
	object.get(vendor, "newVendor", "no") != "yes"
} else := {"disposition": "approve", "reasons": []} if {
	vendor.sanctionsStatus == "CLEAR"
	vendor.countryRisk == "MEDIUM"
	vendor.riskScore < 40
	vendor.requestedSpend <= 100000
} else := {"disposition": "review", "reasons": []} if {
	vendor.sanctionsStatus == "CLEAR"
}
```

TESTS:
```rego
package study_test

import data.study

financial_present := {"financial-evidence": "present"}

test_missing_financial_evidence_precedes_sanctions_rejection if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["missing-required-evidence"],
	} with input as {
		"vendor": {
			"riskScore": 95,
			"requestedSpend": 100,
			"sanctionsStatus": "MATCH",
			"countryRisk": "LOW",
		},
		"evidence": {"financial-evidence": "absent"},
	}
}

test_unreported_financial_evidence_is_unknown if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["unknown"],
	} with input as {
		"vendor": {
			"riskScore": 10,
			"requestedSpend": 100,
			"sanctionsStatus": "CLEAR",
			"countryRisk": "LOW",
		},
		"evidence": {},
	}
}

test_sanctions_match_rejects if {
	study.decision.disposition == "reject" with input as {
		"vendor": {
			"riskScore": 10,
			"requestedSpend": 100,
			"sanctionsStatus": "MATCH",
			"countryRisk": "LOW",
			"criticalSupplier": "yes",
		},
		"evidence": financial_present,
	}
}

test_unknown_sanctions_has_no_match if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["no-match"],
	} with input as {
		"vendor": {
			"riskScore": 10,
			"requestedSpend": 100,
			"sanctionsStatus": "UNKNOWN",
			"countryRisk": "LOW",
		},
		"evidence": financial_present,
	}
}

test_large_high_country_exposure_escalates_before_critical_override if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["exception-escalation"],
	} with input as {
		"vendor": {
			"riskScore": 95,
			"requestedSpend": 2000000.01,
			"sanctionsStatus": "CLEAR",
			"countryRisk": "HIGH",
			"criticalSupplier": "yes",
			"priorEnforcement": "yes",
		},
		"evidence": financial_present,
	}
}

test_critical_supplier_reviews_if_o3_does_not_apply if {

}

test_critical_with_unreadable_country_and_spend_is_unknown if {
	study.decision == {"disposition": "unresolved", "reasons": ["unknown"]} with input as {
		"vendor": {
			"sanctionsStatus": "CLEAR",
			"riskScore": 20,
			"criticalSupplier": "yes",
		},
		"evidence": financial_present,
	}
}

test_clear_fallback_review if {
	study.decision == {"disposition": "review", "reasons": []} with input as {
		"vendor": {
			"sanctionsStatus": "CLEAR",
			"countryRisk": "MEDIUM",
			"requestedSpend": 100000.01,
			"riskScore": 20,
		},
		"evidence": financial_present,
	}
}

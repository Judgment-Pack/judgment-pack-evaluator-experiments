POLICY:
```rego
package study

default decision := {"disposition": "unresolved", "reasons": ["no-match"]}

decision := {"disposition": "unresolved", "reasons": ["missing-required-evidence"]} if {
	evidence_state("financial-evidence") == "absent"
} else := {"disposition": "unresolved", "reasons": ["unknown"]} if {
	evidence_state("financial-evidence") == "unreported"
} else := {"disposition": "reject", "reasons": []} if {
	input.vendor.sanctionsStatus == "MATCH"
} else := {"disposition": "unresolved", "reasons": ["no-match"]} if {
	input.vendor.sanctionsStatus == "UNKNOWN"
} else := result if {
	input.vendor.sanctionsStatus == "CLEAR"
	result := clear_decision
}

evidence_state(requirement) := object.get(input.evidence, requirement, "unreported")

candidate_risks(vendor) := [vendor.riskScore] if {
	object.get(vendor, "riskScore", -1) >= 0
} else := [0, 39, 40, 69, 70, 89, 90, 100]

candidate_spends(vendor) := [vendor.requestedSpend] if {
	object.get(vendor, "requestedSpend", -1) >= 0
} else := [0, 100000, 100000.01, 500000, 500000.01, 2000000, 2000000.01, 10000000]

candidate_countries(vendor) := [vendor.countryRisk] if {
	object.get(vendor, "countryRisk", "") != ""
} else := ["LOW", "MEDIUM", "HIGH"]

possible_clear_outcomes contains outcome if {
	some risk in candidate_risks(input.vendor)
	some spend in candidate_spends(input.vendor)
	some country in candidate_countries(input.vendor)
	outcome := clear_outcome(risk, spend, country)
}

clear_decision := outcome if {
	count(possible_clear_outcomes) == 1
	some outcome in possible_clear_outcomes
} else := {"disposition": "unresolved", "reasons": ["unknown"]}

clear_outcome(risk, spend, country) := {"disposition": "unresolved", "reasons": ["exception-escalation"]} if {
	country == "HIGH"
	spend > 2000000
} else := {"disposition": "review", "reasons": []} if {
	object.get(input.vendor, "criticalSupplier", "no") == "yes"
} else := {"disposition": "reject", "reasons": []} if {
	risk >= 90
} else := {"disposition": "reject", "reasons": []} if {
	country == "HIGH"
	risk >= 70
} else := {"disposition": "reject", "reasons": []} if {
	object.get(input.vendor, "priorEnforcement", "no") == "yes"
} else := {"disposition": "approve", "reasons": []} if {
	country == "LOW"
	risk < 40
	spend <= 500000
} else := d6b_outcome if {
	country == "LOW"
	risk < 40
	spend > 500000
	spend <= 2000000
	d6b_outcome := insurance_outcome
} else := {"disposition": "approve", "reasons": []} if {
	country == "LOW"
	risk >= 40
	risk < 70
	spend <= 100000
	object.get(input.vendor, "newVendor", "no") != "yes"
} else := {"disposition": "approve", "reasons": []} if {
	country == "MEDIUM"
	risk < 40
	spend <= 100000
} else := {"disposition": "review", "reasons": []}

insurance_outcome := {"disposition": "approve", "reasons": []} if {
	evidence_state("insurance-certificate") == "present"
} else := {"disposition": "enhanced-review", "reasons": []} if {
	evidence_state("insurance-certificate") == "absent"
} else := {"disposition": "unresolved", "reasons": ["unknown"]}
```


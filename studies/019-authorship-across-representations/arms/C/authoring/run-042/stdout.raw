POLICY:
```rego
package study

default decision := {"disposition": "unresolved", "reasons": ["no-match"]}

decision := {"disposition": "unresolved", "reasons": ["missing-required-evidence"]} if {
	object.get(input.evidence, "financial-evidence", "unreported") == "absent"
} else := {"disposition": "unresolved", "reasons": ["unknown"]} if {
	object.get(input.evidence, "financial-evidence", "unreported") == "unreported"
} else := {"disposition": "reject", "reasons": []} if {
	input.evidence["financial-evidence"] == "present"
	input.vendor.sanctionsStatus == "MATCH"
} else := {"disposition": "unresolved", "reasons": ["no-match"]} if {
	input.evidence["financial-evidence"] == "present"
	input.vendor.sanctionsStatus == "UNKNOWN"
} else := result if {
	input.evidence["financial-evidence"] == "present"
	input.vendor.sanctionsStatus == "CLEAR"
	outcomes := possible_outcomes
	count(outcomes) == 1
	some result in outcomes
} else := {"disposition": "unresolved", "reasons": ["unknown"]} if {
	input.evidence["financial-evidence"] == "present"
	input.vendor.sanctionsStatus == "CLEAR"
	count(possible_outcomes) > 1
}

risk_values := [input.vendor.riskScore] if {
	"riskScore" in input.vendor
} else := numbers.range(0, 100)

spend_values := [input.vendor.requestedSpend] if {
	"requestedSpend" in input.vendor
} else := [0, 100000, 500000, 500000.01, 2000000, 2000000.01]

country_values := [input.vendor.countryRisk] if {
	"countryRisk" in input.vendor
} else := ["LOW", "MEDIUM", "HIGH"]

possible_outcomes := {result |
	some risk in risk_values
	some spend in spend_values
	some country in country_values
	result := readable_outcome(risk, spend, country)
}

readable_outcome(risk, spend, country) := {
	"disposition": "unresolved",
	"reasons": ["exception-escalation"],
} if {
	country == "HIGH"
	spend > 2000000
} else := {
	"disposition": "review",
	"reasons": [],
} if {
	object.get(input.vendor, "criticalSupplier", "no") == "yes"
} else := {
	"disposition": "reject",
	"reasons": [],
} if {
	risk >= 90
} else := {
	"disposition": "reject",
	"reasons": [],
} if {
	country == "HIGH"
	risk >= 70
} else := {
	"disposition": "reject",
	"reasons": [],
} if {
	object.get(input.vendor, "priorEnforcement", "no") == "yes"
} else := {
	"disposition": "approve",
	"reasons": [],
} if {
	country == "LOW"
	risk < 40
	spend <= 500000
} else := {
	"disposition": "approve",
	"reasons": [],
} if {
	country == "LOW"
	risk < 40
	spend > 500000
	spend <= 2000000
	input.evidence["insurance-certificate"] == "present"
} else := {
	"disposition": "enhanced-review",
	"reasons": [],
} if {
	country == "LOW"
	risk < 40
	spend > 500000
	spend <= 2000000
	input.evidence["insurance-certificate"] == "absent"
} else := {
	"disposition": "unresolved",
	"reasons": ["unknown"],
} if {
	country == "LOW"
	risk < 40
	spend > 500000
	spend <= 2000000
	not "insurance-certificate" in input.evidence
} else := {
	"disposition": "approve",
	"reasons": [],
} if {
	country == "LOW"
	risk >= 40
	risk < 70
	spend <= 100000
	object.get(input.vendor, "newVendor", "no") != "yes"
} else := {
	"disposition": "approve",
	"reasons": [],
} if {
	country == "MEDIUM"
	risk < 40
	spend <= 100000
} else := {
	"disposition": "review",
	"reasons": [],
} if {
	true
}
```

TESTS:
```rego
package study_test

import data.study

financial_present := {"financial-evidence": "present"}

test_missing_financial_evidence_preempts_rejection if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["missing-required-evidence"],
	} with input as {
		"vendor": {
			"riskScore": 99,
			"requestedSpend": 100,
			"sanctionsStatus": "MATCH",
			"countryRisk": "HIGH",
		},
		"evidence": {"financial-evidence": "absent"},
	}
}

test_unreported_financial_evidence_is_unknown if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["unknown"],
	} with input as {
		"vendor": {"sanctionsStatus": "MATCH"},
		"evidence": {},
	}
}

test_sanctions_match_rejects if {
	study.decision.disposition == "reject" with input as {
		"vendor": {"sanctionsStatus": "MATCH"},
		"evidence": financial_present,
	}
}

test_unknown_sanctions_has_no_match if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["no-match"],
	} with input as {
		"vendor": {"sanctionsStatus": "UNKNOWN"},
		"evidence": financial_present,
	}
}

test_low_risk_small_spend_approves if {
	study.decision.disposition == "approve" with input as {
		"vendor": {
			"riskScore": 39,
			"requestedSpend": 500000,
			"sanctionsStatus": "CLEAR",
			"countryRisk": "LOW",
			"priorEnforcement": "no",
		},
		"evidence": financial_present,
	}
}

test_low_risk_mid_spend_with_insurance_approves if {
	study.decision.disposition == "approve" with input as {
		"vendor": {
			"riskScore": 20,
			"requestedSpend": 2000000,
			"sanctionsStatus": "CLEAR",
			"countryRisk": "LOW",
		},
		"evidence": {
			"financial-evidence": "present",
			"insurance-certificate": "present",
		},
	}
}

test_low_risk_mid_spend_without_insurance_gets_enhanced_review if {
	study.decision.disposition == "enhanced-review" with input as {
		"vendor": {
			"riskScore": 20,
			"requestedSpend": 500000.01,
			"sanctionsStatus": "CLEAR",
			"countryRisk": "LOW",
		},
		"evidence": {
			"financial-evidence": "present",
			"insurance-certificate": "absent",
		},
	}
}

test_unreported_insurance_is_unknown_in_d6b if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["unknown"],
	} with input as {
		"vendor": {
			"riskScore": 20,
			"requestedSpend": 1000000,
			"sanctionsStatus": "CLEAR",
			"countryRisk": "LOW",
		},
		"evidence": financial_present,
	}
}

test_new_vendor_suspends_d6c if {
	study.decision.disposition == "review" with input as {
		"vendor": {
			"riskScore": 40,
			"requestedSpend": 100000,
			"sanctionsStatus": "CLEAR",
			"countryRisk": "LOW",
			"newVendor": "yes",
		},
		"evidence": financial_present,
	}
}

test_unreported_new_vendor_is_treated_as_no if {
	study.decision.disposition == "approve" with input as {
		"vendor": {
			"riskScore": 69,
			"requestedSpend": 100000,
			"sanctionsStatus": "CLEAR",
			"countryRisk": "LOW",
		},
		"evidence": financial_present,
	}
}

test_medium_country_approval_boundary if {
	study.decision.disposition == "approve" with input as {
		"vendor": {
			"riskScore": 39,
			"requestedSpend": 100000,
			"sanctionsStatus": "CLEAR",
			"countryRisk": "MEDIUM",
		},
		"evidence": financial_present,
	}
}

test_high_country_rejects_at_risk_70 if {
	study.decision.disposition == "reject" with input as {
		"vendor": {
			"riskScore": 70,
			"requestedSpend": 100,
			"sanctionsStatus": "CLEAR",
			"countryRisk": "HIGH",
		},
		"evidence": financial_present,
	}
}

test_prior_enforcement_rejects if {
	study.decision.disposition == "reject" with input as {
		"vendor": {
			"riskScore": 1,
			"requestedSpend": 1,
			"sanctionsStatus": "CLEAR",
			"countryRisk": "LOW",
			"priorEnforcement": "yes",
		},
		"evidence": financial_present,
	}
}

test_critical_supplier_overrides_automatic_rejection if {
	study.decision.disposition == "review" with input as {
		"vendor": {
			"riskScore": 99,
			"requestedSpend": 100,
			"sanctionsStatus": "CLEAR",
			"countryRisk": "LOW",
			"criticalSupplier": "yes",
			"priorEnforcement": "yes",
		},
		"evidence": financial_present,
	}
}

test_o3_overrides_critical_supplier if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["exception-escalation"],
	} with input as {
		"vendor": {
			"riskScore": 99,
			"requestedSpend": 2000000.01,
			"sanctionsStatus": "CLEAR",
			"countryRisk": "HIGH",
			"criticalSupplier": "yes",
		},
		"evidence": financial_present,
	}
}

test_unreadable_country_still_rejects_at_risk_95 if {
	study.decision.disposition == "reject" with input as {
		"vendor": {
			"riskScore": 95,
			"requestedSpend": 1000000,
			"sanctionsStatus": "CLEAR",
		},
		"evidence": financial_present,
	}
}

test_unreadable_spend_in_high_country_can_change_to_escalation if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["unknown"],
	} with input as {
		"vendor": {
			"riskScore": 50,
			"sanctionsStatus": "CLEAR",
			"countryRisk": "HIGH",
		},
		"evidence": financial_present,
	}
}

test_critical_supplier_with_unreadable_risk_still_reviews if {
	study.decision.disposition == "review" with input as {
		"vendor": {
			"requestedSpend": 100,
			"sanctionsStatus": "CLEAR",
			"countryRisk": "LOW",
			"criticalSupplier": "yes",
		},
		"evidence": financial_present,
	}
}

test_critical_supplier_with_unreadable_country_and_spend_is_unknown if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["unknown"],
	} with input as {
		"vendor": {
			"riskScore": 10,
			"sanctionsStatus": "CLEAR",
			"criticalSupplier": "yes",
		},
		"evidence": financial_present,
	}
}
```

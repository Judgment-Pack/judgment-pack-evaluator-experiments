POLICY:
```rego
package study

default decision := {"disposition": "unresolved", "reasons": ["no-match"]}

decision := {"disposition": "unresolved", "reasons": ["missing-required-evidence"]} if {
	evidence := object.get(input, "evidence", {})
	object.get(evidence, "financial-evidence", "unreported") == "absent"
} else := {"disposition": "unresolved", "reasons": ["unknown"]} if {
	evidence := object.get(input, "evidence", {})
	object.get(evidence, "financial-evidence", "unreported") == "unreported"
} else := {"disposition": "reject", "reasons": []} if {
	vendor := object.get(input, "vendor", {})
	vendor.sanctionsStatus == "MATCH"
} else := {"disposition": "unresolved", "reasons": ["no-match"]} if {
	vendor := object.get(input, "vendor", {})
	vendor.sanctionsStatus == "UNKNOWN"
} else := result if {
	vendor := object.get(input, "vendor", {})
	vendor.sanctionsStatus == "CLEAR"
	result := unreadable_result(vendor)
}

unreadable_result(vendor) := result if {
	outcomes := possible_outcomes(vendor)
	count(outcomes) == 1
	some result in outcomes
} else := {"disposition": "unresolved", "reasons": ["unknown"]}

possible_outcomes(vendor) := {
	result |
		some risk_score in risk_candidates(vendor)
		some requested_spend in spend_candidates(vendor)
		some country_risk in country_candidates(vendor)
		readable_vendor := object.union(vendor, {
			"riskScore": risk_score,
			"requestedSpend": requested_spend,
			"countryRisk": country_risk,
		})
		result := readable_outcome(readable_vendor)
}

risk_candidates(vendor) := [risk_score] if {
	risk_score := object.get(vendor, "riskScore", -1)
	risk_score != -1
} else := [0, 39, 40, 69, 70, 89, 90, 100]

spend_candidates(vendor) := [requested_spend] if {
	requested_spend := object.get(vendor, "requestedSpend", -1)
	requested_spend != -1
} else := [0, 100000, 100000.01, 500000, 500000.01, 2000000, 2000000.01, 10000000]

country_candidates(vendor) := [country_risk] if {
	country_risk := object.get(vendor, "countryRisk", "unreadable")
	country_risk != "unreadable"
} else := ["LOW", "MEDIUM", "HIGH"]

readable_outcome(vendor) := {"disposition": "unresolved", "reasons": ["exception-escalation"]} if {
	vendor.countryRisk == "HIGH"
	vendor.requestedSpend > 2000000
} else := {"disposition": "review", "reasons": []} if {
	object.get(vendor, "criticalSupplier", "no") == "yes"
} else := {"disposition": "reject", "reasons": []} if {
	vendor.riskScore >= 90
} else := {"disposition": "reject", "reasons": []} if {
	vendor.countryRisk == "HIGH"
	vendor.riskScore >= 70
} else := {"disposition": "reject", "reasons": []} if {
	object.get(vendor, "priorEnforcement", "no") == "yes"
} else := {"disposition": "approve", "reasons": []} if {
	vendor.countryRisk == "LOW"
	vendor.riskScore < 40
	vendor.requestedSpend <= 500000
} else := {"disposition": "approve", "reasons": []} if {
	vendor.countryRisk == "LOW"
	vendor.riskScore < 40
	vendor.requestedSpend > 500000
	vendor.requestedSpend <= 2000000
	evidence := object.get(input, "evidence", {})
	object.get(evidence, "insurance-certificate", "unreported") == "present"
} else := {"disposition": "enhanced-review", "reasons": []} if {
	vendor.countryRisk == "LOW"
	vendor.riskScore < 40
	vendor.requestedSpend > 500000
	vendor.requestedSpend <= 2000000
	evidence := object.get(input, "evidence", {})
	object.get(evidence, "insurance-certificate", "unreported") == "absent"
} else := {"disposition": "unresolved", "reasons": ["unknown"]} if {
	vendor.countryRisk == "LOW"
	vendor.riskScore < 40
	vendor.requestedSpend > 500000
	vendor.requestedSpend <= 2000000
	evidence := object.get(input, "evidence", {})
	object.get(evidence, "insurance-certificate", "unreported") == "unreported"
} else := {"disposition": "approve", "reasons": []} if {
	vendor.countryRisk == "LOW"
	vendor.riskScore >= 40
	vendor.riskScore < 70
	vendor.requestedSpend <= 100000
	object.get(vendor, "newVendor", "no") != "yes"
} else := {"disposition": "approve", "reasons": []} if {
	vendor.countryRisk == "MEDIUM"
	vendor.riskScore < 40
	vendor.requestedSpend <= 100000
} else := {"disposition": "review", "reasons": []} if {
	true
}
```

TESTS:
```rego
package study_test

import data.study

test_missing_financial_evidence_precedes_sanctions_rejection if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["missing-required-evidence"],
	} with input as {
		"vendor": {
			"sanctionsStatus": "MATCH",
		},
		"evidence": {
			"financial-evidence": "absent",
		},
	}
}

test_unreported_financial_evidence_is_unknown if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["unknown"],
	} with input as {
		"vendor": {
			"sanctionsStatus": "CLEAR",
			"riskScore": 10,
			"requestedSpend": 100,
			"countryRisk": "LOW",
		},
		"evidence": {},
	}
}

test_sanctions_match_rejects_even_critical_supplier if {
	study.decision == {
		"disposition": "reject",
		"reasons": [],
	} with input as {
		"vendor": {
			"sanctionsStatus": "MATCH",
			"criticalSupplier": "yes",
		},
		"evidence": {
			"financial-evidence": "present",
		},
	}
}

test_unknown_sanctions_has_no_match if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["no-match"],
	} with input as {
		"vendor": {
			"sanctionsStatus": "UNKNOWN",
		},
		"evidence": {
			"financial-evidence": "present",
		},
	}
}

test_large_high_country_exposure_escalates_before_rejection if {

POLICY:
```rego
package study

default decision := {"disposition": "unresolved", "reasons": ["no-match"]}

decision := {"disposition": "unresolved", "reasons": ["missing-required-evidence"]} if {
	financial_evidence_status == "absent"
} else := {"disposition": "unresolved", "reasons": ["unknown"]} if {
	financial_evidence_status == "unreported"
} else := {"disposition": "reject", "reasons": []} if {
	input.vendor.sanctionsStatus == "MATCH"
} else := {"disposition": "unresolved", "reasons": ["no-match"]} if {
	input.vendor.sanctionsStatus == "UNKNOWN"
} else := result if {
	input.vendor.sanctionsStatus == "CLEAR"
	result := clear_decision(input.vendor, input.evidence)
}

financial_evidence_status := object.get(
	object.get(input, "evidence", {}),
	"financial-evidence",
	"unreported",
)

has_key(obj, key) if {
	key in object.keys(obj)
}

all_readable(vendor) if {
	has_key(vendor, "riskScore")
	has_key(vendor, "requestedSpend")
	has_key(vendor, "countryRisk")
}

risk_values(vendor) := [vendor.riskScore] if {
	has_key(vendor, "riskScore")
} else := [0, 39, 40, 69, 70, 89, 90, 100]

spend_values(vendor) := [vendor.requestedSpend] if {
	has_key(vendor, "requestedSpend")
} else := [
	0,
	100000,
	100000.01,
	500000,
	500000.01,
	2000000,
	2000000.01,
	10000000,
]

country_values(vendor) := [vendor.countryRisk] if {
	has_key(vendor, "countryRisk")
} else := ["LOW", "MEDIUM", "HIGH"]

possible_clear_outcomes(vendor, evidence) := {
	outcome |
	some risk in risk_values(vendor)
	some spend in spend_values(vendor)
	some country in country_values(vendor)
	completed_vendor := object.union(vendor, {
		"riskScore": risk,
		"requestedSpend": spend,
		"countryRisk": country,
	})
	outcome := readable_clear_outcome(completed_vendor, evidence)
}

clear_decision(vendor, evidence) := outcome if {
	all_readable(vendor)
	outcome := readable_clear_outcome(vendor, evidence)
} else := outcome if {
	not all_readable(vendor)
	outcomes := possible_clear_outcomes(vendor, evidence)
	count(outcomes) == 1
	some outcome in outcomes
} else := {"disposition": "unresolved", "reasons": ["unknown"]}

readable_clear_outcome(vendor, evidence) := {
	"disposition": "unresolved",
	"reasons": ["exception-escalation"],
} if {
	vendor.countryRisk == "HIGH"
	vendor.requestedSpend > 2000000
} else := {"disposition": "review", "reasons": []} if {
	object.get(vendor, "criticalSupplier", "no") == "yes"
} else := {"disposition": "reject", "reasons": []} if {
	vendor.riskScore >= 90
} else := {"disposition": "reject", "reasons": []} if {
	vendor.countryRisk == "HIGH"
	vendor.riskScore >= 70
} else := {"disposition": "reject", "reasons": []} if {
	object.get(vendor, "priorEnforcement", "no") == "yes"
} else := {"disposition": "approve", "reasons": []} if {
	vendor.countryRisk == "LOW"
	vendor.riskScore < 40
	vendor.requestedSpend <= 500000
} else := {"disposition": "approve", "reasons": []} if {
	vendor.countryRisk == "LOW"
	vendor.riskScore < 40
	vendor.requestedSpend > 500000
	vendor.requestedSpend <= 2000000
	object.get(evidence, "insurance-certificate", "unreported") == "present"
} else := {"disposition": "enhanced-review", "reasons": []} if {
	vendor.countryRisk == "LOW"
	vendor.riskScore < 40
	vendor.requestedSpend > 500000
	vendor.requestedSpend <= 2000000
	object.get(evidence, "insurance-certificate", "unreported") == "absent"
} else := {"disposition": "unresolved", "reasons": ["unknown"]} if {
	vendor.countryRisk == "LOW"
	vendor.riskScore < 40
	vendor.requestedSpend > 500000
	vendor.requestedSpend <= 2000000
	object.get(evidence, "insurance-certificate", "unreported") == "unreported"
} else := {"disposition": "approve", "reasons": []} if {
	vendor.countryRisk == "LOW"
	vendor.riskScore >= 40
	vendor.riskScore < 70
	vendor.requestedSpend <= 100000
	object.get(vendor, "newVendor", "no") != "yes"
} else := {"disposition": "approve", "reasons": []} if {
	vendor.countryRisk == "MEDIUM"
	vendor.riskScore < 40
	vendor.requestedSpend <= 100000
} else := {"disposition": "review", "reasons": []}
```

TESTS:
```rego
package study_test

import data.study

present_financial := {"financial-evidence": "present"}

test_missing_financial_evidence_precedes_sanctions_rejection if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["missing-required-evidence"],
	} with input as {
		"vendor": {"sanctionsStatus": "MATCH"},
		"evidence": {"financial-evidence": "absent"},
	}
}

test_unreported_financial_evidence_is_unknown if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["unknown"],
	} with input as {
		"vendor": {"sanctionsStatus": "MATCH"},
		"evidence": {},
	}
}

test_sanctions_match_rejects_despite_critical_supplier if {
	study.decision == {"disposition": "reject", "reasons": []} with input as {
		"vendor": {
			"sanctionsStatus": "MATCH",
			"criticalSupplier": "yes",
		},
		"evidence": present_financial,
	}
}

test_unknown_sanctions_has_no_match if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["no-match"],
	} with input as {
		"vendor": {"sanctionsStatus": "UNKNOWN"},
		"evidence": present_financial,
	}
}

test_large_high_country_exposure_escalates_before_critical_override if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["exception-escalation"],
	} with input as {
		"vendor": {
			"riskScore": 95,
			"requestedSpend": 2000000.01,
			"sanctionsStatus": "CLEAR",
			"countryRisk": "HIGH",
			"criticalSupplier": "yes",
			"priorEnforcement": "yes",
		},
		"evidence": present_financial,
	}
}

test_critical_supplier_is_reviewed if {
	study.decision == {"disposition": "review", "reasons": []} with input as {
		"vendor": {
			"riskScore": 95,
			"requestedSpend": 100,
			"sanctionsStatus": "CLEAR",
			"countryRisk": "LOW",
			"criticalSupplier": "yes",
		},
		"evidence": present_financial,
	}
}

test_critical_risk_rejects if {
	study.decision == {"disposition": "reject", "reasons": []} with input as {
		"vendor": {
			"riskScore": 90,
			"requestedSpend": 100,
			"sanctionsStatus": "CLEAR",
			"countryRisk": "LOW",
		},
		"evidence": present_financial,
	}
}

test_high_country_rejects_at_risk_70 if {
	study.decision == {"disposition": "reject", "reasons": []} with input as {
		"vendor": {
			"riskScore": 70,
			"requestedSpend": 100,
			"sanctionsStatus": "CLEAR",
			"countryRisk": "HIGH",
		},
		"evidence": present_financial,
	}
}

test_prior_enforcement_rejects if {
	study.decision == {"disposition": "reject", "reasons": []} with input as {
		"vendor": {
			"riskScore": 10,
			"requestedSpend": 100,
			"sanctionsStatus": "CLEAR",
			"countryRisk": "LOW",
			"priorEnforcement": "yes",
		},
		"evidence": present_financial,

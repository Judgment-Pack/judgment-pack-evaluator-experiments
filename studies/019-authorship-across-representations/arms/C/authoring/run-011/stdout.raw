POLICY:
```rego
package study

default decision := {"disposition": "unresolved", "reasons": ["no-match"]}

decision := {"disposition": "unresolved", "reasons": ["missing-required-evidence"]} if {
	input.evidence["financial-evidence"] == "absent"
} else := {"disposition": "unresolved", "reasons": ["unknown"]} if {
	not input.evidence["financial-evidence"]
} else := {"disposition": "reject", "reasons": []} if {
	input.vendor.sanctionsStatus == "MATCH"
} else := {"disposition": "unresolved", "reasons": ["no-match"]} if {
	input.vendor.sanctionsStatus == "UNKNOWN"
} else := result if {
	input.vendor.sanctionsStatus == "CLEAR"
	result := clear_result(input.vendor)
}

clear_result(vendor) := result if {
	outcomes := {
		outcome |
		some risk in risk_values(vendor)
		some spend in spend_values(vendor)
		some country in country_values(vendor)
		completed := object.union(vendor, {
			"riskScore": risk,
			"requestedSpend": spend,
			"countryRisk": country,
		})
		outcome := readable_outcome(completed)
	}
	count(outcomes) == 1
	some result in outcomes
} else := {"disposition": "unresolved", "reasons": ["unknown"]}

risk_values(vendor) := [vendor.riskScore] if {
	vendor.riskScore
} else := numbers.range(0, 100)

spend_values(vendor) := [vendor.requestedSpend] if {
	vendor.requestedSpend
} else := [
	0,
	100000,
	100000.01,
	500000,
	500000.01,
	2000000,
	2000000.01,
]

country_values(vendor) := [vendor.countryRisk] if {
	vendor.countryRisk
} else := ["LOW", "MEDIUM", "HIGH"]

readable_outcome(vendor) := {
	"disposition": "unresolved",
	"reasons": ["exception-escalation"],
} if {
	vendor.countryRisk == "HIGH"
	vendor.requestedSpend > 2000000
} else := {"disposition": "review", "reasons": []} if {
	object.get(vendor, "criticalSupplier", "no") == "yes"
} else := {"disposition": "reject", "reasons": []} if {
	vendor.riskScore >= 90
} else := {"disposition": "reject", "reasons": []} if {
	vendor.countryRisk == "HIGH"
	vendor.riskScore >= 70
} else := {"disposition": "reject", "reasons": []} if {
	object.get(vendor, "priorEnforcement", "no") == "yes"
} else := {"disposition": "approve", "reasons": []} if {
	vendor.countryRisk == "LOW"
	vendor.riskScore < 40
	vendor.requestedSpend <= 500000
} else := {"disposition": "approve", "reasons": []} if {
	vendor.countryRisk == "LOW"
	vendor.riskScore < 40
	vendor.requestedSpend > 500000
	vendor.requestedSpend <= 2000000
	input.evidence["insurance-certificate"] == "present"
} else := {"disposition": "enhanced-review", "reasons": []} if {
	vendor.countryRisk == "LOW"
	vendor.riskScore < 40
	vendor.requestedSpend > 500000
	vendor.requestedSpend <= 2000000
	input.evidence["insurance-certificate"] == "absent"
} else := {"disposition": "unresolved", "reasons": ["unknown"]} if {
	vendor.countryRisk == "LOW"
	vendor.riskScore < 40
	vendor.requestedSpend > 500000
	vendor.requestedSpend <= 2000000
	not input.evidence["insurance-certificate"]
} else := {"disposition": "approve", "reasons": []} if {
	vendor.countryRisk == "LOW"
	vendor.riskScore >= 40
	vendor.riskScore < 70
	vendor.requestedSpend <= 100000
	object.get(vendor, "newVendor", "no") != "yes"
} else := {"disposition": "approve", "reasons": []} if {
	vendor.countryRisk == "MEDIUM"
	vendor.riskScore < 40
	vendor.requestedSpend <= 100000
} else := {"disposition": "review", "reasons": []}
```

TESTS:
```rego
package study_test

import data.study

financial := {"financial-evidence": "present"}

test_missing_financial_evidence_blocks_rejection if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["missing-required-evidence"],
	} with input as {
		"vendor": {
			"sanctionsStatus": "MATCH",
			"riskScore": 95,
			"requestedSpend": 100,
			"countryRisk": "LOW",
		},
		"evidence": {"financial-evidence": "absent"},
	}
}

test_unreported_financial_evidence_is_unknown if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["unknown"],
	} with input as {
		"vendor": {"sanctionsStatus": "MATCH"},
		"evidence": {},
	}
}

test_sanctions_match_rejects_even_critical_supplier if {
	study.decision == {"disposition": "reject", "reasons": []} with input as {
		"vendor": {
			"sanctionsStatus": "MATCH",
			"criticalSupplier": "yes",
		},
		"evidence": financial,
	}
}

test_unknown_sanctions_has_no_match if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["no-match"],
	} with input as {
		"vendor": {"sanctionsStatus": "UNKNOWN"},
		"evidence": financial,
	}
}

test_large_high_country_exposure_escalates_before_critical_override if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["exception-escalation"],
	} with input as {
		"vendor": {
			"sanctionsStatus": "CLEAR",
			"riskScore": 95,
			"requestedSpend": 2000000.01,
			"countryRisk": "HIGH",
			"criticalSupplier": "yes",
			"priorEnforcement": "yes",
		},
		"evidence": financial,
	}
}

test_critical_supplier_gets_review if {
	study.decision == {"disposition": "review", "reasons": []} with input as {
		"vendor": {
			"sanctionsStatus": "CLEAR",
			"riskScore": 95,
			"requestedSpend": 100,
			"countryRisk": "LOW",
			"criticalSupplier": "yes",
		},
		"evidence": financial,
	}
}


POLICY:
```rego
package study

default decision := {"disposition": "unresolved", "reasons": ["no-match"]}

decision := {"disposition": "unresolved", "reasons": ["unknown"]} if {
	evidence := object.get(input, "evidence", {})
	not "financial-evidence" in evidence
} else := {"disposition": "unresolved", "reasons": ["missing-required-evidence"]} if {
	input.evidence["financial-evidence"] == "absent"
} else := {"disposition": "reject", "reasons": []} if {
	input.evidence["financial-evidence"] == "present"
	input.vendor.sanctionsStatus == "MATCH"
} else := {"disposition": "unresolved", "reasons": ["no-match"]} if {
	input.evidence["financial-evidence"] == "present"
	input.vendor.sanctionsStatus == "UNKNOWN"
} else := result if {
	input.evidence["financial-evidence"] == "present"
	input.vendor.sanctionsStatus == "CLEAR"
	result := clear_result
}

risk_values := [input.vendor.riskScore] if {
	"riskScore" in input.vendor
}

risk_values := [0, 39, 40, 69, 70, 89, 90] if {
	not "riskScore" in input.vendor
}

spend_values := [input.vendor.requestedSpend] if {
	"requestedSpend" in input.vendor
}

spend_values := [0, 100000, 100000.01, 500000, 500000.01, 2000000, 2000000.01] if {
	not "requestedSpend" in input.vendor
}

country_values := [input.vendor.countryRisk] if {
	"countryRisk" in input.vendor
}

country_values := ["LOW", "MEDIUM", "HIGH"] if {
	not "countryRisk" in input.vendor
}

candidate_outcomes := {out |
	some risk in risk_values
	some spend in spend_values
	some country in country_values
	out := clear_outcome(risk, spend, country)
}

clear_result := outcome_result[out] if {
	count(candidate_outcomes) == 1
	some out in candidate_outcomes
}

clear_result := {"disposition": "unresolved", "reasons": ["unknown"]} if {
	count(candidate_outcomes) != 1
}

outcome_result := {
	"approve": {"disposition": "approve", "reasons": []},
	"review": {"disposition": "review", "reasons": []},
	"enhanced-review": {"disposition": "enhanced-review", "reasons": []},
	"reject": {"disposition": "reject", "reasons": []},
	"insurance-unknown": {"disposition": "unresolved", "reasons": ["unknown"]},
	"exception-escalation": {"disposition": "unresolved", "reasons": ["exception-escalation"]},
}

clear_outcome(risk, spend, country) := "exception-escalation" if {
	country == "HIGH"
	spend > 2000000
} else := "review" if {
	input.vendor.criticalSupplier == "yes"
} else := "reject" if {
	risk >= 90
} else := "reject" if {
	country == "HIGH"
	risk >= 70
} else := "reject" if {
	input.vendor.priorEnforcement == "yes"
} else := "approve" if {
	country == "LOW"
	risk < 40
	spend <= 500000
} else := d6b_outcome if {
	country == "LOW"
	risk < 40
	spend > 500000
	spend <= 2000000
	d6b_outcome := insurance_outcome
} else := "approve" if {
	country == "LOW"
	risk >= 40
	risk < 70
	spend <= 100000
	input.vendor.newVendor != "yes"
} else := "approve" if {
	country == "MEDIUM"
	risk < 40
	spend <= 100000
} else := "review"

insurance_outcome := "approve" if {
	input.evidence["insurance-certificate"] == "present"
}

insurance_outcome := "enhanced-review" if {
	input.evidence["insurance-certificate"] == "absent"
}

insurance_outcome := "insurance-unknown" if {
	not "insurance-certificate" in input.evidence
}
```

TESTS:
```rego
package study_test

import data.study

financial_present := {"financial-evidence": "present"}

test_financial_evidence_unreported_is_unknown if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["unknown"],
	} with input as {
		"vendor": {
			"riskScore": 95,
			"requestedSpend": 100,
			"sanctionsStatus": "MATCH",
			"countryRisk": "LOW",
		},
		"evidence": {},
	}
}

test_financial_evidence_absent_precedes_sanctions_match if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["missing-required-evidence"],
	} with input as {
		"vendor": {
			"riskScore": 95,
			"requestedSpend": 100,
			"sanctionsStatus": "MATCH",
			"countryRisk": "HIGH",
		},
		"evidence": {"financial-evidence": "absent"},
	}
}

test_sanctions_match_rejects_critical_supplier if {
	study.decision == {"disposition": "reject", "reasons": []} with input as {
		"vendor": {
			"riskScore": 10,
			"requestedSpend": 100,
			"sanctionsStatus": "MATCH",
			"countryRisk": "LOW",
			"criticalSupplier": "yes",
		},
		"evidence": financial_present,
	}
}

test_unknown_sanctions_has_no_match if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["no-match"],
	} with input as {
		"vendor": {
			"riskScore": 10,
			"requestedSpend": 100,
			"sanctionsStatus": "UNKNOWN",
			"countryRisk": "LOW",
		},
		"evidence": financial_present,
	}
}

test_o3_precedes_critical_supplier_and_rejection if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["exception-escalation"],
	} with input as {
		"vendor": {
			"riskScore": 99,
			"requestedSpend": 2000000.01,
			"sanctionsStatus": "CLEAR",
			"countryRisk": "HIGH",
			"criticalSupplier": "yes",
			"priorEnforcement": "yes",
		},
		"evidence": financial_present,
	}
}

test_critical_supplier_clear_is_review if {
	study.decision == {"disposition": "review", "reasons": []} with input as {
		"vendor": {
			"riskScore": 99,
			"requestedSpend": 100,
			"sanctionsStatus": "CLEAR",
			"countryRisk": "LOW",
			"criticalSupplier": "yes",
			"priorEnforcement": "yes",
		},
		"evidence": financial_present,
	}
}

test_risk_90_rejects if {

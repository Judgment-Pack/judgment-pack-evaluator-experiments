POLICY:
```rego
package study

default decision := {"disposition": "unresolved", "reasons": ["no-match"]}

decision := {"disposition": "unresolved", "reasons": ["missing-required-evidence"]} if {
	object.get(input.evidence, "financial-evidence", "unreported") == "absent"
} else := {"disposition": "unresolved", "reasons": ["unknown"]} if {
	object.get(input.evidence, "financial-evidence", "unreported") == "unreported"
} else := {"disposition": "reject", "reasons": []} if {
	input.vendor.sanctionsStatus == "MATCH"
} else := {"disposition": "unresolved", "reasons": ["no-match"]} if {
	input.vendor.sanctionsStatus == "UNKNOWN"
} else := result if {
	input.vendor.sanctionsStatus == "CLEAR"
	result := unreadable_aware_decision
}

unreadable_aware_decision := result if {
	count(candidate_outcomes) == 1
	some result in candidate_outcomes
} else := {"disposition": "unresolved", "reasons": ["unknown"]}

candidate_outcomes contains result if {
	some risk_score in possible_risk_scores
	some requested_spend in possible_requested_spends
	some country_risk in possible_country_risks
	result := readable_outcome(risk_score, requested_spend, country_risk)
}

possible_risk_scores := [input.vendor.riskScore] if {
	"riskScore" in object.keys(input.vendor)
} else := [0, 39, 40, 69, 70, 89, 90, 100]

possible_requested_spends := [input.vendor.requestedSpend] if {
	"requestedSpend" in object.keys(input.vendor)
} else := [
	0,
	100000,
	100000.01,
	500000,
	500000.01,
	2000000,
	2000000.01,
	10000000,
]

possible_country_risks := [input.vendor.countryRisk] if {
	"countryRisk" in object.keys(input.vendor)
} else := ["LOW", "MEDIUM", "HIGH"]

readable_outcome(risk_score, requested_spend, country_risk) := {
	"disposition": "unresolved",
	"reasons": ["exception-escalation"],
} if {
	country_risk == "HIGH"
	requested_spend > 2000000
} else := {"disposition": "review", "reasons": []} if {
	object.get(input.vendor, "criticalSupplier", "no") == "yes"
} else := {"disposition": "reject", "reasons": []} if {
	risk_score >= 90
} else := {"disposition": "reject", "reasons": []} if {
	country_risk == "HIGH"
	risk_score >= 70
} else := {"disposition": "reject", "reasons": []} if {
	object.get(input.vendor, "priorEnforcement", "no") == "yes"
} else := {"disposition": "approve", "reasons": []} if {
	country_risk == "LOW"
	risk_score < 40
	requested_spend <= 500000
} else := {"disposition": "approve", "reasons": []} if {
	country_risk == "LOW"
	risk_score < 40
	requested_spend > 500000
	requested_spend <= 2000000
	object.get(input.evidence, "insurance-certificate", "unreported") == "present"
} else := {"disposition": "enhanced-review", "reasons": []} if {
	country_risk == "LOW"
	risk_score < 40
	requested_spend > 500000
	requested_spend <= 2000000
	object.get(input.evidence, "insurance-certificate", "unreported") == "absent"
} else := {"disposition": "unresolved", "reasons": ["unknown"]} if {
	country_risk == "LOW"
	risk_score < 40
	requested_spend > 500000
	requested_spend <= 2000000
	object.get(input.evidence, "insurance-certificate", "unreported") == "unreported"
} else := {"disposition": "approve", "reasons": []} if {
	country_risk == "LOW"
	risk_score >= 40
	risk_score < 70
	requested_spend <= 100000
	object.get(input.vendor, "newVendor", "no") != "yes"
} else := {"disposition": "approve", "reasons": []} if {
	country_risk == "MEDIUM"
	risk_score < 40
	requested_spend <= 100000
} else := {"disposition": "review", "reasons": []}
```

TESTS:
```rego
package study_test

import data.study

financial_evidence := {"financial-evidence": "present"}

test_missing_financial_evidence_precedes_sanctions_rejection if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["missing-required-evidence"],
	} with input as {
		"vendor": {
			"sanctionsStatus": "MATCH",
			"riskScore": 95,
			"requestedSpend": 100,
			"countryRisk": "LOW",
		},
		"evidence": {"financial-evidence": "absent"},
	}
}

test_unreported_financial_evidence_is_unknown if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["unknown"],
	} with input as {
		"vendor": {"sanctionsStatus": "MATCH"},
		"evidence": {},
	}
}

test_sanctions_match_rejects_without_other_vendor_inputs if {
	study.decision == {"disposition": "reject", "reasons": []} with input as {
		"vendor": {"sanctionsStatus": "MATCH"},
		"evidence": financial_evidence,
	}
}

test_unknown_sanctions_has_no_match if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["no-match"],
	} with input as {
		"vendor": {"sanctionsStatus": "UNKNOWN"},
		"evidence": financial_evidence,
	}
}

test_low_risk_low_spend_approves if {
	study.decision == {"disposition": "approve", "reasons": []} with input as {
		"vendor": {
			"sanctionsStatus": "CLEAR",
			"riskScore": 39,
			"requestedSpend": 500000,
			"countryRisk": "LOW",
		},
		"evidence": financial_evidence,
	}
}

test_d6b_present_insurance_approves_at_upper_boundary if {
	study.decision == {"disposition": "approve", "reasons": []} with input as {
		"vendor": {
			"sanctionsStatus": "CLEAR",
			"riskScore": 20,
			"requestedSpend": 2000000,
			"countryRisk": "LOW",
		},
		"evidence": {
			"financial-evidence": "present",
			"insurance-certificate": "present",
		},
	}
}

test_d6b_absent_insurance_gets_enhanced_review if {
	study.decision == {
		"disposition": "enhanced-review",
		"reasons": [],
	} with input as {
		"vendor": {
			"sanctionsStatus": "CLEAR",
			"riskScore": 20,
			"requestedSpend": 500000.01,
			"countryRisk": "LOW",
		},
		"evidence": {
			"financial-evidence": "present",
			"insurance-certificate": "absent",
		},
	}
}

test_d6b_unreported_insurance_is_unknown if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["unknown"],
	} with input as {
		"vendor": {
			"sanctionsStatus": "CLEAR",
			"riskScore": 20,
			"requestedSpend": 1000000,
			"countryRisk": "LOW",
		},
		"evidence": financial_evidence,
	}
}

test_new_vendor_suspends_d6c if {
	study.decision == {"disposition": "review", "reasons": []} with input as {
		"vendor": {
			"sanctionsStatus": "CLEAR",
			"riskScore": 40,
			"requestedSpend": 100000,
			"countryRisk": "LOW",
			"newVendor": "yes",
		},
		"evidence": financial_evidence,
	}
}

test_unreported_new_vendor_is_treated_as_no if {
	study.decision == {"disposition": "approve", "reasons": []} with input as {
		"vendor": {
			"sanctionsStatus": "CLEAR",
			"riskScore": 69,
			"requestedSpend": 100000,
			"countryRisk": "LOW",
		},
		"evidence": financial_evidence,
	}
}

test_medium_country_approval_boundary if {
	study.decision == {"disposition": "approve", "reasons": []} with input as {
		"vendor": {
			"sanctionsStatus": "CLEAR",
			"riskScore": 39,
			"requestedSpend": 100000,
			"countryRisk": "MEDIUM",
		},
		"evidence": financial_evidence,
	}
}

test_high_country_rejects_at_risk_70 if {
	study.decision == {"disposition": "reject", "reasons": []} with input as {
		"vendor": {
			"sanctionsStatus": "CLEAR",
			"riskScore": 70,
			"requestedSpend": 2000000,
			"countryRisk": "HIGH",
		},
		"evidence": financial_evidence,
	}
}

test_prior_enforcement_rejects if {

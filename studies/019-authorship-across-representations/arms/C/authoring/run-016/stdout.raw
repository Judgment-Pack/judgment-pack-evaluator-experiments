			"sanctionsStatus": "CLEAR",
			"requestedSpend": 100,
			"countryRisk": "LOW",
		},
		"evidence": financial_evidence,
	}
}

test_clear_request_not_reached_by_approval_or_rejection_gets_review if {
	study.decision == {"disposition": "review", "reasons": []} with input as {
		"vendor": {
			"sanctionsStatus": "CLEAR",
			"riskScore": 70,
			"requestedSpend": 100,
			"countryRisk": "MEDIUM",
		},
		"evidence": financial_evidence,
	}
}

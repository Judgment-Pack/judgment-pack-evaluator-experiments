POLICY:
```rego
package study

default decision := {"disposition": "unresolved", "reasons": ["no-match"]}

decision := {"disposition": "unresolved", "reasons": ["missing-required-evidence"]} if {
	financial_evidence == "absent"
} else := {"disposition": "unresolved", "reasons": ["unknown"]} if {
	financial_evidence == "unreported"
} else := result if {
	financial_evidence == "present"
	outcomes := {
		outcome |
		some risk_score in possible_risk_scores
		some requested_spend in possible_requested_spends
		some country_risk in possible_country_risks
		outcome := readable_outcome(risk_score, requested_spend, country_risk)
	}
	count(outcomes) == 1
	some result in outcomes
} else := {"disposition": "unresolved", "reasons": ["unknown"]}

financial_evidence := object.get(
	object.get(input, "evidence", {}),
	"financial-evidence",
	"unreported",
)

vendor := object.get(input, "vendor", {})

risk_score_reported if {
	object.get(vendor, "riskScore", -1) != -1
}

possible_risk_scores := [vendor.riskScore] if {
	risk_score_reported
} else := numbers.range(0, 100)

requested_spend_reported if {
	object.get(vendor, "requestedSpend", -1) != -1
}

possible_requested_spends := [vendor.requestedSpend] if {
	requested_spend_reported
} else := [
	0,
	100000,
	100000.01,
	500000,
	500000.01,
	2000000,
	2000000.01,
	10000000,
]

country_risk_reported if {
	object.get(vendor, "countryRisk", "unreported") != "unreported"
}

possible_country_risks := [vendor.countryRisk] if {
	country_risk_reported
} else := ["LOW", "MEDIUM", "HIGH"]

readable_outcome(_, _, _) := {"disposition": "reject", "reasons": []} if {
	vendor.sanctionsStatus == "MATCH"
} else := {"disposition": "unresolved", "reasons": ["no-match"]} if {
	vendor.sanctionsStatus == "UNKNOWN"
} else := {"disposition": "unresolved", "reasons": ["exception-escalation"]} if {
	vendor.sanctionsStatus == "CLEAR"
	country_risk == "HIGH"
	requested_spend > 2000000
} else := {"disposition": "review", "reasons": []} if {
	vendor.sanctionsStatus == "CLEAR"
	object.get(vendor, "criticalSupplier", "no") == "yes"
} else := {"disposition": "reject", "reasons": []} if {
	vendor.sanctionsStatus == "CLEAR"
	risk_score >= 90
} else := {"disposition": "reject", "reasons": []} if {
	vendor.sanctionsStatus == "CLEAR"
	country_risk == "HIGH"
	risk_score >= 70
} else := {"disposition": "reject", "reasons": []} if {
	vendor.sanctionsStatus == "CLEAR"
	object.get(vendor, "priorEnforcement", "no") == "yes"
} else := {"disposition": "approve", "reasons": []} if {
	vendor.sanctionsStatus == "CLEAR"
	country_risk == "LOW"
	risk_score < 40
	requested_spend <= 500000
} else := {"disposition": "approve", "reasons": []} if {
	vendor.sanctionsStatus == "CLEAR"
	country_risk == "LOW"
	risk_score < 40
	requested_spend > 500000
	requested_spend <= 2000000
	object.get(
		object.get(input, "evidence", {}),
		"insurance-certificate",
		"unreported",
	) == "present"
} else := {"disposition": "enhanced-review", "reasons": []} if {
	vendor.sanctionsStatus == "CLEAR"
	country_risk == "LOW"
	risk_score < 40
	requested_spend > 500000
	requested_spend <= 2000000
	object.get(
		object.get(input, "evidence", {}),
		"insurance-certificate",
		"unreported",
	) == "absent"
} else := {"disposition": "unresolved", "reasons": ["unknown"]} if {
	vendor.sanctionsStatus == "CLEAR"
	country_risk == "LOW"
	risk_score < 40
	requested_spend > 500000
	requested_spend <= 2000000
	object.get(
		object.get(input, "evidence", {}),
		"insurance-certificate",
		"unreported",
	) == "unreported"
} else := {"disposition": "approve", "reasons": []} if {
	vendor.sanctionsStatus == "CLEAR"
	country_risk == "LOW"
	risk_score >= 40
	risk_score < 70
	requested_spend <= 100000
	object.get(vendor, "newVendor", "no") != "yes"
} else := {"disposition": "approve", "reasons": []} if {
	vendor.sanctionsStatus == "CLEAR"
	country_risk == "MEDIUM"
	risk_score < 40
	requested_spend <= 100000
} else := {"disposition": "review", "reasons": []} if {
	vendor.sanctionsStatus == "CLEAR"
}
```

TESTS:
```rego
package study_test

import data.study

present_financial_evidence := {
	"financial-evidence": "present",
}

test_missing_financial_evidence_precedes_sanctions_match if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["missing-required-evidence"],
	} with input as {
		"vendor": {
			"riskScore": 95,
			"requestedSpend": 100,
			"sanctionsStatus": "MATCH",
			"countryRisk": "LOW",
		},
		"evidence": {
			"financial-evidence": "absent",
		},
	}
}

test_unreported_financial_evidence_is_unknown if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["unknown"],
	} with input as {
		"vendor": {
			"riskScore": 10,
			"requestedSpend": 100,
			"sanctionsStatus": "CLEAR",
			"countryRisk": "LOW",
		},
	}
}

test_sanctions_match_rejects if {
	study.decision.disposition == "reject" with input as {
		"vendor": {
			"sanctionsStatus": "MATCH",
		},
		"evidence": present_financial_evidence,
	}
}

test_unknown_sanctions_has_no_match if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["no-match"],
	} with input as {
		"vendor": {
			"sanctionsStatus": "UNKNOWN",
		},
		"evidence": present_financial_evidence,
	}
}

test_large_high_country_exposure_escalates_before_critical_override if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["exception-escalation"],
	} with input as {
		"vendor": {
			"riskScore": 95,
			"requestedSpend": 2000000.01,
			"sanctionsStatus": "CLEAR",
			"countryRisk": "HIGH",
			"criticalSupplier": "yes",
			"priorEnforcement": "yes",
		},
		"evidence": present_financial_evidence,
	}
}

test_critical_supplier_reviews_despite_automatic_rejection if {
	study.decision.disposition == "review" with input as {
		"vendor": {
			"riskScore": 95,
			"requestedSpend": 100,
			"sanctionsStatus": "CLEAR",
			"countryRisk": "LOW",
			"criticalSupplier": "yes",
		},
		"evidence": present_financial_evidence,
	}
}

test_low_risk_low_country_small_spend_approves if {
	study.decision.disposition == "approve" with input as {
		"vendor": {
			"riskScore": 39,
			"requestedSpend": 500000,
			"sanctionsStatus": "CLEAR",
			"countryRisk": "LOW",
		},
		"evidence": present_financial_evidence,
	}
}

test_d6b_present_insurance_approves if {
	study.decision.disposition == "approve" with input as {
		"vendor": {
			"riskScore": 39,
			"requestedSpend": 2000000,
			"sanctionsStatus": "CLEAR",
			"countryRisk": "LOW",
		},
		"evidence": {
			"financial-evidence": "present",
			"insurance-certificate": "present",
		},
	}
}

test_d6b_absent_insurance_enhanced_review if {
	study.decision.disposition == "enhanced-review" with input as {
		"vendor": {
			"riskScore": 39,
			"requestedSpend": 500000.01,
			"sanctionsStatus": "CLEAR",
			"countryRisk": "LOW",
		},
		"evidence": {
			"financial-evidence": "present",
			"insurance-certificate": "absent",
		},
	}
}

test_d6b_unreported_insurance_is_unknown if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["unknown"],
	} with input as {
		"vendor": {
			"riskScore": 39,
			"requestedSpend": 500000.01,
			"sanctionsStatus": "CLEAR",
			"countryRisk": "LOW",
		},
		"evidence": present_financial_evidence,
	}
}

test_new_vendor_suspends_d6c if {
	study.decision.disposition == "review" with input as {
		"vendor": {
			"riskScore": 40,
			"requestedSpend": 100000,
			"sanctionsStatus": "CLEAR",
			"countryRisk": "LOW",
			"newVendor": "yes",
		},
		"evidence": present_financial_evidence,
	}
}

test_unreported_new_vendor_is_treated_as_no if {
	study.decision.disposition == "approve" with input as {
		"vendor": {
			"riskScore": 69,
			"requestedSpend": 100000,
			"sanctionsStatus": "CLEAR",
			"countryRisk": "LOW",
		},
		"evidence": present_financial_evidence,
	}
}

test_prior_enforcement_rejects if {
	study.decision.disposition == "reject" with input as {
		"vendor": {
			"riskScore": 1,
			"requestedSpend": 1,
			"sanctionsStatus": "CLEAR",
			"countryRisk": "LOW",
			"priorEnforcement": "yes",
		},
		"evidence": present_financial_evidence,
	}
}

test_u1_critical_risk_with_unreadable_country_still_rejects if {
	study.decision.disposition == "reject" with input as {
		"vendor": {
			"riskScore": 95,
			"requestedSpend": 1000000,
			"sanctionsStatus": "CLEAR",
		},
		"evidence": present_financial_evidence,
	}
}

test_u1_high_country_unreadable_spend_has_different_outcomes if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["unknown"],
	} with input as {
		"vendor": {
			"riskScore": 50,
			"sanctionsStatus": "CLEAR",
			"countryRisk": "HIGH",
		},
		"evidence": present_financial_evidence,
	}
}

test_u1_critical_supplier_with_unreadable_risk_reviews if {
	study.decision.disposition == "review" with input as {
		"vendor": {
			"requestedSpend": 100,
			"sanctionsStatus": "CLEAR",
			"countryRisk": "LOW",
			"criticalSupplier": "yes",
		},
		"evidence": present_financial_evidence,
	}
}

test_u1_critical_supplier_with_unreadable_country_and_spend_is_unknown if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["unknown"],
	} with input as {
		"vendor": {
			"riskScore": 10,
			"sanctionsStatus": "CLEAR",
			"criticalSupplier": "yes",
		},
		"evidence": present_financial_evidence,
	}
}

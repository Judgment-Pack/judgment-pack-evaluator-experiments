POLICY:
```rego
package study

default decision := {"disposition": "unresolved", "reasons": ["no-match"]}

decision := {"disposition": "unresolved", "reasons": ["missing-required-evidence"]} if {
	object.get(object.get(input, "evidence", {}), "financial-evidence", "__unreported__") == "absent"
} else := {"disposition": "unresolved", "reasons": ["unknown"]} if {
	object.get(object.get(input, "evidence", {}), "financial-evidence", "__unreported__") == "__unreported__"
} else := {"disposition": "unresolved", "reasons": ["no-match"]} if {
	object.get(input.vendor, "sanctionsStatus", "__unreported__") == "UNKNOWN"
} else := {"disposition": "reject", "reasons": []} if {
	input.vendor.sanctionsStatus == "MATCH"
} else := result if {
	input.vendor.sanctionsStatus == "CLEAR"

	outcomes := {
		outcome |
		some risk in possible_risk_scores
		some spend in possible_spend_amounts
		some country in possible_country_risks
		outcome := readable_outcome(risk, spend, country)
	}

	count(outcomes) == 1
	some result in outcomes
} else := {"disposition": "unresolved", "reasons": ["unknown"]} if {
	input.vendor.sanctionsStatus == "CLEAR"
}

possible_risk_scores := [input.vendor.riskScore] if {
	"riskScore" in input.vendor
} else := [0, 39, 40, 69, 70, 89, 90, 100]

possible_spend_amounts := [input.vendor.requestedSpend] if {
	"requestedSpend" in input.vendor
} else := [
	0,
	100000,
	100000.01,
	500000,
	500000.01,
	2000000,
	2000000.01,
	10000000,
]

possible_country_risks := [input.vendor.countryRisk] if {
	"countryRisk" in input.vendor
} else := ["LOW", "MEDIUM", "HIGH"]

readable_outcome(risk, spend, country) := {
	"disposition": "unresolved",
	"reasons": ["exception-escalation"],
} if {
	country == "HIGH"
	spend > 2000000
} else := {"disposition": "review", "reasons": []} if {
	object.get(input.vendor, "criticalSupplier", "no") == "yes"
} else := {"disposition": "reject", "reasons": []} if {
	risk >= 90
} else := {"disposition": "reject", "reasons": []} if {
	country == "HIGH"
	risk >= 70
} else := {"disposition": "reject", "reasons": []} if {
	object.get(input.vendor, "priorEnforcement", "no") == "yes"
} else := {"disposition": "approve", "reasons": []} if {
	country == "LOW"
	risk < 40
	spend <= 500000
} else := {"disposition": "approve", "reasons": []} if {
	country == "LOW"
	risk < 40
	spend > 500000
	spend <= 2000000
	object.get(object.get(input, "evidence", {}), "insurance-certificate", "__unreported__") == "present"
} else := {"disposition": "enhanced-review", "reasons": []} if {
	country == "LOW"
	risk < 40
	spend > 500000
	spend <= 2000000
	object.get(object.get(input, "evidence", {}), "insurance-certificate", "__unreported__") == "absent"
} else := {"disposition": "unresolved", "reasons": ["unknown"]} if {
	country == "LOW"
	risk < 40
	spend > 500000
	spend <= 2000000
	object.get(object.get(input, "evidence", {}), "insurance-certificate", "__unreported__") == "__unreported__"
} else := {"disposition": "approve", "reasons": []} if {
	country == "LOW"
	risk >= 40
	risk < 70
	spend <= 100000
	object.get(input.vendor, "newVendor", "no") != "yes"
} else := {"disposition": "approve", "reasons": []} if {
	country == "MEDIUM"
	risk < 40
	spend <= 100000
} else := {"disposition": "review", "reasons": []}
```

TESTS:
```rego
package study_test

import data.study

financial_evidence := {
	"financial-evidence": "present",
}

test_financial_evidence_absent_prevents_rejection if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["missing-required-evidence"],
	} with input as {
		"vendor": {
			"riskScore": 100,
			"requestedSpend": 100,
			"sanctionsStatus": "MATCH",
			"countryRisk": "HIGH",
		},
		"evidence": {
			"financial-evidence": "absent",
		},
	}
}

test_unreported_financial_evidence_is_unknown if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["unknown"],
	} with input as {
		"vendor": {
			"riskScore": 20,
			"requestedSpend": 100,
			"sanctionsStatus": "CLEAR",
			"countryRisk": "LOW",
		},
	}
}

test_sanctions_match_rejects if {
	study.decision == {"disposition": "reject", "reasons": []} with input as {
		"vendor": {
			"sanctionsStatus": "MATCH",
		},
		"evidence": financial_evidence,
	}
}

test_unknown_sanctions_has_no_match if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["no-match"],
	} with input as {
		"vendor": {
			"sanctionsStatus": "UNKNOWN",
		},
		"evidence": financial_evidence,
	}
}

test_low_risk_low_spend_approves if {
	study.decision == {"disposition": "approve", "reasons": []} with input as {
		"vendor": {
			"riskScore": 39,
			"requestedSpend": 500000,
			"sanctionsStatus": "CLEAR",
			"countryRisk": "LOW",
		},
		"evidence": financial_evidence,
	}
}

test_low_risk_mid_spend_with_insurance_approves if {
	study.decision == {"disposition": "approve", "reasons": []} with input as {
		"vendor": {
			"riskScore": 39,
			"requestedSpend": 2000000,
			"sanctionsStatus": "CLEAR",
			"countryRisk": "LOW",
		},
		"evidence": {
			"financial-evidence": "present",
			"insurance-certificate": "present",
		},
	}
}

test_low_risk_mid_spend_without_insurance_gets_enhanced_review if {
	study.decision == {
		"disposition": "enhanced-review",
		"reasons": [],
	} with input as {
		"vendor": {
			"riskScore": 20,
			"requestedSpend": 500000.01,
			"sanctionsStatus": "CLEAR",
			"countryRisk": "LOW",
		},
		"evidence": {
			"financial-evidence": "present",
			"insurance-certificate": "absent",
		},
	}
}

test_unreported_insurance_is_unknown_in_d6b if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["unknown"],
	} with input as {
		"vendor": {
			"riskScore": 20,
			"requestedSpend": 1000000,
			"sanctionsStatus": "CLEAR",
			"countryRisk": "LOW",
		},
		"evidence": financial_evidence,
	}
}

test_d6c_approves_existing_vendor if {
	study.decision == {"disposition": "approve", "reasons": []} with input as {

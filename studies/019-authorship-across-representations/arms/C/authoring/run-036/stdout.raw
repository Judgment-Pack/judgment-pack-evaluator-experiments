POLICY:
```rego
package study

default decision := {"disposition": "unresolved", "reasons": ["no-match"]}

decision := result if {
	result := decide
}

decide := {"disposition": "unresolved", "reasons": ["missing-required-evidence"]} if {
	object.get(object.get(input, "evidence", {}), "financial-evidence", "") == "absent"
} else := {"disposition": "unresolved", "reasons": ["unknown"]} if {
	object.get(object.get(input, "evidence", {}), "financial-evidence", "") == ""
} else := {"disposition": "reject", "reasons": []} if {
	object.get(object.get(input, "vendor", {}), "sanctionsStatus", "") == "MATCH"
} else := {"disposition": "unresolved", "reasons": ["no-match"]} if {
	object.get(object.get(input, "vendor", {}), "sanctionsStatus", "") == "UNKNOWN"
} else := resolved if {
	object.get(object.get(input, "vendor", {}), "sanctionsStatus", "") == "CLEAR"
	outcomes := possible_outcomes
	count(outcomes) == 1
	some resolved in outcomes
} else := {"disposition": "unresolved", "reasons": ["unknown"]} if {
	object.get(object.get(input, "vendor", {}), "sanctionsStatus", "") == "CLEAR"
	count(possible_outcomes) != 1
}

possible_outcomes := {
	outcome |
	some risk in possible_risks
	some spend in possible_spends
	some country in possible_countries
	outcome := readable_outcome(risk, spend, country)
}

possible_risks := {input.vendor.riskScore} if {
	"riskScore" in object.get(input, "vendor", {})
} else := {0, 39, 40, 69, 70, 89, 90}

possible_spends := {input.vendor.requestedSpend} if {
	"requestedSpend" in object.get(input, "vendor", {})
} else := {0, 100000, 100000.01, 500000, 500000.01, 2000000, 2000000.01}

possible_countries := {input.vendor.countryRisk} if {
	"countryRisk" in object.get(input, "vendor", {})
} else := {"LOW", "MEDIUM", "HIGH"}

readable_outcome(_, spend, "HIGH") := {
	"disposition": "unresolved",
	"reasons": ["exception-escalation"],
} if {
	spend > 2000000
} else := {"disposition": "review", "reasons": []} if {
	object.get(object.get(input, "vendor", {}), "criticalSupplier", "no") == "yes"
} else := {"disposition": "reject", "reasons": []} if {
	input.vendor.sanctionsStatus == "CLEAR"
	readable_rejection(risk, country)
} else := approval if {
	input.vendor.sanctionsStatus == "CLEAR"
	approval := readable_approval(risk, spend, country)
} else := {"disposition": "review", "reasons": []}

readable_rejection(risk, _) if {
	risk >= 90
}

readable_rejection(risk, "HIGH") if {
	risk >= 70
}

readable_rejection(_, _) if {
	object.get(object.get(input, "vendor", {}), "priorEnforcement", "no") == "yes"
}

readable_approval(risk, spend, "LOW") := {"disposition": "approve", "reasons": []} if {
	risk < 40
	spend <= 500000
}

readable_approval(risk, spend, "LOW") := result if {
	risk < 40
	spend > 500000
	spend <= 2000000
	result := d6b_outcome
}

readable_approval(risk, spend, "LOW") := {"disposition": "approve", "reasons": []} if {
	risk >= 40
	risk < 70
	spend <= 100000
	object.get(object.get(input, "vendor", {}), "newVendor", "no") != "yes"
}

readable_approval(risk, spend, "MEDIUM") := {"disposition": "approve", "reasons": []} if {
	risk < 40
	spend <= 100000
}

d6b_outcome := {"disposition": "approve", "reasons": []} if {
	object.get(object.get(input, "evidence", {}), "insurance-certificate", "") == "present"
} else := {"disposition": "enhanced-review", "reasons": []} if {
	object.get(object.get(input, "evidence", {}), "insurance-certificate", "") == "absent"
} else := {"disposition": "unresolved", "reasons": ["unknown"]}
```

TESTS:
```rego
package study_test

import data.study

financial_present := {"financial-evidence": "present"}

test_missing_financial_evidence_preempts_rejection if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["missing-required-evidence"],
	} with input as {
		"vendor": {
			"sanctionsStatus": "MATCH",
		},
		"evidence": {
			"financial-evidence": "absent",
		},
	}
}

test_unreported_financial_evidence_is_unknown if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["unknown"],
	} with input as {
		"vendor": {
			"sanctionsStatus": "MATCH",
		},
		"evidence": {},
	}
}

test_sanctions_match_rejects if {
	study.decision == {"disposition": "reject", "reasons": []} with input as {
		"vendor": {
			"sanctionsStatus": "MATCH",
		},
		"evidence": financial_present,
	}
}

test_unknown_sanctions_has_no_match if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["no-match"],
	} with input as {
		"vendor": {
			"sanctionsStatus": "UNKNOWN",
		},
		"evidence": financial_present,
	}
}

test_low_risk_low_spend_approves_at_boundary if {
	study.decision == {"disposition": "approve", "reasons": []} with input as {
		"vendor": {
			"riskScore": 39,
			"requestedSpend": 500000,
			"sanctionsStatus": "CLEAR",
			"countryRisk": "LOW",
		},
		"evidence": financial_present,
	}
}

test_d6b_with_insurance_approves_at_upper_boundary if {
	study.decision == {"disposition": "approve", "reasons": []} with input as {
		"vendor": {
			"riskScore": 39,
			"requestedSpend": 2000000,
			"sanctionsStatus": "CLEAR",
			"countryRisk": "LOW",
		},
		"evidence": {
			"financial-evidence": "present",
			"insurance-certificate": "present",
		},
	}
}

test_d6b_without_insurance_gets_enhanced_review if {
	study.decision == {
		"disposition": "enhanced-review",
		"reasons": [],
	} with input as {
		"vendor": {
			"riskScore": 20,
			"requestedSpend": 500000.01,
			"sanctionsStatus": "CLEAR",
			"countryRisk": "LOW",
		},
		"evidence": {
			"financial-evidence": "present",
			"insurance-certificate": "absent",
		},
	}
}

test_d6b_unreported_insurance_is_unknown if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["unknown"],
	} with input as {
		"vendor": {
			"riskScore": 20,
			"requestedSpend": 1000000,
			"sanctionsStatus": "CLEAR",
			"countryRisk": "LOW",
		},
		"evidence": financial_present,
	}
}

test_new_vendor_suspends_d6c if {
	study.decision == {"disposition": "review", "reasons": []} with input as {
		"vendor": {
			"riskScore": 40,
			"requestedSpend": 100000,
			"sanctionsStatus": "CLEAR",
			"countryRisk": "LOW",
			"newVendor": "yes",
		},
		"evidence": financial_present,
	}
}

test_unreported_new_vendor_is_treated_as_no if {
	study.decision == {"disposition": "approve", "reasons": []} with input as {
		"vendor": {
			"riskScore": 69,
			"requestedSpend": 100000,
			"sanctionsStatus": "CLEAR",
			"countryRisk": "LOW",
		},
		"evidence": financial_present,
	}
}

test_medium_country_approval_boundary if {
	study.decision == {"disposition": "approve", "reasons": []} with input as {
		"vendor": {
			"riskScore": 39,
			"requestedSpend": 100000,
			"sanctionsStatus": "CLEAR",
			"countryRisk": "MEDIUM",
		},
		"evidence": financial_present,
	}
}

test_high_country_rejects_at_risk_70 if {
	study.decision == {"disposition": "reject", "reasons": []} with input as {
		"vendor": {
			"riskScore": 70,
			"requestedSpend": 100,
			"sanctionsStatus": "CLEAR",
			"countryRisk": "HIGH",
		},
		"evidence": financial_present,
	}
}

test_prior_enforcement_rejects if {
	study.decision == {"disposition": "reject", "reasons": []} with input as {
		"vendor": {
			"riskScore": 1,
			"requestedSpend": 1,
			"sanctionsStatus": "CLEAR",
			"countryRisk": "LOW",
			"priorEnforcement": "yes",
		},
		"evidence": financial_present,
	}
}

test_critical_supplier_overrides_automatic_rejection if {
	study.decision == {"disposition": "review", "reasons": []} with input as {
		"vendor": {
			"riskScore": 95,
			"requestedSpend": 100,
			"sanctionsStatus": "CLEAR",
			"countryRisk": "LOW",
			"criticalSupplier": "yes",
		},
		"evidence": financial_present,
	}
}

test_o3_overrides_critical_supplier_and_rejection if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["exception-escalation"],
	} with input as {
		"vendor": {
			"riskScore": 95,
			"requestedSpend": 2000000.01,
			"sanctionsStatus": "CLEAR",
			"countryRisk": "HIGH",
			"criticalSupplier": "yes",
			"priorEnforcement": "yes",
		},
		"evidence": financial_present,
	}
}

test_unreadable_country_still_rejects_when_risk_is_95 if {
	study.decision == {"disposition": "reject", "reasons": []} with input as {
		"vendor": {
			"riskScore": 95,
			"requestedSpend": 1000000,
			"sanctionsStatus": "CLEAR",
		},
		"evidence": financial_present,
	}
}

test_unreadable_spend_in_high_country_can_change_to_escalation if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["unknown"],
	} with input as {
		"vendor": {
			"riskScore": 50,
			"sanctionsStatus": "CLEAR",
			"countryRisk": "HIGH",
		},
		"evidence": financial_present,
	}
}

test_critical_supplier_with_unreadable_risk_is_review if {
	study.decision == {"disposition": "review", "reasons": []} with input as {
		"vendor": {
			"requestedSpend": 100,
			"sanctionsStatus": "CLEAR",
			"countryRisk": "LOW",
			"criticalSupplier": "yes",
		},
		"evidence": financial_present,
	}
}

test_critical_supplier_with_unreadable_country_and_spend_is_unknown if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["unknown"],
	} with input as {
		"vendor": {
			"riskScore": 10,
			"sanctionsStatus": "CLEAR",
			"criticalSupplier": "yes",
		},
		"evidence": financial_present,
	}
}

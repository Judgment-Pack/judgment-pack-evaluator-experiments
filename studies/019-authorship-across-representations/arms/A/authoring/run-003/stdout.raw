PACK:
```json
{
  "specVersion": "0.2.0-draft",
  "id": "https://example.org/judgment-packs/vendor-approval-policy",
  "version": "1.0.0",
  "title": "Vendor Approval Policy",
  "description": "Determines vendor onboarding spend requests under the stated sanctions, risk, evidence, supplier, enforcement, and exposure policy.",
  "decision": {
    "intent": "Determine whether a vendor onboarding spend request is approved, reviewed, enhanced-reviewed, rejected, or left unresolved.",
    "question": "What determination applies to this vendor onboarding spend request?"
  },
  "evidenceRequirements": [
    {
      "id": "financial-evidence",
      "description": "Audited financial statements must be available before any determination is issued.",
      "required": true,
      "kind": "document"
    },
    {
      "id": "insurance-certificate",
      "description": "Insurance certificate consulted only for qualifying D6b requests.",
      "required": false,
      "kind": "document"
    }
  ],
  "outcomes": [
    {
      "id": "approve",
      "label": "Approve"
    },
    {
      "id": "review",
      "label": "Review"
    },
    {
      "id": "enhanced-review",
      "label": "Enhanced review"
    },
    {
      "id": "reject",
      "label": "Reject"
    }
  ],
  "rules": [
    {
      "id": "d-one-sanctions-match",
      "description": "D1: A sanctions match rejects the request.",
      "when": {
        "op": "fact",
        "path": "/vendor/sanctionsStatus",
        "operator": "equals",
        "value": "MATCH"
      },
      "outcome": "reject",
      "onUnknown": "ignore",
      "evidenceRequirementRefs": [
        "financial-evidence"
      ]
    },
    {
      "id": "d-three-critical-risk",
      "description": "D3: Under CLEAR screening, risk at least 90 rejects.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "fact",
            "path": "/vendor/riskScore",
            "operator": "greater-than-or-equal",
            "value": "90"
          }
        ]
      },
      "outcome": "reject",
      "onUnknown": "ignore",
      "evidenceRequirementRefs": [
        "financial-evidence"
      ]
    },
    {
      "id": "d-four-high-country-risk",
      "description": "D4: Under CLEAR screening, HIGH country risk and risk at least 70 reject.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "fact",
            "path": "/vendor/countryRisk",
            "operator": "equals",
            "value": "HIGH"
          },
          {
            "op": "fact",
            "path": "/vendor/riskScore",
            "operator": "greater-than-or-equal",
            "value": "70"
          }
        ]
      },
      "outcome": "reject",
      "onUnknown": "ignore",
      "evidenceRequirementRefs": [
        "financial-evidence"
      ]
    },
    {
      "id": "d-five-prior-enforcement",
      "description": "D5: Under CLEAR screening, a recorded prior enforcement action rejects.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "fact",
            "path": "/vendor/priorEnforcement",
            "operator": "equals",
            "value": "yes"
          }
        ]
      },
      "outcome": "reject",
      "onUnknown": "ignore",
      "evidenceRequirementRefs": [
        "financial-evidence"
      ]
    },
    {
      "id": "d-six-a-low-basic-approval",
      "description": "D6a: LOW country risk, risk below 40, and spend no more than 500000 approve.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "fact",
            "path": "/vendor/countryRisk",
            "operator": "equals",
            "value": "LOW"
          },
          {
            "op": "fact",
            "path": "/vendor/riskScore",
            "operator": "less-than",
            "value": "40"
          },
          {
            "op": "fact",
            "path": "/vendor/requestedSpend",
            "operator": "less-than-or-equal",
            "value": "500000.00"
          }
        ]
      },
      "outcome": "approve",
      "onUnknown": "ignore",
      "evidenceRequirementRefs": [
        "financial-evidence"
      ]
    },
    {
      "id": "d-six-b-insured-approval",
      "description": "D6b: A qualifying LOW-country request above 500000 through 2000000 approves when insurance is present.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "fact",
            "path": "/vendor/countryRisk",
            "operator": "equals",
            "value": "LOW"
          },
          {
            "op": "fact",
            "path": "/vendor/riskScore",
            "operator": "less-than",
            "value": "40"
          },
          {
            "op": "fact",
            "path": "/vendor/requestedSpend",
            "operator": "greater-than",
            "value": "500000.00"
          },
          {
            "op": "fact",
            "path": "/vendor/requestedSpend",
            "operator": "less-than-or-equal",
            "value": "2000000.00"
          },
          {
            "op": "evidence-present",
            "evidenceRequirement": "insurance-certificate"
          }
        ]
      },
      "outcome": "approve",
      "onUnknown": "escalate",
      "evidenceRequirementRefs": [
        "financial-evidence",
        "insurance-certificate"
      ]
    },
    {
      "id": "d-six-b-uninsured-enhanced",
      "description": "D6b: A qualifying LOW-country request receives enhanced review when insurance is absent.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "fact",
            "path": "/vendor/countryRisk",
            "operator": "equals",
            "value": "LOW"
          },
          {
            "op": "fact",
            "path": "/vendor/riskScore",
            "operator": "less-than",
            "value": "40"
          },
          {
            "op": "fact",
            "path": "/vendor/requestedSpend",
            "operator": "greater-than",
            "value": "500000.00"
          },
          {
            "op": "fact",
            "path": "/vendor/requestedSpend",
            "operator": "less-than-or-equal",
            "value": "2000000.00"
          },
          {
            "op": "not",
            "condition": {
              "op": "evidence-present",
              "evidenceRequirement": "insurance-certificate"
            }
          }
        ]
      },
      "outcome": "enhanced-review",
      "onUnknown": "escalate",
      "evidenceRequirementRefs": [
        "financial-evidence",
        "insurance-certificate"
      ]
    },
    {
      "id": "d-six-c-moderate-low-approval",
      "description": "D6c: LOW country risk, risk from 40 through below 70, and spend no more than 100000 approve unless O1 applies.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "fact",
            "path": "/vendor/countryRisk",
            "operator": "equals",
            "value": "LOW"
          },
          {
            "op": "fact",
            "path": "/vendor/riskScore",
            "operator": "greater-than-or-equal",
            "value": "40"
          },
          {
            "op": "fact",
            "path": "/vendor/riskScore",
            "operator": "less-than",
            "value": "70"
          },
          {
            "op": "fact",
            "path": "/vendor/requestedSpend",
            "operator": "less-than-or-equal",
            "value": "100000.00"
          }
        ]
      },
      "outcome": "approve",
      "onUnknown": "ignore",
      "evidenceRequirementRefs": [
        "financial-evidence"
      ]
    },
    {
      "id": "d-seven-medium-approval",
      "description": "D7: MEDIUM country risk, risk below 40, and spend no more than 100000 approve.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "fact",
            "path": "/vendor/countryRisk",
            "operator": "equals",
            "value": "MEDIUM"
          },
          {
            "op": "fact",
            "path": "/vendor/riskScore",
            "operator": "less-than",
            "value": "40"
          },
          {
            "op": "fact",
            "path": "/vendor/requestedSpend",
            "operator": "less-than-or-equal",
            "value": "100000.00"
          }
        ]
      },
      "outcome": "approve",
      "onUnknown": "ignore",
      "evidenceRequirementRefs": [
        "financial-evidence"
      ]
    },
    {
      "id": "d-eight-review",
      "description": "D8: Every otherwise undetermined CLEAR-screened request is reviewed.",
      "when": {
        "op": "fact",
        "path": "/vendor/sanctionsStatus",
        "operator": "equals",
        "value": "CLEAR"
      },
      "outcome": "review",
      "onUnknown": "ignore",
      "evidenceRequirementRefs": [
        "financial-evidence"
      ]
    }
  ],
  "exceptions": [
    {
      "id": "o-three-large-high-exposure",
      "description": "O3: A CLEAR request in a HIGH-risk country above 2000000 is escalated for human determination.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "fact",
            "path": "/vendor/countryRisk",
            "operator": "equals",
            "value": "HIGH"
          },
          {
            "op": "fact",
            "path": "/vendor/requestedSpend",
            "operator": "greater-than",
            "value": "2000000.00"
          }
        ]
      },
      "effect": "escalate",
      "onUnknown": "escalate"
    },
    {
      "id": "o-two-critical-supplier",
      "description": "O2: A critical supplier with CLEAR screening is forced to review.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",

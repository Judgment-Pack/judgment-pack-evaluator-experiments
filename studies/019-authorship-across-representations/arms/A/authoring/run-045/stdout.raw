          },
          {
            "op": "fact",
            "path": "/vendor/criticalSupplier",
            "operator": "equals",
            "value": "yes"
          }
        ]
      },
      "effect": "suppress-rule",
      "targetRule": "d1-sanctions-match",
      "onUnknown": "ignore"
    },

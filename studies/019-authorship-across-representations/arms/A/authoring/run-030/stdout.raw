PACK:
```json
{
  "specVersion": "0.2.0-draft",
  "id": "https://example.org/judgment-packs/vendor-approval-policy",
  "version": "1.0.0",
  "title": "Vendor Approval Policy",
  "description": "Determines vendor onboarding spend requests under the supplied approval, review, escalation, rejection, evidence, and unreadable-input rules.",
  "decision": {
    "intent": "Determine the disposition of a vendor onboarding spend request.",
    "question": "Should the request be approved, reviewed, enhanced-reviewed, rejected, or left unresolved?"
  },
  "evidenceRequirements": [
    {
      "id": "financial-evidence",
      "description": "Audited financial statements must be available before any determination may be issued.",
      "required": true,
      "kind": "document"
    },
    {
      "id": "insurance-certificate",
      "description": "Insurance certificate availability, consulted only for qualifying low-risk-country requests.",
      "required": false,
      "kind": "document"
    }
  ],
  "outcomes": [
    {
      "id": "approve",
      "label": "Approve"
    },
    {
      "id": "review",
      "label": "Review"
    },
    {
      "id": "enhanced-review",
      "label": "Enhanced review"
    },
    {
      "id": "reject",
      "label": "Reject"
    }
  ],
  "rules": [
    {
      "id": "d1-sanctions-match",
      "description": "Reject a sanctions MATCH.",
      "when": {
        "op": "fact",
        "path": "/vendor/sanctionsStatus",
        "operator": "equals",
        "value": "MATCH"
      },
      "outcome": "reject",
      "onUnknown": "ignore",
      "evidenceRequirementRefs": [
        "financial-evidence"
      ]
    },
    {
      "id": "d3-critical-risk",
      "description": "For CLEAR screening, reject risk scores of 90 or above.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "fact",
            "path": "/vendor/riskScore",
            "operator": "greater-than-or-equal",
            "value": "90"
          }
        ]
      },
      "outcome": "reject",
      "onUnknown": "escalate",
      "evidenceRequirementRefs": [
        "financial-evidence"
      ]
    },
    {
      "id": "d4-high-country-elevated-risk",
      "description": "For CLEAR screening and HIGH country risk, reject risk scores from 70 through 89.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "fact",
            "path": "/vendor/countryRisk",
            "operator": "equals",
            "value": "HIGH"
          },
          {
            "op": "fact",
            "path": "/vendor/riskScore",
            "operator": "greater-than-or-equal",
            "value": "70"
          },
          {
            "op": "fact",
            "path": "/vendor/riskScore",
            "operator": "less-than",
            "value": "90"
          }
        ]
      },
      "outcome": "reject",
      "onUnknown": "escalate",
      "evidenceRequirementRefs": [
        "financial-evidence"
      ]
    },
    {
      "id": "d5-prior-enforcement",
      "description": "For CLEAR screening, reject a recorded prior enforcement action.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "fact",
            "path": "/vendor/priorEnforcement",
            "operator": "equals",
            "value": "yes"
          }
        ]
      },
      "outcome": "reject",
      "onUnknown": "ignore",
      "evidenceRequirementRefs": [
        "financial-evidence"
      ]
    },
    {
      "id": "d6a-low-basic-approval",
      "description": "Approve LOW-country requests below risk 40 with spend at most 500000.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "fact",
            "path": "/vendor/countryRisk",
            "operator": "equals",
            "value": "LOW"
          },
          {
            "op": "fact",
            "path": "/vendor/riskScore",
            "operator": "less-than",
            "value": "40"
          },
          {
            "op": "fact",
            "path": "/vendor/requestedSpend",
            "operator": "less-than-or-equal",
            "value": "500000.00"
          }
        ]
      },
      "outcome": "approve",
      "onUnknown": "escalate",
      "evidenceRequirementRefs": [
        "financial-evidence"
      ]
    },
    {
      "id": "d6b-low-insured-approval",
      "description": "Approve qualifying LOW-country spend above 500000 through 2000000 when insurance is available.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "fact",
            "path": "/vendor/countryRisk",
            "operator": "equals",
            "value": "LOW"
          },
          {
            "op": "fact",
            "path": "/vendor/riskScore",
            "operator": "less-than",
            "value": "40"
          },
          {
            "op": "fact",
            "path": "/vendor/requestedSpend",
            "operator": "greater-than",
            "value": "500000.00"
          },
          {
            "op": "fact",
            "path": "/vendor/requestedSpend",
            "operator": "less-than-or-equal",
            "value": "2000000.00"
          },
          {
            "op": "evidence-present",
            "evidenceRequirement": "insurance-certificate"
          }
        ]
      },
      "outcome": "approve",
      "onUnknown": "escalate",
      "evidenceRequirementRefs": [
        "financial-evidence",
        "insurance-certificate"
      ]
    },
    {
      "id": "d6b-low-uninsured-enhanced-review",
      "description": "Send qualifying LOW-country spend above 500000 through 2000000 to enhanced review when insurance is absent.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "fact",
            "path": "/vendor/countryRisk",
            "operator": "equals",
            "value": "LOW"
          },
          {
            "op": "fact",
            "path": "/vendor/riskScore",
            "operator": "less-than",
            "value": "40"
          },
          {
            "op": "fact",
            "path": "/vendor/requestedSpend",
            "operator": "greater-than",
            "value": "500000.00"
          },
          {
            "op": "fact",
            "path": "/vendor/requestedSpend",
            "operator": "less-than-or-equal",
            "value": "2000000.00"
          },
          {
            "op": "not",
            "condition": {
              "op": "evidence-present",
              "evidenceRequirement": "insurance-certificate"
            }
          }
        ]
      },
      "outcome": "enhanced-review",
      "onUnknown": "ignore",
      "evidenceRequirementRefs": [
        "financial-evidence",
        "insurance-certificate"
      ]
    },
    {

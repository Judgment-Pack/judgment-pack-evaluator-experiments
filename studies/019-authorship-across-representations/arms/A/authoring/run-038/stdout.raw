  ],
  "exceptions": [
    {
      "id": "large-high-country-escalation",
      "description": "O3: directly escalate clear-screened high-country-risk requests above 2000000.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "fact",
            "path": "/vendor/countryRisk",
            "operator": "equals",
            "value": "HIGH"
          },
          {
            "op": "fact",
            "path": "/vendor/requestedSpend",
            "operator": "greater-than",
            "value": "2000000.00"
          }
        ]
      },
      "effect": "escalate",
      "onUnknown": "escalate"
    },
    {
      "id": "critical-supplier-review",
      "description": "O2: force review for a reported critical supplier with clear sanctions screening.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "fact",
            "path": "/vendor/criticalSupplier",
            "operator": "equals",
            "value": "yes"
          }
        ]
      },
      "effect": "force-outcome",
      "outcome": "review",
      "onUnknown": "ignore"
    },
    {
      "id": "new-vendor-suspension",
      "description": "O1: suppress D6c for a reported new vendor.",
      "when": {
        "op": "fact",
        "path": "/vendor/newVendor",
        "operator": "equals",
        "value": "yes"
      },
      "effect": "suppress-rule",
      "targetRule": "low-mid-risk-approval",
      "onUnknown": "ignore"
    },
    {
      "id": "prior-action-suppress-low-basic",
      "description": "D5 precedence: suppress D6a when prior enforcement is reported.",
      "when": {
        "op": "fact",
        "path": "/vendor/priorEnforcement",
        "operator": "equals",
        "value": "yes"
      },
      "effect": "suppress-rule",
      "targetRule": "low-basic-approval",
      "onUnknown": "ignore"
    },
    {
      "id": "prior-action-suppress-low-insured",
      "description": "D5 precedence: suppress the D6b approval limb when prior enforcement is reported.",
      "when": {
        "op": "fact",
        "path": "/vendor/priorEnforcement",
        "operator": "equals",
        "value": "yes"
      },
      "effect": "suppress-rule",
      "targetRule": "low-insured-approval",
      "onUnknown": "ignore"
    },
    {
      "id": "prior-action-suppress-low-mid",
      "description": "D5 precedence: suppress D6c when prior enforcement is reported.",
      "when": {
        "op": "fact",
        "path": "/vendor/priorEnforcement",
        "operator": "equals",
        "value": "yes"
      },
      "effect": "suppress-rule",
      "targetRule": "low-mid-risk-approval",
      "onUnknown": "ignore"
    },
    {
      "id": "prior-action-suppress-medium",
      "description": "D5 precedence: suppress D7 when prior enforcement is reported.",
      "when": {
        "op": "fact",
        "path": "/vendor/priorEnforcement",
        "operator": "equals",
        "value": "yes"
      },
      "effect": "suppress-rule",
      "targetRule": "medium-basic-approval",
      "onUnknown": "ignore"
    },
    {
      "id": "prior-action-suppress-enhanced",
      "description": "D5 precedence: suppress D6b enhanced review when prior enforcement is reported.",
      "when": {
        "op": "fact",
        "path": "/vendor/priorEnforcement",
        "operator": "equals",
        "value": "yes"
      },
      "effect": "suppress-rule",
      "targetRule": "low-uninsured-enhanced-review",
      "onUnknown": "ignore"
    },
    {
      "id": "prior-action-suppress-residual",
      "description": "D5 precedence: suppress D8 when prior enforcement is reported.",
      "when": {
        "op": "fact",
        "path": "/vendor/priorEnforcement",
        "operator": "equals",
        "value": "yes"
      },
      "effect": "suppress-rule",
      "targetRule": "residual-review",
      "onUnknown": "ignore"
    }
  ],
  "escalation": {
    "triggers": [
      "missing-required-evidence",
      "no-match",
      "unknown"
    ],
    "target": {
      "kind": "queue",
      "name": "vendor-compliance-desk"
    }
  }
}

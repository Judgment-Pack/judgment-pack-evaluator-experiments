      "id": "o3-large-high-risk-exposure",
      "description": "Escalate a CLEAR request in a HIGH-risk country with spend above 2000000.00.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",

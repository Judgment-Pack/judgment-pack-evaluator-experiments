    {
      "id": "o1-new-vendor-suspension",
      "description": "Suppress D6c for a new vendor.",
      "when": {
        "op": "fact",
        "path": "/vendor/newVendor",
        "operator": "equals",
        "value": "yes"
      },
      "effect": "suppress-rule",
      "targetRule": "d6c-low-country-moderate-risk",
      "onUnknown": "ignore"
    }
  ],
  "escalation": {

          },
          {
            "op": "fact",
            "path": "/vendor/requestedSpend",
            "operator": "less-than-or-equal",
            "value": "100000.00"
          }
        ]
      },
      "outcome": "approve",
      "onUnknown": "ignore",
      "evidenceRequirementRefs": [
        "financial-evidence"
      ]
    },
    {
      "id": "d7-medium-country-approval",
      "description": "Approve a MEDIUM-country-risk request below risk 40 with spend up to 100000.00.",
      "when": {

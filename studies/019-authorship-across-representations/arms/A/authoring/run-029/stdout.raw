{
  "matrixVersion": "2",
  "cases": [
    {
      "id": "p1-financial-evidence-absent",
      "facts": {
        "vendor": {
          "riskScore": "20",
          "requestedSpend": "1000.00",
          "sanctionsStatus": "CLEAR",
          "countryRisk": "LOW",
          "newVendor": "no",

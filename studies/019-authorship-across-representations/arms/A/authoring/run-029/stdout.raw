PACK:
```json
{
  "specVersion": "0.2.0-draft",
  "id": "https://example.org/judgment-packs/vendor-approval-policy",
  "version": "1.0.0",
  "title": "Vendor Approval Policy",
  "description": "Determines vendor onboarding spend requests under the stated sanctions, risk, evidence, supplier, enforcement, insurance, and first-engagement rules.",
  "decision": {
    "intent": "Determine whether a vendor onboarding spend request is approved, reviewed, enhanced-reviewed, rejected, or left unresolved.",
    "question": "What determination applies to this vendor onboarding spend request?"
  },
  "evidenceRequirements": [
    {
      "id": "financial-evidence",
      "description": "Audited financial statements must be available before any determination can be issued.",
      "required": true,
      "kind": "document"
    },
    {
      "id": "insurance-certificate",
      "description": "Insurance certificate consulted only for qualifying LOW-country requests above 500000.00 and up to 2000000.00.",
      "required": false,
      "kind": "document"
    }
  ],
  "outcomes": [
    {
      "id": "approve",
      "label": "Approve"
    },
    {
      "id": "review",
      "label": "Review"
    },
    {
      "id": "enhanced-review",
      "label": "Enhanced review"
    },
    {
      "id": "reject",
      "label": "Reject"
    }
  ],
  "rules": [
    {
      "id": "d1-sanctions-match",
      "description": "Reject a sanctions MATCH.",
      "when": {
        "op": "fact",
        "path": "/vendor/sanctionsStatus",
        "operator": "equals",
        "value": "MATCH"
      },
      "outcome": "reject",
      "onUnknown": "ignore",
      "evidenceRequirementRefs": [
        "financial-evidence"
      ]
    },
    {
      "id": "d3-critical-risk",
      "description": "With CLEAR screening, reject a risk score of 90 or above.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "fact",
            "path": "/vendor/riskScore",
            "operator": "greater-than-or-equal",
            "value": "90"
          }
        ]
      },
      "outcome": "reject",
      "onUnknown": "escalate",
      "evidenceRequirementRefs": [
        "financial-evidence"
      ]
    },
    {
      "id": "d4-high-country-elevated-risk",
      "description": "With CLEAR screening and HIGH country risk, reject a risk score of 70 or above.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "fact",
            "path": "/vendor/countryRisk",
            "operator": "equals",
            "value": "HIGH"
          },
          {
            "op": "fact",
            "path": "/vendor/riskScore",
            "operator": "greater-than-or-equal",
            "value": "70"
          }
        ]
      },
      "outcome": "reject",
      "onUnknown": "escalate",
      "evidenceRequirementRefs": [
        "financial-evidence"
      ]
    },
    {
      "id": "d5-prior-enforcement",
      "description": "With CLEAR screening, reject a recorded prior enforcement action.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "fact",
            "path": "/vendor/priorEnforcement",
            "operator": "equals",
            "value": "yes"
          }
        ]
      },
      "outcome": "reject",
      "onUnknown": "ignore",
      "evidenceRequirementRefs": [
        "financial-evidence"
      ]
    },
    {
      "id": "d6a-low-small-approval",
      "description": "Approve a qualifying LOW-country request with risk below 40 and spend up to 500000.00.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "fact",
            "path": "/vendor/countryRisk",
            "operator": "equals",
            "value": "LOW"
          },
          {
            "op": "fact",
            "path": "/vendor/riskScore",
            "operator": "less-than",
            "value": "40"
          },
          {
            "op": "fact",
            "path": "/vendor/requestedSpend",
            "operator": "less-than-or-equal",
            "value": "500000.00"
          },
          {
            "op": "not",
            "condition": {
              "op": "fact",
              "path": "/vendor/priorEnforcement",
              "operator": "equals",
              "value": "yes"
            }
          }
        ]
      },
      "outcome": "approve",
      "onUnknown": "ignore",
      "evidenceRequirementRefs": [
        "financial-evidence"
      ]
    },
    {
      "id": "d6b-low-insured-approval",
      "description": "Approve a qualifying LOW-country request above 500000.00 and up to 2000000.00 when insurance is available.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "fact",
            "path": "/vendor/countryRisk",
            "operator": "equals",
            "value": "LOW"
          },
          {
            "op": "fact",
            "path": "/vendor/riskScore",
            "operator": "less-than",
            "value": "40"
          },
          {
            "op": "fact",
            "path": "/vendor/requestedSpend",
            "operator": "greater-than",
            "value": "500000.00"
          },
          {
            "op": "fact",
            "path": "/vendor/requestedSpend",
            "operator": "less-than-or-equal",
            "value": "2000000.00"
          },
          {
            "op": "evidence-present",
            "evidenceRequirement": "insurance-certificate"
          },
          {
            "op": "not",
            "condition": {
              "op": "fact",
              "path": "/vendor/priorEnforcement",
              "operator": "equals",
              "value": "yes"
            }
          }
        ]
      },
      "outcome": "approve",
      "onUnknown": "escalate",
      "evidenceRequirementRefs": [
        "financial-evidence",
        "insurance-certificate"
      ]
    },
    {
      "id": "d6b-low-uninsured-enhanced-review",
      "description": "Send a qualifying LOW-country request above 500000.00 and up to 2000000.00 to enhanced review when insurance is absent.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "fact",
            "path": "/vendor/countryRisk",
            "operator": "equals",
            "value": "LOW"
          },
          {
            "op": "fact",
            "path": "/vendor/riskScore",
            "operator": "less-than",
            "value": "40"
          },
          {
            "op": "fact",
            "path": "/vendor/requestedSpend",
            "operator": "greater-than",
            "value": "500000.00"
          },
          {
            "op": "fact",
            "path": "/vendor/requestedSpend",
            "operator": "less-than-or-equal",
            "value": "2000000.00"
          },
          {
            "op": "not",
            "condition": {
              "op": "evidence-present",
              "evidenceRequirement": "insurance-certificate"
            }
          },
          {
            "op": "not",
            "condition": {
              "op": "fact",
              "path": "/vendor/priorEnforcement",
              "operator": "equals",
              "value": "yes"
            }
          }
        ]
      },
      "outcome": "enhanced-review",
      "onUnknown": "escalate",
      "evidenceRequirementRefs": [
        "financial-evidence",
        "insurance-certificate"
      ]
    },
    {
      "id": "d6c-low-moderate-risk-approval",
      "description": "Approve a non-new qualifying LOW-country request with risk from 40 through 69 and spend up to 100000.00.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "fact",
            "path": "/vendor/countryRisk",
            "operator": "equals",
            "value": "LOW"
          },
          {
            "op": "fact",
            "path": "/vendor/riskScore",
            "operator": "greater-than-or-equal",
            "value": "40"
          },
          {
            "op": "fact",
            "path": "/vendor/riskScore",
            "operator": "less-than",
            "value": "70"
          },
          {
            "op": "fact",
            "path": "/vendor/requestedSpend",
            "operator": "less-than-or-equal",
            "value": "100000.00"
          },
          {
            "op": "not",
            "condition": {
              "op": "fact",
              "path": "/vendor/newVendor",
              "operator": "equals",
              "value": "yes"
            }
          },
          {
            "op": "not",
            "condition": {
              "op": "fact",
              "path": "/vendor/priorEnforcement",
              "operator": "equals",
              "value": "yes"
            }
          }
        ]
      },
      "outcome": "approve",
      "onUnknown": "ignore",
      "evidenceRequirementRefs": [
        "financial-evidence"
      ]
    },
    {
      "id": "d7-medium-small-approval",
      "description": "Approve a qualifying MEDIUM-country request with risk below 40 and spend up to 100000.00.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "fact",
            "path": "/vendor/countryRisk",
            "operator": "equals",
            "value": "MEDIUM"
          },
          {
            "op": "fact",
            "path": "/vendor/riskScore",
            "operator": "less-than",
            "value": "40"
          },
          {
            "op": "fact",
            "path": "/vendor/requestedSpend",

            "condition": {
              "op": "fact",
              "path": "/vendor/criticalSupplier",
              "operator": "equals",
              "value": "yes"
            }
          }
        ]
      },
      "outcome": "review",
      "onUnknown": "escalate"
    },
    {
      "id": "u1-unreadable-spend",
      "description": "Escalate unreadable spend unless rejection or critical-supplier review is independently fixed.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "not",
            "condition": {
              "op": "fact",

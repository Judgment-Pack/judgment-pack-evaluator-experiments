        "financial-evidence"
      ]
    },
    {
      "id": "d7-medium-basic-approval",
      "description": "Approve a CLEAR MEDIUM-country request below risk 40 with spend up to 100000.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "fact",
            "path": "/vendor/countryRisk",
            "operator": "equals",

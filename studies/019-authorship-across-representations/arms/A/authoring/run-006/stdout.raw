    }
  ],
  "exceptions": [
    {
      "id": "o3-large-high-risk-exposure",
      "description": "Escalate a CLEAR HIGH-country request above 2000000 for human determination.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "fact",
            "path": "/vendor/countryRisk",
            "operator": "equals",
            "value": "HIGH"
          },
          {
            "op": "fact",
            "path": "/vendor/requestedSpend",
            "operator": "greater-than",
            "value": "2000000.00"
          }
        ]
      },
      "effect": "escalate",
      "onUnknown": "escalate"
    },
    {
      "id": "o2-critical-supplier",
      "description": "Force review for a critical supplier with CLEAR screening.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "fact",
            "path": "/vendor/criticalSupplier",
            "operator": "equals",
            "value": "yes"
          }
        ]
      },
      "effect": "force-outcome",
      "outcome": "review",
      "onUnknown": "ignore"
    },
    {
      "id": "o1-new-vendor-suspends-d6c",
      "description": "Suppress D6c for a new vendor.",
      "when": {
        "op": "fact",
        "path": "/vendor/newVendor",
        "operator": "equals",
        "value": "yes"
      },
      "effect": "suppress-rule",
      "targetRule": "d6c-low-moderate-risk-approval",
      "onUnknown": "ignore"
    },
    {
      "id": "d5-suppress-d6a",
      "description": "Prior enforcement prevents D6a approval.",
      "when": {
        "op": "fact",
        "path": "/vendor/priorEnforcement",
        "operator": "equals",
        "value": "yes"
      },
      "effect": "suppress-rule",
      "targetRule": "d6a-low-basic-approval",
      "onUnknown": "ignore"
    },
    {
      "id": "d5-suppress-d6b-approved",
      "description": "Prior enforcement prevents insured D6b approval.",
      "when": {
        "op": "fact",
        "path": "/vendor/priorEnforcement",
        "operator": "equals",
        "value": "yes"
      },
      "effect": "suppress-rule",
      "targetRule": "d6b-insured-approval",
      "onUnknown": "ignore"
    },
    {
      "id": "d5-suppress-d6b-enhanced",
      "description": "Prior enforcement prevents the D6b enhanced-review result.",
      "when": {
        "op": "fact",
        "path": "/vendor/priorEnforcement",
        "operator": "equals",
        "value": "yes"
      },
      "effect": "suppress-rule",
      "targetRule": "d6b-uninsured-enhanced-review",
      "onUnknown": "ignore"
    },
    {
      "id": "d5-suppress-d6c",
      "description": "Prior enforcement prevents D6c approval.",
      "when": {
        "op": "fact",
        "path": "/vendor/priorEnforcement",
        "operator": "equals",
        "value": "yes"
      },
      "effect": "suppress-rule",
      "targetRule": "d6c-low-moderate-risk-approval",
      "onUnknown": "ignore"
    },
    {
      "id": "d5-suppress-d7",
      "description": "Prior enforcement prevents D7 approval.",
      "when": {
        "op": "fact",
        "path": "/vendor/priorEnforcement",
        "operator": "equals",
        "value": "yes"
      },
      "effect": "suppress-rule",
      "targetRule": "d7-medium-basic-approval",
      "onUnknown": "ignore"
    },
    {
      "id": "d5-suppress-d8",
      "description": "Prior enforcement prevents ordinary D8 review.",
      "when": {
        "op": "fact",
        "path": "/vendor/priorEnforcement",
        "operator": "equals",
        "value": "yes"
      },
      "effect": "suppress-rule",
      "targetRule": "d8-review",
      "onUnknown": "ignore"
    }
  ],
  "escalation": {
    "triggers": [
      "missing-required-evidence",
      "no-match",
      "unknown"
    ],
    "target": {
      "kind": "queue",
      "name": "vendor-compliance-desk"
    }
  }
}

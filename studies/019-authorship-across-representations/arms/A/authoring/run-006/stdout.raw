    {
      "id": "u1-unreadable-risk",
      "description": "Escalate an unreadable risk score unless another readable fact independently fixes rejection or critical-supplier review.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "not",
            "condition": {
              "op": "fact",
              "path": "/vendor/riskScore",
              "operator": "greater-than-or-equal",
              "value": "0"
            }
          },
          {
            "op": "not",
            "condition": {
              "op": "fact",

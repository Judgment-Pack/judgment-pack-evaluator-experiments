            "value": "500000.00"
          }
        ]
      },
      "effect": "suppress-rule",
      "targetRule": "d8-review",
      "onUnknown": "ignore"
    },
    {
      "id": "d6b-suppress-d8",
      "description": "D6b decides its complete spend band, including unknown insurance.",
      "when": {

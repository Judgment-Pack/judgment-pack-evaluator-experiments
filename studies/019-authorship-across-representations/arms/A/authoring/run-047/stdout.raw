PACK:
```json
{
  "specVersion": "0.2.0-draft",
  "id": "https://example.org/judgment-packs/vendor-approval-policy",
  "version": "1.0.0",
  "title": "Vendor Approval Policy",
  "description": "Determines vendor onboarding spend requests under the stated financial-evidence, sanctions, risk, supplier, enforcement, insurance, and escalation rules.",
  "decision": {
    "intent": "Determine the disposition of a vendor onboarding spend request.",
    "question": "Should this vendor spend request be approved, reviewed, enhanced-reviewed, rejected, or left unresolved?"
  },
  "evidenceRequirements": [
    {
      "id": "financial-evidence",
      "description": "Audited financial statements must be available before any determination.",
      "required": true,
      "kind": "document"
    },
    {
      "id": "insurance-certificate",
      "description": "Insurance certificate consulted only for qualifying D6b requests.",
      "required": false,
      "kind": "document"
    }
  ],
  "outcomes": [
    {
      "id": "approve",
      "label": "Approve"
    },
    {
      "id": "review",
      "label": "Review"
    },
    {
      "id": "enhanced-review",
      "label": "Enhanced review"
    },
    {
      "id": "reject",
      "label": "Reject"
    }
  ],
  "rules": [
    {
      "id": "d1-sanctions-match",
      "description": "Reject a sanctions match.",
      "when": {
        "op": "fact",
        "path": "/vendor/sanctionsStatus",
        "operator": "equals",
        "value": "MATCH"
      },
      "outcome": "reject",
      "onUnknown": "ignore",
      "evidenceRequirementRefs": ["financial-evidence"]
    },
    {
      "id": "d3-critical-risk",
      "description": "Reject a CLEAR request with risk score at least 90.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "fact",
            "path": "/vendor/riskScore",
            "operator": "greater-than-or-equal",
            "value": "90"
          }
        ]
      },
      "outcome": "reject",
      "onUnknown": "ignore",
      "evidenceRequirementRefs": ["financial-evidence"]
    },
    {
      "id": "d4-high-country-elevated-risk",
      "description": "Reject a CLEAR HIGH-country request with risk score at least 70.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "fact",
            "path": "/vendor/countryRisk",
            "operator": "equals",
            "value": "HIGH"
          },
          {
            "op": "fact",
            "path": "/vendor/riskScore",
            "operator": "greater-than-or-equal",
            "value": "70"
          }
        ]
      },
      "outcome": "reject",
      "onUnknown": "ignore",
      "evidenceRequirementRefs": ["financial-evidence"]
    },
    {
      "id": "d5-prior-enforcement",
      "description": "Reject a CLEAR request with a recorded prior enforcement action.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "fact",
            "path": "/vendor/priorEnforcement",
            "operator": "equals",
            "value": "yes"
          }
        ]
      },
      "outcome": "reject",
      "onUnknown": "ignore",
      "evidenceRequirementRefs": ["financial-evidence"]
    },
    {
      "id": "d6a-low-basic-approval",
      "description": "Approve a CLEAR LOW-country request below risk 40 with spend at most 500000.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "fact",
            "path": "/vendor/countryRisk",
            "operator": "equals",
            "value": "LOW"
          },
          {
            "op": "fact",
            "path": "/vendor/riskScore",
            "operator": "less-than",
            "value": "40"
          },
          {
            "op": "fact",
            "path": "/vendor/requestedSpend",
            "operator": "less-than-or-equal",
            "value": "500000.00"
          }
        ]
      },
      "outcome": "approve",
      "onUnknown": "ignore",
      "evidenceRequirementRefs": ["financial-evidence"]
    },
    {
      "id": "d6b-insured-approval",
      "description": "Approve a qualifying D6b request when insurance is available.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "fact",
            "path": "/vendor/countryRisk",
            "operator": "equals",
            "value": "LOW"
          },
          {
            "op": "fact",
            "path": "/vendor/riskScore",
            "operator": "less-than",
            "value": "40"
          },
          {
            "op": "fact",
            "path": "/vendor/requestedSpend",
            "operator": "greater-than",
            "value": "500000.00"
          },
          {
            "op": "fact",
            "path": "/vendor/requestedSpend",
            "operator": "less-than-or-equal",
            "value": "2000000.00"
          },
          {
            "op": "evidence-present",
            "evidenceRequirement": "insurance-certificate"
          }
        ]
      },
      "outcome": "approve",
      "onUnknown": "escalate",
      "evidenceRequirementRefs": ["financial-evidence", "insurance-certificate"]
    },
    {
      "id": "d6b-uninsured-enhanced-review",
      "description": "Enhanced-review a qualifying D6b request when insurance is absent.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "fact",
            "path": "/vendor/countryRisk",
            "operator": "equals",
            "value": "LOW"
          },
          {
            "op": "fact",
            "path": "/vendor/riskScore",
            "operator": "less-than",
            "value": "40"
          },
          {
            "op": "fact",
            "path": "/vendor/requestedSpend",
            "operator": "greater-than",
            "value": "500000.00"
          },
          {
            "op": "fact",
            "path": "/vendor/requestedSpend",
            "operator": "less-than-or-equal",
            "value": "2000000.00"
          },
          {
            "op": "not",
            "condition": {
              "op": "evidence-present",
              "evidenceRequirement": "insurance-certificate"
            }
          }
        ]
      },
      "outcome": "enhanced-review",
      "onUnknown": "escalate",
      "evidenceRequirementRefs": ["financial-evidence", "insurance-certificate"]
    },
    {
      "id": "d6c-low-moderate-risk-approval",
      "description": "Approve a qualifying D6c request unless suspended for a new vendor.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "fact",
            "path": "/vendor/countryRisk",
            "operator": "equals",
            "value": "LOW"
          },
          {
            "op": "fact",
            "path": "/vendor/riskScore",
            "operator": "greater-than-or-equal",
            "value": "40"
          },
          {
            "op": "fact",
            "path": "/vendor/riskScore",
            "operator": "less-than",
            "value": "70"
          },
          {
            "op": "fact",
            "path": "/vendor/requestedSpend",
            "operator": "less-than-or-equal",
            "value": "100000.00"
          }
        ]
      },
      "outcome": "approve",
      "onUnknown": "ignore",
      "evidenceRequirementRefs": ["financial-evidence"]
    },
    {
      "id": "o1-new-vendor-review",
      "description": "Review a new vendor otherwise qualifying under D6c.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "fact",
            "path": "/vendor/newVendor",
            "operator": "equals",
            "value": "yes"
          },
          {
            "op": "fact",
            "path": "/vendor/countryRisk",
            "operator": "equals",
            "value": "LOW"
          },
          {
            "op": "fact",
            "path": "/vendor/riskScore",
            "operator": "greater-than-or-equal",
            "value": "40"
          },
          {
            "op": "fact",
            "path": "/vendor/riskScore",
            "operator": "less-than",
            "value": "70"
          },
          {
            "op": "fact",
            "path": "/vendor/requestedSpend",
            "operator": "less-than-or-equal",
            "value": "100000.00"
          }
        ]
      },
      "outcome": "review",
      "onUnknown": "ignore",
      "evidenceRequirementRefs": ["financial-evidence"]
    },
    {
      "id": "d7-medium-approval",
      "description": "Approve a CLEAR MEDIUM-country request below risk 40 with spend at most 100000.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "fact",
            "path": "/vendor/countryRisk",
            "operator": "equals",
            "value": "MEDIUM"
          },
          {
            "op": "fact",
            "path": "/vendor/riskScore",
            "operator": "less-than",
            "value": "40"
          },
          {
            "op": "fact",
            "path": "/vendor/requestedSpend",
            "operator": "less-than-or-equal",
            "value": "100000.00"
          }
        ]
      },
      "outcome": "approve",
      "onUnknown": "ignore",
      "evidenceRequirementRefs": ["financial-evidence"]
    },
    {
      "id": "d8-review",
      "description": "Review every otherwise-undetermined CLEAR request.",
      "when": {
        "op": "fact",
        "path": "/vendor/sanctionsStatus",
        "operator": "equals",
        "value": "CLEAR"
      },
      "outcome": "review",
      "onUnknown": "ignore",
      "evidenceRequirementRefs": ["financial-evidence"]
    },
    {
      "id": "u1-risk-unreadable",
      "description": "Block resolution when risk is unreadable and no independently decisive clause applies.",
      "when": {
        "op": "not",
        "condition": {
          "op": "fact",
          "path": "/vendor/riskScore",
          "operator": "greater-than-or-equal",
          "value": "0"
        }
      },
      "outcome": "review",
      "onUnknown": "escalate"
    },
    {
      "id": "u1-spend-unreadable",
      "description": "Block resolution when spend is unreadable and no independently decisive clause applies.",
      "when": {
        "op": "not",
        "condition": {
          "op": "fact",
          "path": "/vendor/requestedSpend",
          "operator": "greater-than-or-equal",
          "value": "0.00"
        }
      },
      "outcome": "review",
      "onUnknown": "escalate"
    },
    {
      "id": "u1-country-unreadable",
      "description": "Block resolution when country risk is unreadable and no independently decisive clause applies.",
      "when": {
        "op": "not",
        "condition": {
          "op": "fact",
          "path": "/vendor/countryRisk",
          "operator": "in",
          "value": ["LOW", "MEDIUM", "HIGH"]
        }
      },
      "outcome": "review",
      "onUnknown": "escalate"
    }
  ],
  "exceptions": [
    {
      "id": "o3-large-high-country-exposure",
      "description": "Escalate a CLEAR HIGH-country request above 2000000.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "fact",
            "path": "/vendor/countryRisk",
            "operator": "equals",
            "value": "HIGH"
          },
          {
            "op": "fact",
            "path": "/vendor/requestedSpend",
            "operator": "greater-than",
            "value": "2000000.00"
          }
        ]
      },
      "effect": "escalate",
      "onUnknown": "escalate"
    },
    {
      "id": "o2-critical-supplier",
      "description": "Force review for a CLEAR critical supplier.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "fact",
            "path": "/vendor/criticalSupplier",
            "operator": "equals",
            "value": "yes"
          }
        ]
      },
      "effect": "force-outcome",
      "outcome": "review",
      "onUnknown": "ignore"
    },
    {
      "id": "o1-suspend-d6c",
      "description": "Suppress D6c for a reported new vendor.",
      "when": {
        "op": "fact",
        "path": "/vendor/newVendor",
        "operator": "equals",
        "value": "yes"
      },
      "effect": "suppress-rule",
      "targetRule": "d6c-low-moderate-risk-approval",
      "onUnknown": "ignore"
    },
    {
      "id": "prior-suppress-d6a",
      "description": "Prior enforcement prevents D6a approval.",
      "when": {
        "op": "fact",
        "path": "/vendor/priorEnforcement",
        "operator": "equals",
        "value": "yes"
      },
      "effect": "suppress-rule",
      "targetRule": "d6a-low-basic-approval",
      "onUnknown": "ignore"
    },
    {
      "id": "prior-suppress-d6b-approved",
      "description": "Prior enforcement prevents D6b approval.",
      "when": {
        "op": "fact",
        "path": "/vendor/priorEnforcement",
        "operator": "equals",
        "value": "yes"
      },
      "effect": "suppress-rule",
      "targetRule": "d6b-insured-approval",
      "onUnknown": "ignore"
    },
    {
      "id": "prior-suppress-d6b-enhanced",
      "description": "Prior enforcement prevents D6b enhanced review.",
      "when": {
        "op": "fact",
        "path": "/vendor/priorEnforcement",
        "operator": "equals",
        "value": "yes"
      },
      "effect": "suppress-rule",
      "targetRule": "d6b-uninsured-enhanced-review",
      "onUnknown": "ignore"
    },
    {
      "id": "prior-suppress-d6c",
      "description": "Prior enforcement prevents D6c approval.",
      "when": {
        "op": "fact",
        "path": "/vendor/priorEnforcement",
        "operator": "equals",
        "value": "yes"
      },
      "effect": "suppress-rule",
      "targetRule": "d6c-low-moderate-risk-approval",
      "onUnknown": "ignore"
    },
    {
      "id": "prior-suppress-o1-review",
      "description": "Prior enforcement prevents O1 review from displacing rejection.",
      "when": {
        "op": "fact",
        "path": "/vendor/priorEnforcement",
        "operator": "equals",
        "value": "yes"
      },
      "effect": "suppress-rule",
      "targetRule": "o1-new-vendor-review",
      "onUnknown": "ignore"
    },
    {
      "id": "prior-suppress-d7",
      "description": "Prior enforcement prevents D7 approval.",
      "when": {
        "op": "fact",
        "path": "/vendor/priorEnforcement",
        "operator": "equals",
        "value": "yes"
      },
      "effect": "suppress-rule",
      "targetRule": "d7-medium-approval",
      "onUnknown": "ignore"
    },
    {
      "id": "d3-suppress-d8",
      "description": "D3 governs instead of D8.",
      "when": {
        "op": "fact",
        "path": "/vendor/riskScore",
        "operator": "greater-than-or-equal",
        "value": "90"
      },
      "effect": "suppress-rule",
      "targetRule": "d8-review",
      "onUnknown": "ignore"
    },
    {
      "id": "d4-suppress-d8",

                      "operator": "greater-than",
                      "value": "500000.00"
                    },
                    {
                      "op": "fact",
                      "path": "/vendor/requestedSpend",
                      "operator": "less-than-or-equal",
                      "value": "2000000.00"
                    }
                  ]
                },
                {
                  "op": "all",
                  "conditions": [
                    {
                      "op": "fact",
                      "path": "/vendor/countryRisk",
                      "operator": "equals",
                      "value": "LOW"
                    },
                    {
                      "op": "fact",
                      "path": "/vendor/riskScore",
                      "operator": "greater-than-or-equal",
                      "value": "40"
                    },
                    {
                      "op": "fact",
                      "path": "/vendor/riskScore",
                      "operator": "less-than",
                      "value": "70"
                    },
                    {
                      "op": "fact",
                      "path": "/vendor/requestedSpend",
                      "operator": "less-than-or-equal",
                      "value": "100000.00"
                    }
                  ]
                },
                {
                  "op": "all",
                  "conditions": [
                    {
                      "op": "fact",
                      "path": "/vendor/countryRisk",
                      "operator": "equals",
                      "value": "MEDIUM"
                    },
                    {
                      "op": "fact",
                      "path": "/vendor/riskScore",
                      "operator": "less-than",
                      "value": "40"
                    },
                    {
                      "op": "fact",
                      "path": "/vendor/requestedSpend",
                      "operator": "less-than-or-equal",
                      "value": "100000.00"
                    }
                  ]
                }
              ]
            }
          }
        ]
      },
      "outcome": "review",
      "onUnknown": "escalate",
      "evidenceRequirementRefs": [
        "financial-evidence"
      ]
    }
  ],
  "exceptions": [
    {
      "id": "o-three-large-high-exposure",
      "description": "O3 directly escalates CLEAR requests in a HIGH-risk country with spend above 2000000.00 and takes precedence over every determination.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "fact",
            "path": "/vendor/countryRisk",

        "operator": "equals",
        "value": "yes"
      },
      "effect": "suppress-rule",
      "targetRule": "d-six-a-low-basic-approval",
      "onUnknown": "ignore"
    },
    {
      "id": "prior-action-suppresses-d-six-b-approval",
      "description": "A recorded prior enforcement action prevents the D6b approval limb.",
      "when": {
        "op": "fact",
        "path": "/vendor/priorEnforcement",
        "operator": "equals",
        "value": "yes"
      },
      "effect": "suppress-rule",
      "targetRule": "d-six-b-insured-approval",
      "onUnknown": "ignore"
    },
    {
      "id": "prior-action-suppresses-d-six-b-enhanced",
      "description": "A recorded prior enforcement action prevents the D6b enhanced-review limb.",
      "when": {
        "op": "fact",
        "path": "/vendor/priorEnforcement",
        "operator": "equals",
        "value": "yes"
      },
      "effect": "suppress-rule",
      "targetRule": "d-six-b-uninsured-enhanced-review",
      "onUnknown": "ignore"
    },
    {
      "id": "prior-action-suppresses-d-six-c",
      "description": "A recorded prior enforcement action prevents D6c approval.",
      "when": {
        "op": "fact",
        "path": "/vendor/priorEnforcement",
        "operator": "equals",
        "value": "yes"
      },
      "effect": "suppress-rule",
      "targetRule": "d-six-c-low-moderate-risk-approval",
      "onUnknown": "ignore"
    },
    {
      "id": "prior-action-suppresses-d-seven",
      "description": "A recorded prior enforcement action prevents D7 approval.",
      "when": {
        "op": "fact",
        "path": "/vendor/priorEnforcement",
        "operator": "equals",
        "value": "yes"
      },
      "effect": "suppress-rule",
      "targetRule": "d-seven-medium-approval",
      "onUnknown": "ignore"
    },
    {
      "id": "prior-action-suppresses-d-eight",
      "description": "A recorded prior enforcement action prevents D8 review so D5 rejection governs.",
      "when": {
        "op": "fact",
        "path": "/vendor/priorEnforcement",
        "operator": "equals",
        "value": "yes"
      },
      "effect": "suppress-rule",
      "targetRule": "d-eight-review",
      "onUnknown": "ignore"
    }
  ],
  "escalation": {
    "triggers": [

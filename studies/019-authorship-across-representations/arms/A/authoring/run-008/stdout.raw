                      "value": "40"
                    },
                    {
                      "op": "fact",
                      "path": "/vendor/requestedSpend",
                      "operator": "less-than-or-equal",
                      "value": "500000.00"
                    }
                  ]
                },
                {
                  "op": "all",
                  "conditions": [
                    {
                      "op": "fact",
                      "path": "/vendor/countryRisk",
                      "operator": "equals",
                      "value": "LOW"
                    },
                    {
                      "op": "fact",
                      "path": "/vendor/riskScore",
                      "operator": "less-than",
                      "value": "40"
                    },
                    {
                      "op": "fact",

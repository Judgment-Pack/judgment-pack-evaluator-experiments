PACK:
```json
{
  "specVersion": "0.2.0-draft",
  "id": "https://example.org/judgment-packs/vendor-approval-policy",
  "version": "1.0.0",
  "title": "Vendor Approval Policy",
  "description": "Determines vendor onboarding spend requests under the stated financial-evidence precondition, sanctions rules, approval thresholds, overrides, and unreadable-input rules.",
  "decision": {
    "intent": "Determine the required handling of a vendor onboarding spend request.",
    "question": "Should the vendor request be approved, reviewed, enhanced-reviewed, rejected, or left unresolved?"
  },
  "evidenceRequirements": [
    {
      "id": "financial-evidence",
      "description": "Audited financial statements must be available before any determination can be issued.",
      "required": true,
      "kind": "document"
    },
    {
      "id": "insurance-certificate",
      "description": "Insurance certificate consulted only for qualifying LOW-country requests above 500000.00 and up to 2000000.00.",
      "required": false,
      "kind": "document"
    }
  ],
  "outcomes": [
    {
      "id": "approve",
      "label": "Approve"
    },
    {
      "id": "review",
      "label": "Review"
    },
    {
      "id": "enhanced-review",
      "label": "Enhanced review"
    },
    {
      "id": "reject",
      "label": "Reject"
    }
  ],
  "rules": [
    {
      "id": "sanctions-match",
      "description": "D1: reject a sanctions MATCH.",
      "when": {
        "op": "fact",
        "path": "/vendor/sanctionsStatus",
        "operator": "equals",
        "value": "MATCH"
      },
      "outcome": "reject",
      "onUnknown": "ignore",
      "evidenceRequirementRefs": [
        "financial-evidence"
      ]
    },
    {
      "id": "clear-rejection",
      "description": "D3-D5: reject a CLEAR request for critical risk, elevated risk in a HIGH-risk country, or a recorded prior enforcement action.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "any",
            "conditions": [
              {
                "op": "fact",
                "path": "/vendor/riskScore",
                "operator": "greater-than-or-equal",
                "value": "90"
              },
              {
                "op": "all",
                "conditions": [
                  {
                    "op": "fact",
                    "path": "/vendor/countryRisk",
                    "operator": "equals",
                    "value": "HIGH"
                  },
                  {
                    "op": "fact",
                    "path": "/vendor/riskScore",
                    "operator": "greater-than-or-equal",
                    "value": "70"
                  }
                ]
              },
              {
                "op": "fact",
                "path": "/vendor/priorEnforcement",
                "operator": "equals",
                "value": "yes"
              }
            ]
          }
        ]
      },
      "outcome": "reject",
      "onUnknown": "escalate",
      "evidenceRequirementRefs": [
        "financial-evidence"
      ]
    },
    {
      "id": "low-small-approval",
      "description": "D6a: approve LOW-country requests below risk 40 with spend up to 500000.00, absent a rejection condition.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "fact",
            "path": "/vendor/countryRisk",
            "operator": "equals",
            "value": "LOW"
          },
          {
            "op": "fact",
            "path": "/vendor/riskScore",
            "operator": "less-than",
            "value": "40"
          },
          {
            "op": "fact",
            "path": "/vendor/requestedSpend",
            "operator": "less-than-or-equal",
            "value": "500000.00"
          },
          {
            "op": "not",
            "condition": {
              "op": "fact",
              "path": "/vendor/priorEnforcement",
              "operator": "equals",
              "value": "yes"
            }
          }
        ]
      },
      "outcome": "approve",
      "onUnknown": "ignore",
      "evidenceRequirementRefs": [
        "financial-evidence"
      ]
    },
    {
      "id": "low-mid-insured-approval",
      "description": "D6b approval limb: approve the qualifying LOW-country middle spend band when insurance is present.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "fact",
            "path": "/vendor/countryRisk",
            "operator": "equals",
            "value": "LOW"
          },
          {
            "op": "fact",
            "path": "/vendor/riskScore",
            "operator": "less-than",
            "value": "40"
          },
          {
            "op": "fact",
            "path": "/vendor/requestedSpend",
            "operator": "greater-than",
            "value": "500000.00"
          },
          {
            "op": "fact",
            "path": "/vendor/requestedSpend",
            "operator": "less-than-or-equal",
            "value": "2000000.00"
          },
          {
            "op": "not",
            "condition": {
              "op": "fact",
              "path": "/vendor/priorEnforcement",
              "operator": "equals",
              "value": "yes"
            }
          },
          {
            "op": "evidence-present",
            "evidenceRequirement": "insurance-certificate"
          }
        ]
      },
      "outcome": "approve",
      "onUnknown": "escalate",
      "evidenceRequirementRefs": [
        "financial-evidence",
        "insurance-certificate"
      ]
    },
    {
      "id": "low-mid-uninsured-enhanced",
      "description": "D6b absent-insurance limb: enhanced review for the qualifying LOW-country middle spend band when insurance is absent.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "fact",
            "path": "/vendor/countryRisk",
            "operator": "equals",
            "value": "LOW"
          },
          {
            "op": "fact",
            "path": "/vendor/riskScore",
            "operator": "less-than",
            "value": "40"
          },
          {
            "op": "fact",
            "path": "/vendor/requestedSpend",
            "operator": "greater-than",
            "value": "500000.00"
          },
          {
            "op": "fact",
            "path": "/vendor/requestedSpend",
            "operator": "less-than-or-equal",
            "value": "2000000.00"
          },
          {
            "op": "not",
            "condition": {
              "op": "fact",
              "path": "/vendor/priorEnforcement",
              "operator": "equals",
              "value": "yes"
            }
          },
          {
            "op": "not",
            "condition": {
              "op": "evidence-present",
              "evidenceRequirement": "insurance-certificate"
            }
          }
        ]
      },
      "outcome": "enhanced-review",
      "onUnknown": "escalate",
      "evidenceRequirementRefs": [
        "financial-evidence",
        "insurance-certificate"
      ]
    },
    {
      "id": "low-moderate-approval",
      "description": "D6c: approve LOW-country requests from risk 40 through 69 with spend up to 100000.00 unless O1 suspends this rule.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "fact",
            "path": "/vendor/countryRisk",
            "operator": "equals",
            "value": "LOW"
          },
          {
            "op": "fact",
            "path": "/vendor/riskScore",
            "operator": "greater-than-or-equal",
            "value": "40"
          },
          {
            "op": "fact",
            "path": "/vendor/riskScore",
            "operator": "less-than",
            "value": "70"
          },
          {
            "op": "fact",
            "path": "/vendor/requestedSpend",
            "operator": "less-than-or-equal",
            "value": "100000.00"
          },
          {
            "op": "not",
            "condition": {
              "op": "fact",
              "path": "/vendor/priorEnforcement",
              "operator": "equals",
              "value": "yes"
            }
          }
        ]
      },
      "outcome": "approve",
      "onUnknown": "ignore",
      "evidenceRequirementRefs": [
        "financial-evidence"
      ]
    },
    {
      "id": "new-vendor-moderate-review",
      "description": "O1 and D8: a new vendor otherwise within D6c receives review.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "fact",
            "path": "/vendor/newVendor",
            "operator": "equals",
            "value": "yes"
          },
          {
            "op": "fact",
            "path": "/vendor/countryRisk",
            "operator": "equals",
            "value": "LOW"
          },
          {
            "op": "fact",
            "path": "/vendor/riskScore",
            "operator": "greater-than-or-equal",
            "value": "40"
          },
          {
            "op": "fact",
            "path": "/vendor/riskScore",
            "operator": "less-than",
            "value": "70"
          },
          {
            "op": "fact",
            "path": "/vendor/requestedSpend",
            "operator": "less-than-or-equal",
            "value": "100000.00"
          },
          {
            "op": "not",
            "condition": {
              "op": "fact",
              "path": "/vendor/priorEnforcement",
              "operator": "equals",
              "value": "yes"
            }
          }
        ]
      },
      "outcome": "review",
      "onUnknown": "ignore",
      "evidenceRequirementRefs": [
        "financial-evidence"
      ]
    },
    {
      "id": "medium-small-approval",
      "description": "D7: approve MEDIUM-country requests below risk 40 with spend up to 100000.00, absent a rejection condition.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",

  "exceptions": [
    {
      "id": "large-high-country-escalation",
      "description": "O3: a CLEAR HIGH-country request above 2000000.00 is escalated for human determination.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "fact",
            "path": "/vendor/countryRisk",

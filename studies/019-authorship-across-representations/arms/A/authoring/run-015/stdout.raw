{
  "matrixVersion": "2",
  "cases": [
    {
      "id": "p1-financial-evidence-absent",
      "facts": {
        "vendor": {
          "riskScore": "95",
          "requestedSpend": "100.00",
          "sanctionsStatus": "MATCH",
          "countryRisk": "LOW"
        }
      },
      "evidenceAvailability": {
        "financial-evidence": "absent"
      },
      "expectedDisposition": {
        "kind": "unresolved",
        "reasons": [
          "missing-required-evidence"
        ],
        "handoff": {
          "state": "requested",
          "triggeredBy": [
            "missing-required-evidence"
          ]
        }
      },
      "expectedHandoffTarget": {
        "kind": "queue",
        "name": "vendor-compliance-desk"
      },
      "focus": "P1 blocks even sanctions rejection."

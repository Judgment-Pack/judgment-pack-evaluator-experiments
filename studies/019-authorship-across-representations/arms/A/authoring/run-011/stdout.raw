            "path": "/vendor/requestedSpend",
            "operator": "greater-than",
            "value": "2000000.00"
          }
        ]
      },
      "effect": "escalate",
      "onUnknown": "escalate",
      "sourceRefs": []
    },
    {
      "id": "o2-critical-supplier",
      "description": "Force review for a critical supplier with CLEAR screening unless O3 applies.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "fact",
            "path": "/vendor/criticalSupplier",
            "operator": "equals",
            "value": "yes"
          }
        ]
      },
      "effect": "force-outcome",
      "outcome": "review",
      "onUnknown": "ignore",
      "sourceRefs": []
    },
    {
      "id": "o1-suspend-d6c",
      "description": "Suppress D6c for a reported new vendor.",
      "when": {
        "op": "fact",
        "path": "/vendor/newVendor",
        "operator": "equals",
        "value": "yes"
      },
      "effect": "suppress-rule",
      "targetRule": "d6c-low-moderate",
      "onUnknown": "ignore",
      "sourceRefs": []
    },
    {
      "id": "d5-suppress-d6a",

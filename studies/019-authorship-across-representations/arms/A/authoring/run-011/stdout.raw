  "exceptions": [
    {
      "id": "o3-large-high-exposure",
      "description": "Escalate a CLEAR request from a HIGH-risk country when spend exceeds two million dollars.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "fact",
            "path": "/vendor/countryRisk",

{
  "matrixVersion": "2",
  "cases": [
    {
      "id": "p1-financial-evidence-absent-blocks-match-rejection",
      "facts": {
        "vendor": {
          "riskScore": "95",
          "requestedSpend": "100.00",
          "sanctionsStatus": "MATCH",
          "countryRisk": "HIGH",
          "newVendor": "no",

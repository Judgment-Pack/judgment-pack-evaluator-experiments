      "effect": "suppress-rule",
      "targetRule": "d6c-low-moderate-risk-approval",
      "onUnknown": "ignore"
    },
    {
      "id": "d5-suppress-d6a",
      "description": "A recorded prior enforcement action prevents D6a approval.",

        "operator": "equals",
        "value": "yes"
      },
      "effect": "suppress-rule",
      "targetRule": "d6a-low-basic-approval",
      "onUnknown": "ignore"
    },
    {
      "id": "d5-suppress-d6b-insured",
      "description": "A recorded prior enforcement action prevents D6b approval.",
      "when": {
        "op": "fact",
        "path": "/vendor/priorEnforcement",
        "operator": "equals",
        "value": "yes"
      },
      "effect": "suppress-rule",
      "targetRule": "d6b-insured-approval",
      "onUnknown": "ignore"
    },
    {
      "id": "d5-suppress-d6b-uninsured",
      "description": "A recorded prior enforcement action prevents D6b enhanced review.",
      "when": {
        "op": "fact",
        "path": "/vendor/priorEnforcement",
        "operator": "equals",
        "value": "yes"
      },
      "effect": "suppress-rule",
      "targetRule": "d6b-uninsured-enhanced-review",
      "onUnknown": "ignore"
    },
    {
      "id": "d5-suppress-d6c",
      "description": "A recorded prior enforcement action prevents D6c approval.",
      "when": {
        "op": "fact",
        "path": "/vendor/priorEnforcement",
        "operator": "equals",
        "value": "yes"
      },
      "effect": "suppress-rule",
      "targetRule": "d6c-low-moderate-risk-approval",
      "onUnknown": "ignore"
    },
    {
      "id": "d5-suppress-d7",
      "description": "A recorded prior enforcement action prevents D7 approval.",
      "when": {
        "op": "fact",
        "path": "/vendor/priorEnforcement",
        "operator": "equals",
        "value": "yes"
      },
      "effect": "suppress-rule",
      "targetRule": "d7-medium-basic-approval",
      "onUnknown": "ignore"
    },
    {
      "id": "d5-suppress-d8",
      "description": "A recorded prior enforcement action prevents D8 review so that D5 rejection governs.",
      "when": {
        "op": "fact",
        "path": "/vendor/priorEnforcement",
        "operator": "equals",
        "value": "yes"
      },
      "effect": "suppress-rule",
      "targetRule": "d8-review",
      "onUnknown": "ignore"
    }
  ],
  "escalation": {
    "triggers": [
      "missing-required-evidence",
      "no-match",
      "unknown"
    ],
    "target": {
      "kind": "queue",
      "name": "vendor-compliance-desk"
    }
  }
}

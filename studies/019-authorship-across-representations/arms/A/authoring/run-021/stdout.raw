      "onUnknown": "escalate"
    },
    {
      "id": "critical-supplier-review",
      "description": "Force review for a critical supplier with CLEAR screening unless the large high-risk-country escalation applies.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",

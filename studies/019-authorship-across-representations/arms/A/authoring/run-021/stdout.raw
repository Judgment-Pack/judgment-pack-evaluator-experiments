  "exceptions": [
    {
      "id": "large-high-risk-escalation",
      "description": "Escalate a CLEAR request from a HIGH-risk country when spend exceeds 2000000.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "fact",
            "path": "/vendor/countryRisk",
            "operator": "equals",

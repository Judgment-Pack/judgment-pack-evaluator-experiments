      "onUnknown": "ignore"
    },
    {
      "id": "prior-action-suppress-low-enhanced",
      "description": "A recorded prior enforcement action suppresses the enhanced-review rule.",
      "when": {
        "op": "fact",
        "path": "/vendor/priorEnforcement",
        "operator": "equals",
        "value": "yes"
      },
      "effect": "suppress-rule",
      "targetRule": "low-under-forty-uninsured-enhanced",
      "onUnknown": "ignore"
    },
    {
      "id": "prior-action-suppress-low-mid",
      "description": "A recorded prior enforcement action suppresses LOW-country mid-risk approval.",
      "when": {

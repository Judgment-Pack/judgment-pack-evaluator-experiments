        "path": "/vendor/priorEnforcement",
        "operator": "equals",
        "value": "yes"
      },
      "effect": "suppress-rule",
      "targetRule": "low-mid-risk-small-approve",
      "onUnknown": "ignore"
    },
    {
      "id": "prior-action-suppress-medium",
      "description": "A recorded prior enforcement action suppresses MEDIUM-country approval.",
      "when": {
        "op": "fact",
        "path": "/vendor/priorEnforcement",
        "operator": "equals",
        "value": "yes"
      },
      "effect": "suppress-rule",
      "targetRule": "medium-under-forty-small-approve",
      "onUnknown": "ignore"
    },
    {
      "id": "prior-action-suppress-residual-review",
      "description": "A recorded prior enforcement action suppresses residual review so rejection governs.",
      "when": {
        "op": "fact",
        "path": "/vendor/priorEnforcement",
        "operator": "equals",
        "value": "yes"
      },
      "effect": "suppress-rule",
      "targetRule": "clear-residual-review",
      "onUnknown": "ignore"
    },
    {
      "id": "new-vendor-suspend-low-mid",
      "description": "A new vendor is ineligible for LOW-country mid-risk approval.",
      "when": {
        "op": "fact",
        "path": "/vendor/newVendor",
        "operator": "equals",
        "value": "yes"
      },
      "effect": "suppress-rule",
      "targetRule": "low-mid-risk-small-approve",
      "onUnknown": "ignore"
    }
  ],
  "escalation": {
    "triggers": [
      "missing-required-evidence",
      "no-match",
      "unknown"
    ],
    "target": {
      "kind": "queue",
      "name": "vendor-compliance-desk"
    }
  }
}

        "operator": "equals",
        "value": "yes"
      },
      "effect": "suppress-rule",
      "targetRule": "d6a-low-basic-approval",
      "onUnknown": "ignore"
    },
    {
      "id": "d5-suppress-d6b-approve",
      "description": "Prior enforcement prevents D6b approval.",
      "when": {
        "op": "fact",
        "path": "/vendor/priorEnforcement",
        "operator": "equals",
        "value": "yes"
      },
      "effect": "suppress-rule",
      "targetRule": "d6b-insured-approval",
      "onUnknown": "ignore"
    },
    {
      "id": "d5-suppress-d6b-enhanced",
      "description": "Prior enforcement prevents D6b enhanced review.",
      "when": {
        "op": "fact",
        "path": "/vendor/priorEnforcement",
        "operator": "equals",
        "value": "yes"
      },
      "effect": "suppress-rule",
      "targetRule": "d6b-uninsured-enhanced-review",
      "onUnknown": "ignore"
    },
    {
      "id": "d5-suppress-d6c",
      "description": "Prior enforcement prevents D6c approval.",
      "when": {
        "op": "fact",
        "path": "/vendor/priorEnforcement",
        "operator": "equals",
        "value": "yes"
      },
      "effect": "suppress-rule",
      "targetRule": "d6c-low-moderate-risk-approval",
      "onUnknown": "ignore"
    },
    {
      "id": "d5-suppress-d7",
      "description": "Prior enforcement prevents D7 approval.",
      "when": {
        "op": "fact",
        "path": "/vendor/priorEnforcement",
        "operator": "equals",
        "value": "yes"
      },
      "effect": "suppress-rule",
      "targetRule": "d7-medium-basic-approval",
      "onUnknown": "ignore"
    },
    {
      "id": "d5-suppress-o1-review",
      "description": "Prior enforcement rejection takes precedence over the new-vendor D6c review path.",
      "when": {
        "op": "fact",
        "path": "/vendor/priorEnforcement",
        "operator": "equals",
        "value": "yes"
      },
      "effect": "suppress-rule",
      "targetRule": "o1-new-vendor-review",
      "onUnknown": "ignore"
    }
  ],
  "escalation": {
    "triggers": [
      "missing-required-evidence",
      "no-match",
      "unknown"
    ],
    "target": {
      "kind": "queue",
      "name": "vendor-compliance-desk"
    }
  }
}

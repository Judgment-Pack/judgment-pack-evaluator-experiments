  "exceptions": [
    {
      "id": "o3-large-high-country-exposure",
      "description": "Escalate a clear-screened high-country-risk request with spend above 2000000.00.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "fact",
            "path": "/vendor/countryRisk",
            "operator": "equals",
            "value": "HIGH"
          },
          {
            "op": "fact",
            "path": "/vendor/requestedSpend",
            "operator": "greater-than",
            "value": "2000000.00"
          }
        ]
      },
      "effect": "escalate",
      "onUnknown": "escalate"
    },
    {
      "id": "o2-critical-supplier",
      "description": "Force review for a clear-screened critical supplier unless O3 escalates.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "fact",
            "path": "/vendor/criticalSupplier",
            "operator": "equals",
            "value": "yes"
          }
        ]
      },
      "effect": "force-outcome",
      "outcome": "review",
      "onUnknown": "ignore"
    },
    {
      "id": "o1-suppress-d6c",
      "description": "Suppress D6c for a reported new vendor.",
      "when": {
        "op": "fact",
        "path": "/vendor/newVendor",
        "operator": "equals",
        "value": "yes"
      },
      "effect": "suppress-rule",
      "targetRule": "d6c-low-moderate-risk-approval",
      "onUnknown": "ignore"
    },
    {
      "id": "d5-suppress-d6a",
      "description": "Prior enforcement prevents D6a approval.",

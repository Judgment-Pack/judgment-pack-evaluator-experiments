PACK:
```json
{
  "specVersion": "0.2.0-draft",
  "id": "https://example.org/judgment-packs/vendor-approval-policy",
  "version": "1.0.0",
  "title": "Vendor Approval Policy",
  "description": "Determines vendor onboarding spend requests under the stated financial-evidence precondition, sanctions rules, risk thresholds, approval rules, and overrides.",
  "decision": {
    "intent": "Determine the required disposition of a vendor onboarding spend request.",
    "question": "Should this vendor onboarding spend request be approved, reviewed, enhanced-reviewed, rejected, or left unresolved?"
  },
  "evidenceRequirements": [
    {
      "id": "financial-evidence",
      "description": "Audited financial statements must be available before any determination may be issued.",
      "required": true,
      "kind": "document"
    },
    {
      "id": "insurance-certificate",
      "description": "Insurance certificate consulted only for qualifying D6b requests.",
      "required": false,
      "kind": "document"
    }
  ],
  "outcomes": [
    {
      "id": "approve",
      "label": "Approve"
    },
    {
      "id": "review",
      "label": "Review"
    },
    {
      "id": "enhanced-review",
      "label": "Enhanced review"
    },
    {
      "id": "reject",
      "label": "Reject"
    }
  ],
  "rules": [
    {
      "id": "d-one-sanctions-match",
      "description": "D1: reject a sanctions match.",
      "when": {
        "op": "fact",
        "path": "/vendor/sanctionsStatus",
        "operator": "equals",
        "value": "MATCH"
      },
      "outcome": "reject",
      "onUnknown": "ignore",
      "evidenceRequirementRefs": [
        "financial-evidence"
      ]
    },
    {
      "id": "d-six-a-low-basic-approval",
      "description": "D6a: approve a LOW-country request with risk below 40 and spend no more than 500000.00.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "fact",
            "path": "/vendor/countryRisk",
            "operator": "equals",
            "value": "LOW"
          },
          {
            "op": "fact",
            "path": "/vendor/riskScore",
            "operator": "less-than",
            "value": "40"
          },
          {
            "op": "fact",
            "path": "/vendor/requestedSpend",
            "operator": "less-than-or-equal",
            "value": "500000.00"
          }
        ]
      },
      "outcome": "approve",
      "onUnknown": "escalate",
      "evidenceRequirementRefs": [
        "financial-evidence"
      ]
    },
    {
      "id": "d-six-b-insured-approval",
      "description": "D6b: approve an eligible LOW-country request when the insurance certificate is available.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "fact",
            "path": "/vendor/countryRisk",
            "operator": "equals",
            "value": "LOW"
          },
          {
            "op": "fact",
            "path": "/vendor/riskScore",
            "operator": "less-than",
            "value": "40"
          },
          {
            "op": "fact",
            "path": "/vendor/requestedSpend",
            "operator": "greater-than",
            "value": "500000.00"
          },
          {
            "op": "fact",
            "path": "/vendor/requestedSpend",
            "operator": "less-than-or-equal",
            "value": "2000000.00"
          },
          {
            "op": "evidence-present",
            "evidenceRequirement": "insurance-certificate"
          }
        ]
      },
      "outcome": "approve",
      "onUnknown": "escalate",
      "evidenceRequirementRefs": [
        "financial-evidence",
        "insurance-certificate"
      ]
    },
    {
      "id": "d-six-b-uninsured-enhanced-review",
      "description": "D6b: send an eligible LOW-country request to enhanced review when the insurance certificate is absent.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "fact",
            "path": "/vendor/countryRisk",
            "operator": "equals",
            "value": "LOW"
          },
          {
            "op": "fact",
            "path": "/vendor/riskScore",
            "operator": "less-than",
            "value": "40"
          },
          {
            "op": "fact",
            "path": "/vendor/requestedSpend",
            "operator": "greater-than",
            "value": "500000.00"
          },
          {
            "op": "fact",
            "path": "/vendor/requestedSpend",
            "operator": "less-than-or-equal",
            "value": "2000000.00"
          },
          {
            "op": "not",
            "condition": {
              "op": "evidence-present",
              "evidenceRequirement": "insurance-certificate"
            }
          }
        ]
      },
      "outcome": "enhanced-review",
      "onUnknown": "escalate",
      "evidenceRequirementRefs": [
        "financial-evidence",
        "insurance-certificate"
      ]
    },
    {
      "id": "d-six-c-low-moderate-risk-approval",
      "description": "D6c: approve a LOW-country request with risk from 40 through 69 and spend no more than 100000.00, unless O1 suppresses this rule.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "fact",
            "path": "/vendor/countryRisk",
            "operator": "equals",
            "value": "LOW"
          },
          {
            "op": "fact",
            "path": "/vendor/riskScore",
            "operator": "greater-than-or-equal",
            "value": "40"
          },
          {
            "op": "fact",
            "path": "/vendor/riskScore",
            "operator": "less-than",
            "value": "70"
          },
          {
            "op": "fact",
            "path": "/vendor/requestedSpend",
            "operator": "less-than-or-equal",
            "value": "100000.00"
          }
        ]
      },
      "outcome": "approve",
      "onUnknown": "escalate",
      "evidenceRequirementRefs": [
        "financial-evidence"
      ]
    },
    {
      "id": "d-seven-medium-approval",
      "description": "D7: approve a MEDIUM-country request with risk below 40 and spend no more than 100000.00.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "fact",
            "path": "/vendor/countryRisk",
            "operator": "equals",
            "value": "MEDIUM"
          },
          {
            "op": "fact",
            "path": "/vendor/riskScore",
            "operator": "less-than",
            "value": "40"
          },
          {
            "op": "fact",
            "path": "/vendor/requestedSpend",
            "operator": "less-than-or-equal",
            "value": "100000.00"
          }
        ]
      },
      "outcome": "approve",
      "onUnknown": "escalate",
      "evidenceRequirementRefs": [
        "financial-evidence"
      ]
    },
    {
      "id": "d-eight-review-remainder",
      "description": "D8: review a CLEAR request outside the eligibility regions decided by D6 and D7; HIGH-country cases below the D4 rejection threshold are included.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "not",
            "condition": {
              "op": "any",
              "conditions": [
                {
                  "op": "all",
                  "conditions": [
                    {
                      "op": "fact",
                      "path": "/vendor/countryRisk",
                      "operator": "equals",
                      "value": "LOW"
                    },
                    {
                      "op": "fact",
                      "path": "/vendor/riskScore",
                      "operator": "less-than",
                      "value": "40"
                    },
                    {
                      "op": "fact",
                      "path": "/vendor/requestedSpend",
                      "operator": "less-than-or-equal",
                      "value": "2000000.00"
                    }
                  ]
                },
                {
                  "op": "all",
                  "conditions": [
                    {
                      "op": "fact",
                      "path": "/vendor/countryRisk",
                      "operator": "equals",
                      "value": "LOW"
                    },
                    {
                      "op": "fact",
                      "path": "/vendor/riskScore",
                      "operator": "greater-than-or-equal",
                      "value": "40"
                    },
                    {
                      "op": "fact",
                      "path": "/vendor/riskScore",
                      "operator": "less-than",
                      "value": "70"
                    },
                    {
                      "op": "fact",
                      "path": "/vendor/requestedSpend",
                      "operator": "less-than-or-equal",
                      "value": "100000.00"
                    }
                  ]
                },
                {
                  "op": "all",
                  "conditions": [
                    {
                      "op": "fact",
                      "path": "/vendor/countryRisk",
                      "operator": "equals",
                      "value": "MEDIUM"
                    },
                    {
                      "op": "fact",
                      "path": "/vendor/riskScore",
                      "operator": "less-than",
                      "value": "40"
                    },
                    {
                      "op": "fact",
                      "path": "/vendor/requestedSpend",
                      "operator": "less-than-or-equal",
                      "value": "100000.00"
                    }
                  ]
                }
              ]
            }
          },
          {
            "op": "any",
            "conditions": [
              {
                "op": "not",
                "condition": {
                  "op": "fact",
                  "path": "/vendor/countryRisk",
                  "operator": "equals",
                  "value": "HIGH"
                }
              },
              {
                "op": "fact",
                "path": "/vendor/riskScore",
                "operator": "less-than",
                "value": "70"
              }
            ]
          }
        ]
      },
      "outcome": "review",
      "onUnknown": "escalate",
      "evidenceRequirementRefs": [
        "financial-evidence"
      ]
    },
    {
      "id": "d-eight-new-vendor-review",
      "description": "D8 after O1: review a new vendor that otherwise satisfies D6c.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "fact",
            "path": "/vendor/newVendor",
            "operator": "equals",
            "value": "yes"
          },
          {
            "op": "fact",
            "path": "/vendor/countryRisk",
            "operator": "equals",
            "value": "LOW"
          },
          {
            "op": "fact",
            "path": "/vendor/riskScore",
            "operator": "greater-than-or-equal",
            "value": "40"
          },
          {
            "op": "fact",
            "path": "/vendor/riskScore",
            "operator": "less-than",
            "value": "70"
          },
          {
            "op": "fact",
            "path": "/vendor/requestedSpend",
            "operator": "less-than-or-equal",
            "value": "100000.00"
          }
        ]
      },
      "outcome": "review",
      "onUnknown": "ignore",
      "evidenceRequirementRefs": [
        "financial-evidence"
      ]
    }
  ],
  "exceptions": [
    {
      "id": "o-three-high-country-large-exposure",
      "description": "O3: escalate a CLEAR request from a HIGH-risk country when spend exceeds 2000000.00.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "fact",
            "path": "/vendor/countryRisk",
            "operator": "equals",
            "value": "HIGH"
          },
          {
            "op": "fact",
            "path": "/vendor/requestedSpend",
            "operator": "greater-than",
            "value": "2000000.00"
          }
        ]
      },
      "effect": "escalate",
      "onUnknown": "escalate"
    },
    {
      "id": "o-two-critical-supplier",
      "description": "O2: force review for a critical supplier with CLEAR sanctions screening.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "fact",
            "path": "/vendor/criticalSupplier",
            "operator": "equals",
            "value": "yes"
          }
        ]
      },
      "effect": "force-outcome",
      "outcome": "review",
      "onUnknown": "ignore"
    },
    {
      "id": "d-three-critical-risk",
      "description": "D3: force rejection for CLEAR screening and risk of at least 90.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "fact",
            "path": "/vendor/riskScore",
            "operator": "greater-than-or-equal",
            "value": "90"
          }
        ]
      },
      "effect": "force-outcome",
      "outcome": "reject",
      "onUnknown": "ignore"
    },
    {
      "id": "d-four-high-country-elevated-risk",
      "description": "D4: force rejection for CLEAR screening, HIGH country risk, and risk of at least 70.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "fact",
            "path": "/vendor/countryRisk",
            "operator": "equals",
            "value": "HIGH"
          },
          {
            "op": "fact",
            "path": "/vendor/riskScore",
            "operator": "greater-than-or-equal",
            "value": "70"
          }
        ]
      },
      "effect": "force-outcome",
      "outcome": "reject",
      "onUnknown": "ignore"
    },
    {
      "id": "d-five-prior-enforcement",
      "description": "D5: force rejection for CLEAR screening and a recorded prior enforcement action.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "fact",
            "path": "/vendor/priorEnforcement",
            "operator": "equals",
            "value": "yes"
          }
        ]
      },
      "effect": "force-outcome",
      "outcome": "reject",
      "onUnknown": "ignore"
    },
    {
      "id": "o-one-new-vendor-suspension",
      "description": "O1: suppress D6c for a new vendor.",
      "when": {
        "op": "fact",
        "path": "/vendor/newVendor",
        "operator": "equals",
        "value": "yes"
      },
      "effect": "suppress-rule",
      "targetRule": "d-six-c-low-moderate-risk-approval",
      "onUnknown": "ignore"
    }
  ],
  "escalation": {
    "triggers": [
      "missing-required-evidence",
      "no-match",
      "unknown"
    ],
    "target": {
      "kind": "queue",
      "name": "vendor-compliance-desk"
    }
  }
}

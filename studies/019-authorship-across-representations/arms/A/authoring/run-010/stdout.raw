        "path": "/vendor/priorEnforcement",
        "operator": "equals",
        "value": "yes"
      },
      "effect": "suppress-rule",
      "targetRule": "d6b-insurance-present",
      "onUnknown": "ignore"
    },
    {
      "id": "d5-suppress-d6b-absent",
      "description": "Prior enforcement prevents the enhanced-review D6b limb.",
      "when": {
        "op": "fact",
        "path": "/vendor/priorEnforcement",
        "operator": "equals",
        "value": "yes"

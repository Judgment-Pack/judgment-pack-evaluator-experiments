              }
            ]
          }
        ]
      },
      "effect": "suppress-rule",
      "targetRule": "d8-review",
      "onUnknown": "ignore"
    },
    {
      "id": "o1-suppress-d6c",
      "description": "Suspend D6c for a reported new vendor.",
      "when": {
        "op": "fact",
        "path": "/vendor/newVendor",
        "operator": "equals",
        "value": "yes"
      },
      "effect": "suppress-rule",
      "targetRule": "d6c-low-moderate-risk",
      "onUnknown": "ignore"
    },
    {
      "id": "d5-suppress-d6a",
      "description": "Prior enforcement prevents D6a approval.",

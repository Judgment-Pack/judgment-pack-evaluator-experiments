            "operator": "less-than",
            "value": "70"
          },
          {
            "op": "fact",
            "path": "/vendor/requestedSpend",
            "operator": "less-than-or-equal",
            "value": "100000.00"
          }
        ]
      },
      "effect": "suppress-rule",
      "targetRule": "r-review",
      "onUnknown": "ignore"
    },
    {
      "id": "x-d7-suppress-review",
      "description": "D7 decides its request before D8.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "fact",
            "path": "/vendor/countryRisk",
            "operator": "equals",
            "value": "MEDIUM"
          },
          {
            "op": "fact",
            "path": "/vendor/riskScore",
            "operator": "less-than",
            "value": "40"
          },
          {
            "op": "fact",
            "path": "/vendor/requestedSpend",
            "operator": "less-than-or-equal",
            "value": "100000.00"
          }
        ]
      },
      "effect": "suppress-rule",
      "targetRule": "r-review",
      "onUnknown": "ignore"
    },
    {
      "id": "x-d3-suppress-unreadable",
      "description": "U1: risk at least 90 rejects regardless of unreadable country or spend.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "fact",
            "path": "/vendor/riskScore",
            "operator": "greater-than-or-equal",
            "value": "90"
          }
        ]
      },
      "effect": "suppress-rule",
      "targetRule": "r-unreadable-input",
      "onUnknown": "ignore"
    },
    {
      "id": "x-d5-suppress-unreadable",
      "description": "U1: recorded prior enforcement rejects regardless of unreadable risk, spend, or country, except where O3 remains possible.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "fact",
            "path": "/vendor/priorEnforcement",
            "operator": "equals",
            "value": "yes"
          },
          {
            "op": "not",
            "condition": {
              "op": "all",
              "conditions": [
                {
                  "op": "fact",
                  "path": "/vendor/countryRisk",
                  "operator": "equals",
                  "value": "HIGH"
                },
                {

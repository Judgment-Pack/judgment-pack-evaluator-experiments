PACK:
```json
{
  "specVersion": "0.2.0-draft",
  "id": "https://example.org/judgment-packs/vendor-approval-policy",
  "version": "1.0.0",
  "title": "Vendor Approval Policy",
  "description": "Determines vendor onboarding spend requests under the supplied approval, review, rejection, override, evidence, and unreadable-input rules.",
  "decision": {
    "intent": "Determine the disposition of a vendor onboarding spend request.",
    "question": "Should this vendor onboarding spend request be approved, reviewed, enhanced-reviewed, rejected, or left unresolved?"
  },
  "evidenceRequirements": [
    {
      "id": "financial-evidence",
      "description": "Audited financial statements must be available before any determination may be issued.",
      "required": true,
      "kind": "document"
    },
    {
      "id": "insurance-certificate",
      "description": "Insurance certificate consulted only for qualifying LOW-country requests above 500000.00 and up to 2000000.00.",
      "required": false,
      "kind": "document"
    }
  ],
  "outcomes": [
    {
      "id": "approve",
      "label": "Approve"
    },
    {
      "id": "review",
      "label": "Review"
    },
    {
      "id": "enhanced-review",
      "label": "Enhanced review"
    },
    {
      "id": "reject",
      "label": "Reject"
    }
  ],
  "rules": [
    {
      "id": "r-sanctions-match",
      "description": "D1: reject a sanctions match.",
      "when": {
        "op": "fact",
        "path": "/vendor/sanctionsStatus",
        "operator": "equals",
        "value": "MATCH"
      },
      "outcome": "reject",
      "onUnknown": "ignore",
      "evidenceRequirementRefs": [
        "financial-evidence"
      ]
    },
    {
      "id": "r-critical-risk",
      "description": "D3: reject CLEAR requests with risk score at least 90.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "fact",
            "path": "/vendor/riskScore",
            "operator": "greater-than-or-equal",
            "value": "90"
          }
        ]
      },
      "outcome": "reject",
      "onUnknown": "ignore",
      "evidenceRequirementRefs": [
        "financial-evidence"
      ]
    },
    {
      "id": "r-high-country-elevated-risk",
      "description": "D4: reject CLEAR requests in a HIGH-risk country with risk score at least 70.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "fact",
            "path": "/vendor/countryRisk",
            "operator": "equals",
            "value": "HIGH"
          },
          {
            "op": "fact",
            "path": "/vendor/riskScore",
            "operator": "greater-than-or-equal",
            "value": "70"
          }
        ]
      },
      "outcome": "reject",
      "onUnknown": "ignore",
      "evidenceRequirementRefs": [
        "financial-evidence"
      ]
    },
    {
      "id": "r-prior-enforcement",
      "description": "D5: reject a CLEAR request where prior enforcement is recorded.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "fact",
            "path": "/vendor/priorEnforcement",
            "operator": "equals",
            "value": "yes"
          }
        ]
      },
      "outcome": "reject",
      "onUnknown": "ignore",
      "evidenceRequirementRefs": [
        "financial-evidence"
      ]
    },
    {
      "id": "r-low-small-approve",
      "description": "D6a: approve LOW-country requests below risk 40 with spend up to 500000.00.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "fact",
            "path": "/vendor/countryRisk",
            "operator": "equals",
            "value": "LOW"
          },
          {
            "op": "fact",
            "path": "/vendor/riskScore",
            "operator": "less-than",
            "value": "40"
          },
          {
            "op": "fact",
            "path": "/vendor/requestedSpend",
            "operator": "less-than-or-equal",
            "value": "500000.00"
          }
        ]
      },
      "outcome": "approve",
      "onUnknown": "ignore",
      "evidenceRequirementRefs": [
        "financial-evidence"
      ]
    },
    {
      "id": "r-low-insured-approve",
      "description": "D6b: approve qualifying LOW-country requests when insurance is available.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "fact",
            "path": "/vendor/countryRisk",
            "operator": "equals",
            "value": "LOW"
          },
          {
            "op": "fact",
            "path": "/vendor/riskScore",
            "operator": "less-than",
            "value": "40"
          },
          {
            "op": "fact",
            "path": "/vendor/requestedSpend",
            "operator": "greater-than",
            "value": "500000.00"
          },
          {
            "op": "fact",
            "path": "/vendor/requestedSpend",
            "operator": "less-than-or-equal",
            "value": "2000000.00"
          },
          {
            "op": "evidence-present",
            "evidenceRequirement": "insurance-certificate"
          }
        ]
      },
      "outcome": "approve",
      "onUnknown": "escalate",
      "evidenceRequirementRefs": [
        "financial-evidence",
        "insurance-certificate"
      ]
    },
    {
      "id": "r-low-uninsured-enhanced",
      "description": "D6b: enhanced review for a qualifying LOW-country request when insurance is absent.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "fact",
            "path": "/vendor/countryRisk",
            "operator": "equals",
            "value": "LOW"
          },
          {
            "op": "fact",
            "path": "/vendor/riskScore",
            "operator": "less-than",
            "value": "40"
          },
          {
            "op": "fact",
            "path": "/vendor/requestedSpend",
            "operator": "greater-than",
            "value": "500000.00"
          },
          {
            "op": "fact",
            "path": "/vendor/requestedSpend",
            "operator": "less-than-or-equal",
            "value": "2000000.00"
          },
          {
            "op": "not",
            "condition": {
              "op": "evidence-present",
              "evidenceRequirement": "insurance-certificate"
            }
          }
        ]
      },
      "outcome": "enhanced-review",
      "onUnknown": "escalate",
      "evidenceRequirementRefs": [
        "financial-evidence",
        "insurance-certificate"
      ]
    },
    {
      "id": "r-low-moderate-small-approve",
      "description": "D6c: approve LOW-country requests with risk 40 through 69 and spend up to 100000.00.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "fact",
            "path": "/vendor/countryRisk",
            "operator": "equals",
            "value": "LOW"
          },
          {
            "op": "fact",
            "path": "/vendor/riskScore",
            "operator": "greater-than-or-equal",
            "value": "40"
          },
          {
            "op": "fact",
            "path": "/vendor/riskScore",
            "operator": "less-than",
            "value": "70"
          },
          {
            "op": "fact",
            "path": "/vendor/requestedSpend",
            "operator": "less-than-or-equal",
            "value": "100000.00"
          }
        ]
      },
      "outcome": "approve",
      "onUnknown": "ignore",
      "evidenceRequirementRefs": [
        "financial-evidence"
      ]
    },
    {
      "id": "r-medium-small-approve",
      "description": "D7: approve MEDIUM-country requests below risk 40 with spend up to 100000.00.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "fact",
            "path": "/vendor/countryRisk",
            "operator": "equals",
            "value": "MEDIUM"
          },
          {
            "op": "fact",
            "path": "/vendor/riskScore",
            "operator": "less-than",
            "value": "40"
          },
          {
            "op": "fact",
            "path": "/vendor/requestedSpend",
            "operator": "less-than-or-equal",
            "value": "100000.00"
          }
        ]
      },
      "outcome": "approve",
      "onUnknown": "ignore",
      "evidenceRequirementRefs": [
        "financial-evidence"
      ]
    },
    {
      "id": "r-review",
      "description": "D8: review every otherwise-undetermined request with CLEAR screening.",
      "when": {
        "op": "fact",
        "path": "/vendor/sanctionsStatus",
        "operator": "equals",
        "value": "CLEAR"
      },
      "outcome": "review",
      "onUnknown": "ignore",
      "evidenceRequirementRefs": [
        "financial-evidence"
      ]
    },
    {
      "id": "r-unreadable-input",
      "description": "U1: block resolution where a policy-sensitive risk, spend, or country input is unreadable unless an invariant-result exception suppresses this rule.",
      "when": {
        "op": "not",
        "condition": {
          "op": "all",
          "conditions": [
            {
              "op": "any",
              "conditions": [
                {
                  "op": "fact",
                  "path": "/vendor/riskScore",
                  "operator": "less-than",
                  "value": "0"
                },
                {
                  "op": "fact",
                  "path": "/vendor/riskScore",
                  "operator": "greater-than-or-equal",
                  "value": "0"
                }
              ]
            },
            {
              "op": "any",
              "conditions": [
                {
                  "op": "fact",
                  "path": "/vendor/requestedSpend",
                  "operator": "less-than",
                  "value": "0"
                },
                {
                  "op": "fact",
                  "path": "/vendor/requestedSpend",
                  "operator": "greater-than-or-equal",
                  "value": "0"
                }
              ]
            },
            {
              "op": "fact",
              "path": "/vendor/countryRisk",
              "operator": "in",
              "value": [
                "LOW",
                "MEDIUM",
                "HIGH"
              ]
            }
          ]
        }
      },
      "outcome": "review",
      "onUnknown": "escalate",
      "evidenceRequirementRefs": [
        "financial-evidence"
      ]
    }
  ],
  "exceptions": [
    {
      "id": "x-large-high-exposure",
      "description": "O3: directly escalate a CLEAR request in a HIGH-risk country with spend above 2000000.00.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "fact",
            "path": "/vendor/countryRisk",
            "operator": "equals",
            "value": "HIGH"
          },
          {
            "op": "fact",
            "path": "/vendor/requestedSpend",
            "operator": "greater-than",
            "value": "2000000.00"
          }
        ]
      },
      "effect": "escalate",
      "onUnknown": "escalate"
    },
    {
      "id": "x-critical-supplier",
      "description": "O2: force review for a critical supplier with CLEAR screening unless O3 applies or is potentially applicable.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "fact",
            "path": "/vendor/criticalSupplier",
            "operator": "equals",
            "value": "yes"
          }
        ]
      },
      "effect": "force-outcome",
      "outcome": "review",
      "onUnknown": "ignore"
    },
    {
      "id": "x-new-vendor-force-review",
      "description": "O1: force review when a new vendor otherwise satisfies D6c.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "fact",
            "path": "/vendor/newVendor",
            "operator": "equals",
            "value": "yes"
          },
          {
            "op": "fact",
            "path": "/vendor/countryRisk",
            "operator": "equals",
            "value": "LOW"
          },
          {
            "op": "fact",
            "path": "/vendor/riskScore",
            "operator": "greater-than-or-equal",
            "value": "40"
          },
          {
            "op": "fact",
            "path": "/vendor/riskScore",
            "operator": "less-than",
            "value": "70"
          },
          {
            "op": "fact",
            "path": "/vendor/requestedSpend",
            "operator": "less-than-or-equal",
            "value": "100000.00"
          }
        ]
      },
      "effect": "force-outcome",
      "outcome": "review",
      "onUnknown": "ignore"
    },
    {
      "id": "x-prior-suppress-low-small",
      "description": "D5 suppresses D6a.",
      "when": {
        "op": "fact",
        "path": "/vendor/priorEnforcement",
        "operator": "equals",
        "value": "yes"
      },
      "effect": "suppress-rule",
      "targetRule": "r-low-small-approve",
      "onUnknown": "ignore"
    },
    {
      "id": "x-prior-suppress-low-insured",
      "description": "D5 suppresses the approval limb of D6b.",
      "when": {
        "op": "fact",
        "path": "/vendor/priorEnforcement",
        "operator": "equals",
        "value": "yes"
      },
      "effect": "suppress-rule",
      "targetRule": "r-low-insured-approve",
      "onUnknown": "ignore"
    },
    {
      "id": "x-prior-suppress-low-uninsured",
      "description": "D5 suppresses the enhanced-review limb of D6b.",
      "when": {
        "op": "fact",
        "path": "/vendor/priorEnforcement",
        "operator": "equals",
        "value": "yes"
      },
      "effect": "suppress-rule",
      "targetRule": "r-low-uninsured-enhanced",
      "onUnknown": "ignore"
    },
    {
      "id": "x-prior-suppress-low-moderate",
      "description": "D5 suppresses D6c.",
      "when": {
        "op": "fact",
        "path": "/vendor/priorEnforcement",
        "operator": "equals",
        "value": "yes"
      },
      "effect": "suppress-rule",
      "targetRule": "r-low-moderate-small-approve",
      "onUnknown": "ignore"
    },
    {
      "id": "x-prior-suppress-medium",
      "description": "D5 suppresses D7.",
      "when": {
        "op": "fact",
        "path": "/vendor/priorEnforcement",
        "operator": "equals",
        "value": "yes"
      },
      "effect": "suppress-rule",
      "targetRule": "r-medium-small-approve",
      "onUnknown": "ignore"
    },
    {
      "id": "x-new-suppress-d6c",
      "description": "O1 suppresses D6c for a reported new vendor.",
      "when": {
        "op": "fact",
        "path": "/vendor/newVendor",
        "operator": "equals",
        "value": "yes"
      },
      "effect": "suppress-rule",
      "targetRule": "r-low-moderate-small-approve",
      "onUnknown": "ignore"
    },
    {
      "id": "x-d1-suppress-review",
      "description": "D1 precedes D8.",
      "when": {
        "op": "fact",
        "path": "/vendor/sanctionsStatus",
        "operator": "equals",
        "value": "MATCH"
      },
      "effect": "suppress-rule",
      "targetRule": "r-review",
      "onUnknown": "ignore"
    },
    {
      "id": "x-d3-suppress-review",
      "description": "D3 precedes D8.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "fact",
            "path": "/vendor/riskScore",
            "operator": "greater-than-or-equal",
            "value": "90"
          }
        ]
      },
      "effect": "suppress-rule",
      "targetRule": "r-review",
      "onUnknown": "ignore"
    },
    {
      "id": "x-d4-suppress-review",
      "description": "D4 precedes D8.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "fact",
            "path": "/vendor/countryRisk",
            "operator": "equals",
            "value": "HIGH"
          },
          {
            "op": "fact",
            "path": "/vendor/riskScore",
            "operator": "greater-than-or-equal",
            "value": "70"
          }
        ]
      },
      "effect": "suppress-rule",
      "targetRule": "r-review",
      "onUnknown": "ignore"
    },
    {
      "id": "x-d5-suppress-review",
      "description": "D5 precedes D8.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "fact",
            "path": "/vendor/priorEnforcement",
            "operator": "equals",
            "value": "yes"
          }
        ]
      },
      "effect": "suppress-rule",
      "targetRule": "r-review",
      "onUnknown": "ignore"
    },
    {
      "id": "x-d6a-suppress-review",
      "description": "D6a decides its request before D8.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "fact",
            "path": "/vendor/countryRisk",
            "operator": "equals",
            "value": "LOW"
          },
          {
            "op": "fact",
            "path": "/vendor/riskScore",
            "operator": "less-than",
            "value": "40"
          },
          {
            "op": "fact",
            "path": "/vendor/requestedSpend",
            "operator": "less-than-or-equal",
            "value": "500000.00"
          }
        ]
      },
      "effect": "suppress-rule",
      "targetRule": "r-review",
      "onUnknown": "ignore"
    },
    {
      "id": "x-d6b-suppress-review",
      "description": "D6b decides its range, including absent or unreported insurance, before D8.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "fact",
            "path": "/vendor/countryRisk",
            "operator": "equals",
            "value": "LOW"
          },
          {
            "op": "fact",
            "path": "/vendor/riskScore",
            "operator": "less-than",
            "value": "40"
          },
          {
            "op": "fact",
            "path": "/vendor/requestedSpend",
            "operator": "greater-than",
            "value": "500000.00"
          },
          {
            "op": "fact",
            "path": "/vendor/requestedSpend",
            "operator": "less-than-or-equal",
            "value": "2000000.00"
          }
        ]
      },
      "effect": "suppress-rule",
      "targetRule": "r-review",
      "onUnknown": "ignore"
    },
    {
      "id": "x-d6c-suppress-review",
      "description": "The D6c range is removed from D8; O1 separately forces review for reported new vendors.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/vendor/sanctionsStatus",
            "operator": "equals",
            "value": "CLEAR"
          },
          {
            "op": "fact",
            "path": "/vendor/countryRisk",
            "operator": "equals",
            "value": "LOW"
          },
          {

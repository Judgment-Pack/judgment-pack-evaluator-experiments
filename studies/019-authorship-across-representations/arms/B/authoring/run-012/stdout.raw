POLICY:
```rego
package study

financial_evidence := object.get(input.evidence, "financial-evidence", "unreported")

decision := {
	"disposition": "unresolved",
	"reasons": ["missing-required-evidence"],
} if {
	financial_evidence == "absent"
}

decision := {
	"disposition": "unresolved",
	"reasons": ["unknown"],
} if {
	financial_evidence == "unreported"
}

decision := {
	"disposition": "reject",
	"reasons": [],
} if {
	financial_evidence == "present"
	input.vendor.sanctionsStatus == "MATCH"
}

decision := {
	"disposition": "unresolved",
	"reasons": ["no-match"],
} if {
	financial_evidence == "present"
	input.vendor.sanctionsStatus == "UNKNOWN"
}

decision := result if {
	financial_evidence == "present"
	input.vendor.sanctionsStatus == "CLEAR"
	count(possible_outcomes) == 1
	some result in possible_outcomes
}

decision := {
	"disposition": "unresolved",
	"reasons": ["unknown"],
} if {
	financial_evidence == "present"
	input.vendor.sanctionsStatus == "CLEAR"
	count(possible_outcomes) > 1
}

risk_values := [input.vendor.riskScore] if {
	"riskScore" in input.vendor
}

risk_values := [0, 39, 40, 69, 70, 89, 90, 100] if {
	not "riskScore" in input.vendor
}

spend_values := [input.vendor.requestedSpend] if {
	"requestedSpend" in input.vendor
}

spend_values := [
	0,
	100000,
	100000.01,
	500000,
	500000.01,
	2000000,
	2000000.01,
	10000000,
] if {
	not "requestedSpend" in input.vendor
}

country_values := [input.vendor.countryRisk] if {
	"countryRisk" in input.vendor
}

country_values := ["LOW", "MEDIUM", "HIGH"] if {
	not "countryRisk" in input.vendor
}

possible_outcomes := {
	result |
	some risk in risk_values
	some spend in spend_values
	some country in country_values
	vendor := object.union(input.vendor, {
		"riskScore": risk,
		"requestedSpend": spend,
		"countryRisk": country,
	})
	result := completed_outcome(vendor)
}

# O3: large exposure in a high-risk country.
completed_outcome(vendor) := {
	"disposition": "unresolved",
	"reasons": ["exception-escalation"],
} if {
	vendor.countryRisk == "HIGH"
	vendor.requestedSpend > 2000000
} else := {
	"disposition": "review",
	"reasons": [],
} if {
	object.get(vendor, "criticalSupplier", "no") == "yes"
} else := {
	"disposition": "reject",
	"reasons": [],
} if {
	vendor.riskScore >= 90
} else := {
	"disposition": "reject",
	"reasons": [],
} if {
	vendor.countryRisk == "HIGH"
	vendor.riskScore >= 70
} else := {
	"disposition": "reject",
	"reasons": [],
} if {
	object.get(vendor, "priorEnforcement", "no") == "yes"
} else := {
	"disposition": "approve",
	"reasons": [],
} if {
	vendor.countryRisk == "LOW"
	vendor.riskScore < 40
	vendor.requestedSpend <= 500000
} else := {
	"disposition": "approve",
	"reasons": [],
} if {
	vendor.countryRisk == "LOW"
	vendor.riskScore < 40
	vendor.requestedSpend > 500000
	vendor.requestedSpend <= 2000000
	object.get(input.evidence, "insurance-certificate", "unreported") == "present"
} else := {
	"disposition": "enhanced-review",
	"reasons": [],
} if {
	vendor.countryRisk == "LOW"
	vendor.riskScore < 40
	vendor.requestedSpend > 500000
	vendor.requestedSpend <= 2000000
	object.get(input.evidence, "insurance-certificate", "unreported") == "absent"
} else := {
	"disposition": "unresolved",
	"reasons": ["unknown"],
} if {
	vendor.countryRisk == "LOW"
	vendor.riskScore < 40
	vendor.requestedSpend > 500000
	vendor.requestedSpend <= 2000000
	object.get(input.evidence, "insurance-certificate", "unreported") == "unreported"
} else := {
	"disposition": "approve",
	"reasons": [],
} if {
	vendor.countryRisk == "LOW"
	vendor.riskScore >= 40
	vendor.riskScore < 70
	vendor.requestedSpend <= 100000
	object.get(vendor, "newVendor", "no") != "yes"
} else := {
	"disposition": "approve",
	"reasons": [],
} if {
	vendor.countryRisk == "MEDIUM"
	vendor.riskScore < 40
	vendor.requestedSpend <= 100000
} else := {
	"disposition": "review",
	"reasons": [],
}
```

TESTS:
```rego
package study_test

import data.study

present_financial := {"financial-evidence": "present"}

test_missing_financial_evidence_precedes_rejection if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["missing-required-evidence"],
	} with input as {
		"vendor": {
			"sanctionsStatus": "MATCH",
		},
		"evidence": {
			"financial-evidence": "absent",
		},
	}
}

test_unreported_financial_evidence_is_unknown if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["unknown"],
	} with input as {
		"vendor": {
			"sanctionsStatus": "MATCH",
		},
		"evidence": {},
	}
}

test_sanctions_match_rejects if {
	study.decision == {
		"disposition": "reject",
		"reasons": [],
	} with input as {
		"vendor": {
			"sanctionsStatus": "MATCH",
		},
		"evidence": present_financial,
	}
}

test_unknown_sanctions_has_no_match if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["no-match"],
	} with input as {
		"vendor": {
			"sanctionsStatus": "UNKNOWN",
		},
		"evidence": present_financial,
	}
}

test_o3_precedes_critical_supplier_override if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["exception-escalation"],
	} with input as {
		"vendor": {
			"riskScore": 95,
			"requestedSpend": 2000000.01,
			"sanctionsStatus": "CLEAR",
			"countryRisk": "HIGH",
			"criticalSupplier": "yes",
			"priorEnforcement": "yes",
		},
		"evidence": present_financial,
	}
}

test_critical_supplier_reviews_instead_of_rejecting if {
	study.decision == {
		"disposition": "review",
		"reasons": [],
	} with input as {
		"vendor": {
			"riskScore": 95,
			"requestedSpend": 100,
			"sanctionsStatus": "CLEAR",
			"countryRisk": "LOW",
			"criticalSupplier": "yes",
		},
		"evidence": present_financial,
	}
}

test_high_country_rejects_at_risk_70 if {

POLICY:
```rego
package study

vendor := object.get(input, "vendor", {})
evidence := object.get(input, "evidence", {})

financial_evidence := object.get(evidence, "financial-evidence", "unreported")
insurance_certificate := object.get(evidence, "insurance-certificate", "unreported")

critical_supplier := object.get(vendor, "criticalSupplier", "no")
prior_enforcement := object.get(vendor, "priorEnforcement", "no")
new_vendor := object.get(vendor, "newVendor", "no")

risk_values contains vendor.riskScore if {
	"riskScore" in vendor
}

risk_values contains risk if {
	not "riskScore" in vendor
	some risk in {0, 39, 40, 69, 70, 89, 90, 100}
}

spend_values contains vendor.requestedSpend if {
	"requestedSpend" in vendor
}

spend_values contains spend if {
	not "requestedSpend" in vendor
	some spend in {0, 100000, 500000, 500000.01, 2000000, 2000000.01, 10000000}
}

country_values contains vendor.countryRisk if {
	"countryRisk" in vendor
}

country_values contains country if {
	not "countryRisk" in vendor
	some country in {"LOW", "MEDIUM", "HIGH"}
}

# P1: financial evidence is an absolute precondition.
decision := {
	"disposition": "unresolved",
	"reasons": ["missing-required-evidence"],
} if {
	financial_evidence == "absent"
}

decision := {
	"disposition": "unresolved",
	"reasons": ["unknown"],
} if {
	financial_evidence == "unreported"
}

# D1 applies before unreadable risk, spend, or country inputs are considered.
decision := {
	"disposition": "reject",
	"reasons": [],
} if {
	financial_evidence == "present"
	vendor.sanctionsStatus == "MATCH"
}

# D2: UNKNOWN is a present sanctions result, but no determination is issued.
decision := {
	"disposition": "unresolved",
	"reasons": ["no-match"],
} if {
	financial_evidence == "present"
	vendor.sanctionsStatus == "UNKNOWN"
}

# For CLEAR screening, U1 issues the outcome only when every readable
# completion of omitted risk, spend, and country inputs has the same outcome.
clear_outcomes := {result |
	some risk in risk_values
	some spend in spend_values
	some country in country_values
	result := clear_outcome(risk, spend, country)
}

decision := result if {
	financial_evidence == "present"
	vendor.sanctionsStatus == "CLEAR"
	count(clear_outcomes) == 1
	some result in clear_outcomes
}

decision := {
	"disposition": "unresolved",
	"reasons": ["unknown"],
} if {
	financial_evidence == "present"
	vendor.sanctionsStatus == "CLEAR"
	count(clear_outcomes) > 1
}

# O3 precedes O2 and every determination clause.
clear_outcome(risk, spend, country) := {
	"disposition": "unresolved",
	"reasons": ["exception-escalation"],
} if {
	country == "HIGH"
	spend > 2000000
} else := {
	"disposition": "review",
	"reasons": [],
} if {
	critical_supplier == "yes"
} else := {
	"disposition": "reject",
	"reasons": [],
} if {
	risk >= 90
} else := {
	"disposition": "reject",
	"reasons": [],
} if {
	country == "HIGH"
	risk >= 70
} else := {
	"disposition": "reject",
	"reasons": [],
} if {
	prior_enforcement == "yes"
} else := {
	"disposition": "approve",
	"reasons": [],
} if {
	country == "LOW"
	risk < 40
	spend <= 500000
} else := {
	"disposition": "approve",
	"reasons": [],
} if {
	country == "LOW"
	risk < 40
	spend > 500000
	spend <= 2000000
	insurance_certificate == "present"
} else := {
	"disposition": "enhanced-review",
	"reasons": [],
} if {
	country == "LOW"
	risk < 40
	spend > 500000
	spend <= 2000000
	insurance_certificate == "absent"
} else := {
	"disposition": "unresolved",
	"reasons": ["unknown"],
} if {
	country == "LOW"
	risk < 40
	spend > 500000
	spend <= 2000000
	insurance_certificate == "unreported"
} else := {
	"disposition": "approve",
	"reasons": [],
} if {
	country == "LOW"
	risk >= 40
	risk < 70
	spend <= 100000
	new_vendor != "yes"
} else := {
	"disposition": "approve",
	"reasons": [],
} if {
	country == "MEDIUM"
	risk < 40
	spend <= 100000
} else := {
	"disposition": "review",
	"reasons": [],
}
```

TESTS:
```rego
package study_test

import data.study

present_evidence := {"financial-evidence": "present"}

test_p1_absent_financial_evidence_blocks_rejection if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["missing-required-evidence"],
	} with input as {
		"vendor": {
			"sanctionsStatus": "MATCH",
			"riskScore": 100,
			"requestedSpend": 10000000,
			"countryRisk": "HIGH",
		},
		"evidence": {"financial-evidence": "absent"},
	}
}

test_p1_unreported_financial_evidence_is_unknown if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["unknown"],
	} with input as {
		"vendor": {"sanctionsStatus": "MATCH"},
		"evidence": {},
	}
}

test_d1_sanctions_match_rejects_despite_other_omissions if {
	study.decision == {
		"disposition": "reject",
		"reasons": [],
	} with input as {
		"vendor": {
			"sanctionsStatus": "MATCH",
			"criticalSupplier": "yes",
		},
		"evidence": present_evidence,
	}
}

test_d2_unknown_sanctions_is_no_match if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["no-match"],
	} with input as {
		"vendor": {
			"sanctionsStatus": "UNKNOWN",
			"criticalSupplier": "yes",
		},
		"evidence": present_evidence,
	}
}

test_o3_precedes_critical_supplier_and_rejection if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["exception-escalation"],
	} with input as {
		"vendor": {
			"sanctionsStatus": "CLEAR",
			"countryRisk": "HIGH",
			"riskScore": 95,
			"requestedSpend": 2000000.01,
			"criticalSupplier": "yes",
			"priorEnforcement": "yes",
		},
		"evidence": present_evidence,
	}
}

test_o3_boundary_at_two_million_does_not_escalate if {
	study.decision == {
		"disposition": "reject",
		"reasons": [],
	} with input as {
		"vendor": {
			"sanctionsStatus": "CLEAR",
			"countryRisk": "HIGH",
			"riskScore": 70,
			"requestedSpend": 2000000,
		},
		"evidence": present_evidence,
	}
}

test_o2_changes_automatic_rejection_to_review if {
	study.decision == {
		"disposition": "review",
		"reasons": [],
	} with input as {
		"vendor": {
			"sanctionsStatus": "CLEAR",
			"countryRisk": "LOW",
			"riskScore": 95,
			"requestedSpend": 100,
			"criticalSupplier": "yes",
		},
		"evidence": present_evidence,
	}
}

test_o2_displaces_unreported_insurance_limb if {
	study.decision == {
		"disposition": "review",
		"reasons": [],
	} with input as {
		"vendor": {
			"sanctionsStatus": "CLEAR",
			"countryRisk": "LOW",
			"riskScore": 20,
			"requestedSpend": 600000,
			"criticalSupplier": "yes",
		},
		"evidence": present_evidence,
	}
}

test_d3_rejects_at_ninety if {
	study.decision.disposition == "reject" with input as {
		"vendor": {
			"sanctionsStatus": "CLEAR",
			"countryRisk": "LOW",
			"riskScore": 90,
			"requestedSpend": 0,

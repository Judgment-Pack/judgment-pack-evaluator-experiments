POLICY:
```rego
package study

decision := {
	"disposition": "unresolved",
	"reasons": ["missing-required-evidence"],
} if {
	object.get(input.evidence, "financial-evidence", "unreported") == "absent"
}

decision := {
	"disposition": "unresolved",
	"reasons": ["unknown"],
} if {
	object.get(input.evidence, "financial-evidence", "unreported") == "unreported"
}

decision := {
	"disposition": "reject",
	"reasons": [],
} if {
	input.evidence["financial-evidence"] == "present"
	input.vendor.sanctionsStatus == "MATCH"
}

decision := {
	"disposition": "unresolved",
	"reasons": ["no-match"],
} if {
	input.evidence["financial-evidence"] == "present"
	input.vendor.sanctionsStatus == "UNKNOWN"
}

decision := result if {
	input.evidence["financial-evidence"] == "present"
	input.vendor.sanctionsStatus == "CLEAR"
	count(candidate_outcomes) == 1
	some outcome_value in candidate_outcomes
	result := result_for_outcome(outcome_value)
}

decision := {
	"disposition": "unresolved",
	"reasons": ["unknown"],
} if {
	input.evidence["financial-evidence"] == "present"
	input.vendor.sanctionsStatus == "CLEAR"
	count(candidate_outcomes) > 1
}

candidate_outcomes := {
	outcome_value |
	some risk_value in risk_values
	some spend_value in spend_values
	some country_value in country_values
	outcome_value := readable_outcome(risk_value, spend_value, country_value)
}

risk_values := [risk_value] if {
	risk_value := object.get(input.vendor, "riskScore", -1)
	risk_value != -1
} else := [0, 39, 40, 69, 70, 89, 90, 100]

spend_values := [spend_value] if {
	spend_value := object.get(input.vendor, "requestedSpend", -1)
	spend_value != -1
} else := [
	0,
	100000,
	100000.01,
	500000,
	500000.01,
	2000000,
	2000000.01,
	10000000,
]

country_values := [country_value] if {
	country_value := object.get(input.vendor, "countryRisk", "")
	country_value != ""
} else := ["LOW", "MEDIUM", "HIGH"]

readable_outcome(risk_value, spend_value, country_value) := "exception-escalation" if {
	country_value == "HIGH"
	spend_value > 2000000
} else := "review" if {
	object.get(input.vendor, "criticalSupplier", "no") == "yes"
} else := "reject" if {
	risk_value >= 90
} else := "reject" if {
	country_value == "HIGH"
	risk_value >= 70
} else := "reject" if {
	object.get(input.vendor, "priorEnforcement", "no") == "yes"
} else := "approve" if {
	country_value == "LOW"
	risk_value < 40
	spend_value <= 500000
} else := low_country_insured_outcome if {
	country_value == "LOW"
	risk_value < 40
	spend_value > 500000
	spend_value <= 2000000
	low_country_insured_outcome := insurance_outcome
} else := "approve" if {
	country_value == "LOW"
	risk_value >= 40
	risk_value < 70
	spend_value <= 100000
	object.get(input.vendor, "newVendor", "no") != "yes"
} else := "approve" if {
	country_value == "MEDIUM"
	risk_value < 40
	spend_value <= 100000
} else := "review"

insurance_outcome := "approve" if {
	object.get(input.evidence, "insurance-certificate", "unreported") == "present"
} else := "enhanced-review" if {
	object.get(input.evidence, "insurance-certificate", "unreported") == "absent"
} else := "unknown"

result_for_outcome("approve") := {
	"disposition": "approve",
	"reasons": [],
}

result_for_outcome("review") := {
	"disposition": "review",
	"reasons": [],
}

result_for_outcome("enhanced-review") := {
	"disposition": "enhanced-review",
	"reasons": [],
}

result_for_outcome("reject") := {
	"disposition": "reject",
	"reasons": [],
}

result_for_outcome("unknown") := {
	"disposition": "unresolved",
	"reasons": ["unknown"],
}

result_for_outcome("exception-escalation") := {
	"disposition": "unresolved",
	"reasons": ["exception-escalation"],
}
```

TESTS:
```rego
package study_test

import data.study

financial_present := {"financial-evidence": "present"}

test_p1_absent_blocks_match_rejection if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["missing-required-evidence"],
	} with input as {
		"vendor": {"sanctionsStatus": "MATCH"},
		"evidence": {"financial-evidence": "absent"},
	}
}

test_p1_unreported_is_unknown if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["unknown"],
	} with input as {
		"vendor": {"sanctionsStatus": "MATCH"},
		"evidence": {},
	}
}

test_d1_match_rejects if {
	study.decision == {
		"disposition": "reject",
		"reasons": [],
	} with input as {
		"vendor": {"sanctionsStatus": "MATCH"},
		"evidence": financial_present,
	}
}

test_d2_unknown_screening_has_no_match if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["no-match"],
	} with input as {
		"vendor": {"sanctionsStatus": "UNKNOWN"},
		"evidence": financial_present,
	}
}

test_d3_rejects_at_90 if {
	study.decision.disposition == "reject" with input as {
		"vendor": {
			"sanctionsStatus": "CLEAR",
			"riskScore": 90,
			"requestedSpend": 100,
			"countryRisk": "LOW",
		},
		"evidence": financial_present,
	}
}

test_d4_high_country_rejects_at_70 if {
	study.decision.disposition == "reject" with input as {
		"vendor": {
			"sanctionsStatus": "CLEAR",
			"riskScore": 70,
			"requestedSpend": 100,
			"countryRisk": "HIGH",
		},
		"evidence": financial_present,
	}
}

test_d5_prior_enforcement_rejects if {
	study.decision.disposition == "reject" with input as {
		"vendor": {
			"sanctionsStatus": "CLEAR",
			"riskScore": 1,
			"requestedSpend": 1,
			"countryRisk": "LOW",
			"priorEnforcement": "yes",
		},
		"evidence": financial_present,
	}
}

test_d6a_inclusive_spend_boundary_approves if {
	study.decision.disposition == "approve" with input as {
		"vendor": {
			"sanctionsStatus": "CLEAR",
			"riskScore": 39,
			"requestedSpend": 500000,
			"countryRisk": "LOW",
		},
		"evidence": financial_present,
	}
}

test_d6b_present_insurance_approves if {
	study.decision.disposition == "approve" with input as {
		"vendor": {
			"sanctionsStatus": "CLEAR",
			"riskScore": 39,
			"requestedSpend": 2000000,
			"countryRisk": "LOW",
		},
		"evidence": {
			"financial-evidence": "present",
			"insurance-certificate": "present",
		},
	}
}

test_d6b_absent_insurance_enhanced_review if {
	study.decision.disposition == "enhanced-review" with input as {
		"vendor": {
			"sanctionsStatus": "CLEAR",
			"riskScore": 20,
			"requestedSpend": 500000.01,
			"countryRisk": "LOW",
		},
		"evidence": {
			"financial-evidence": "present",
			"insurance-certificate": "absent",
		},
	}
}

test_d6b_unreported_insurance_is_unknown if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["unknown"],
	} with input as {
		"vendor": {
			"sanctionsStatus": "CLEAR",
			"riskScore": 20,
			"requestedSpend": 1000000,
			"countryRisk": "LOW",
		},
		"evidence": financial_present,
	}
}

test_d6c_approves_at_boundaries if {

POLICY:
```rego
package study

# P1: financial evidence is required before any other clause applies.
decision := {
	"disposition": "unresolved",
	"reasons": ["missing-required-evidence"],
} if {
	object.get(input.evidence, "financial-evidence", "__unreported__") == "absent"
}

decision := {
	"disposition": "unresolved",
	"reasons": ["unknown"],
} if {
	object.get(input.evidence, "financial-evidence", "__unreported__") == "__unreported__"
}

# U1: enumerate every readable assignment for omitted risk, spend, and
# country inputs. Issue an outcome only when every assignment agrees.
decision := outcome if {
	object.get(input.evidence, "financial-evidence", "__unreported__") == "present"
	outcomes := {
		candidate_outcome(input.vendor, risk, spend, country) |
		some risk in risk_values(input.vendor)
		some spend in spend_values(input.vendor)
		some country in country_values(input.vendor)
	}
	count(outcomes) == 1
	some outcome in outcomes
}

risk_values(vendor) := [vendor.riskScore] if {
	"riskScore" in vendor
} else := numbers.range(0, 100)

# These representatives cover every spend interval whose members can produce
# distinct policy outcomes.
spend_values(vendor) := [vendor.requestedSpend] if {
	"requestedSpend" in vendor
} else := [
	0,
	100000,
	100000.01,
	500000,
	500000.01,
	2000000,
	2000000.01,
	10000000,
]

country_values(vendor) := [vendor.countryRisk] if {
	"countryRisk" in vendor
} else := ["LOW", "MEDIUM", "HIGH"]

candidate_outcome(vendor, risk, spend, country) := {
	"disposition": "reject",
	"reasons": [],
} if {
	vendor.sanctionsStatus == "MATCH"
} else := {
	"disposition": "unresolved",
	"reasons": ["no-match"],
} if {
	vendor.sanctionsStatus == "UNKNOWN"
} else := {
	"disposition": "unresolved",
	"reasons": ["exception-escalation"],
} if {
	vendor.sanctionsStatus == "CLEAR"
	country == "HIGH"
	spend > 2000000
} else := {
	"disposition": "review",
	"reasons": [],
} if {
	vendor.sanctionsStatus == "CLEAR"
	object.get(vendor, "criticalSupplier", "no") == "yes"
} else := {
	"disposition": "reject",
	"reasons": [],
} if {
	vendor.sanctionsStatus == "CLEAR"
	risk >= 90
} else := {
	"disposition": "reject",
	"reasons": [],
} if {
	vendor.sanctionsStatus == "CLEAR"
	country == "HIGH"
	risk >= 70
} else := {
	"disposition": "reject",
	"reasons": [],
} if {
	vendor.sanctionsStatus == "CLEAR"
	object.get(vendor, "priorEnforcement", "no") == "yes"
} else := {
	"disposition": "approve",
	"reasons": [],
} if {
	vendor.sanctionsStatus == "CLEAR"
	object.get(vendor, "priorEnforcement", "no") != "yes"
	country == "LOW"
	risk < 40
	spend <= 500000
} else := {
	"disposition": "approve",
	"reasons": [],
} if {
	vendor.sanctionsStatus == "CLEAR"
	object.get(vendor, "priorEnforcement", "no") != "yes"
	country == "LOW"
	risk < 40
	spend > 500000
	spend <= 2000000
	object.get(input.evidence, "insurance-certificate", "__unreported__") == "present"
} else := {
	"disposition": "enhanced-review",
	"reasons": [],
} if {
	vendor.sanctionsStatus == "CLEAR"
	object.get(vendor, "priorEnforcement", "no") != "yes"
	country == "LOW"
	risk < 40
	spend > 500000
	spend <= 2000000
	object.get(input.evidence, "insurance-certificate", "__unreported__") == "absent"
} else := {
	"disposition": "unresolved",
	"reasons": ["unknown"],
} if {
	vendor.sanctionsStatus == "CLEAR"
	object.get(vendor, "priorEnforcement", "no") != "yes"
	country == "LOW"
	risk < 40
	spend > 500000
	spend <= 2000000
	object.get(input.evidence, "insurance-certificate", "__unreported__") == "__unreported__"
} else := {
	"disposition": "approve",
	"reasons": [],
} if {
	vendor.sanctionsStatus == "CLEAR"
	object.get(vendor, "priorEnforcement", "no") != "yes"
	country == "LOW"
	risk >= 40
	risk < 70
	spend <= 100000
	object.get(vendor, "newVendor", "no") != "yes"
} else := {
	"disposition": "approve",
	"reasons": [],
} if {
	vendor.sanctionsStatus == "CLEAR"
	object.get(vendor, "priorEnforcement", "no") != "yes"
	country == "MEDIUM"
	risk < 40
	spend <= 100000
} else := {
	"disposition": "review",
	"reasons": [],
} if {
	vendor.sanctionsStatus == "CLEAR"
}
```

TESTS:
```rego
package study_test

import data.study

present_financial := {
	"financial-evidence": "present",
}

test_missing_financial_evidence_precedes_sanctions_match if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["missing-required-evidence"],
	} with input as {
		"vendor": {
			"sanctionsStatus": "MATCH",
		},
		"evidence": {
			"financial-evidence": "absent",
		},
	}
}

test_unreported_financial_evidence_is_unknown if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["unknown"],
	} with input as {
		"vendor": {
			"sanctionsStatus": "CLEAR",
			"riskScore": 1,
			"requestedSpend": 1,
			"countryRisk": "LOW",
		},
		"evidence": {},
	}
}

test_sanctions_match_rejects_despite_unreadable_numeric_inputs if {
	study.decision == {
		"disposition": "reject",
		"reasons": [],
	} with input as {
		"vendor": {
			"sanctionsStatus": "MATCH",
		},
		"evidence": present_financial,
	}
}

test_unknown_sanctions_has_no_match_ground if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["no-match"],
	} with input as {
		"vendor": {
			"sanctionsStatus": "UNKNOWN",
		},
		"evidence": present_financial,
	}
}

test_o3_escalates_before_critical_supplier_override if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["exception-escalation"],
	} with input as {
		"vendor": {
			"sanctionsStatus": "CLEAR",
			"riskScore": 95,
			"requestedSpend": 2000000.01,
			"countryRisk": "HIGH",
			"criticalSupplier": "yes",
			"priorEnforcement": "yes",

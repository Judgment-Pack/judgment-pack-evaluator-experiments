POLICY:
```rego
package study

missing_financial_evidence if {
	object.get(input.evidence, "financial-evidence", "unreported") == "absent"
}

unreported_financial_evidence if {
	object.get(input.evidence, "financial-evidence", "unreported") == "unreported"
}

decision := {
	"disposition": "unresolved",
	"reasons": ["missing-required-evidence"],
} if {
	missing_financial_evidence
}

decision := {
	"disposition": "unresolved",
	"reasons": ["unknown"],
} if {
	unreported_financial_evidence
}

decision := {
	"disposition": "reject",
	"reasons": [],
} if {
	input.evidence["financial-evidence"] == "present"
	input.vendor.sanctionsStatus == "MATCH"
}

decision := {
	"disposition": "unresolved",
	"reasons": ["no-match"],
} if {
	input.evidence["financial-evidence"] == "present"
	input.vendor.sanctionsStatus == "UNKNOWN"
}

decision := result if {
	input.evidence["financial-evidence"] == "present"
	input.vendor.sanctionsStatus == "CLEAR"
	results := {
		candidate |
		some risk in candidate_risk_scores
		some spend in candidate_spends
		some country in candidate_countries
		candidate := readable_outcome(risk, spend, country)
	}
	count(results) == 1
	some result in results
}

decision := {
	"disposition": "unresolved",
	"reasons": ["unknown"],
} if {
	input.evidence["financial-evidence"] == "present"
	input.vendor.sanctionsStatus == "CLEAR"
	results := {
		candidate |
		some risk in candidate_risk_scores
		some spend in candidate_spends
		some country in candidate_countries
		candidate := readable_outcome(risk, spend, country)
	}
	count(results) > 1
}

candidate_risk_scores contains risk if {
	risk := input.vendor.riskScore
}

candidate_risk_scores contains risk if {
	object.get(input.vendor, "riskScore", "unreadable") == "unreadable"
	some risk in {0, 39, 40, 69, 70, 89, 90, 100}
}

candidate_spends contains spend if {
	spend := input.vendor.requestedSpend
}

candidate_spends contains spend if {
	object.get(input.vendor, "requestedSpend", "unreadable") == "unreadable"
	some spend in {
		0,
		100000,
		100000.01,
		500000,
		500000.01,
		2000000,
		2000000.01,
		10000000,
	}
}

candidate_countries contains country if {
	country := input.vendor.countryRisk
}

candidate_countries contains country if {
	object.get(input.vendor, "countryRisk", "unreadable") == "unreadable"
	some country in {"LOW", "MEDIUM", "HIGH"}
}

readable_outcome(_, spend, "HIGH") := {
	"disposition": "unresolved",
	"reasons": ["exception-escalation"],
} if {
	spend > 2000000
} else := {
	"disposition": "review",
	"reasons": [],
} if {
	object.get(input.vendor, "criticalSupplier", "no") == "yes"
} else := {
	"disposition": "reject",
	"reasons": [],
} if {
	input.vendor.riskScore >= 90
} else := {
	"disposition": "reject",
	"reasons": [],
} if {
	input.vendor.countryRisk == "HIGH"
	input.vendor.riskScore >= 70
} else := {
	"disposition": "reject",
	"reasons": [],
} if {
	object.get(input.vendor, "priorEnforcement", "no") == "yes"
} else := {
	"disposition": "approve",
	"reasons": [],
} if {
	input.vendor.countryRisk == "LOW"
	input.vendor.riskScore < 40
	input.vendor.requestedSpend <= 500000
} else := {
	"disposition": "approve",
	"reasons": [],
} if {
	input.vendor.countryRisk == "LOW"
	input.vendor.riskScore < 40
	input.vendor.requestedSpend > 500000
	input.vendor.requestedSpend <= 2000000
	input.evidence["insurance-certificate"] == "present"
} else := {
	"disposition": "enhanced-review",
	"reasons": [],
} if {
	input.vendor.countryRisk == "LOW"
	input.vendor.riskScore < 40
	input.vendor.requestedSpend > 500000
	input.vendor.requestedSpend <= 2000000
	input.evidence["insurance-certificate"] == "absent"
} else := {
	"disposition": "unresolved",
	"reasons": ["unknown"],
} if {
	input.vendor.countryRisk == "LOW"
	input.vendor.riskScore < 40
	input.vendor.requestedSpend > 500000
	input.vendor.requestedSpend <= 2000000
	object.get(input.evidence, "insurance-certificate", "unreported") == "unreported"
} else := {
	"disposition": "approve",
	"reasons": [],
} if {
	input.vendor.countryRisk == "LOW"
	input.vendor.riskScore >= 40
	input.vendor.riskScore < 70
	input.vendor.requestedSpend <= 100000
	object.get(input.vendor, "newVendor", "no") != "yes"
} else := {
	"disposition": "approve",
	"reasons": [],
} if {
	input.vendor.countryRisk == "MEDIUM"
	input.vendor.riskScore < 40
	input.vendor.requestedSpend <= 100000
} else := {

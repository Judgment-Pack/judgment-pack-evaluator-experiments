TESTS:
```rego
package study_test

import data.study

financial_present := {"financial-evidence": "present"}

test_missing_financial_evidence_precedes_rejection if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["missing-required-evidence"],
	} with input as {
		"vendor": {
			"riskScore": 100,
			"requestedSpend": 100,
			"sanctionsStatus": "MATCH",
			"countryRisk": "HIGH",
		},
		"evidence": {"financial-evidence": "absent"},
	}
}

test_unreported_financial_evidence_is_unknown if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["unknown"],
	} with input as {
		"vendor": {"sanctionsStatus": "MATCH"},
		"evidence": {},
	}
}

test_sanctions_match_rejects_critical_supplier if {
	study.decision.disposition == "reject" with input as {
		"vendor": {
			"riskScore": 10,
			"requestedSpend": 100,
			"sanctionsStatus": "MATCH",
			"countryRisk": "LOW",
			"criticalSupplier": "yes",
		},
		"evidence": financial_present,
	}
}

test_unknown_sanctions_has_no_match_ground if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["no-match"],
	} with input as {
		"vendor": {
			"sanctionsStatus": "UNKNOWN",
			"criticalSupplier": "yes",
		},
		"evidence": financial_present,
	}
}

test_critical_risk_rejects_if_country_unreadable if {
	study.decision.disposition == "reject" with input as {
		"vendor": {
			"riskScore": 95,
			"requestedSpend": 1000000,
			"sanctionsStatus": "CLEAR",
			"priorEnforcement": "no",
			"criticalSupplier": "no",
		},
		"evidence": financial_present,
	}
}

test_high_country_rejects_at_risk_70 if {
	study.decision.disposition == "reject" with input as {
		"vendor": {
			"riskScore": 70,
			"requestedSpend": 2000000,
			"sanctionsStatus": "CLEAR",
			"countryRisk": "HIGH",
		},
		"evidence": financial_present,
	}
}

test_prior_enforcement_rejects if {
	study.decision.disposition == "reject" with input as {
		"vendor": {
			"riskScore": 1,
			"requestedSpend": 1,
			"sanctionsStatus": "CLEAR",
			"countryRisk": "LOW",
			"priorEnforcement": "yes",
		},
		"evidence": financial_present,
	}
}

test_low_risk_low_country_approves_at_500000 if {
	study.decision.disposition == "approve" with input as {
		"vendor": {
			"riskScore": 39,
			"requestedSpend": 500000,
			"sanctionsStatus": "CLEAR",
			"countryRisk": "LOW",
		},
		"evidence": financial_present,
	}
}

test_insured_low_risk_request_approves_at_2000000 if {
	study.decision.disposition == "approve" with input as {
		"vendor": {
			"riskScore": 39,
			"requestedSpend": 2000000,
			"sanctionsStatus": "CLEAR",
			"countryRisk": "LOW",
		},
		"evidence": {
			"financial-evidence": "present",
			"insurance-certificate": "present",
		},
	}
}

test_absent_insurance_gets_enhanced_review if {
	study.decision.disposition == "enhanced-review" with input as {
		"vendor": {
			"riskScore": 39,
			"requestedSpend": 500000.01,
			"sanctionsStatus": "CLEAR",
			"countryRisk": "LOW",
		},
		"evidence": {
			"financial-evidence": "present",
			"insurance-certificate": "absent",
		},
	}
}

test_unreported_insurance_is_unknown if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["unknown"],
	} with input as {
		"vendor": {
			"riskScore": 39,
			"requestedSpend": 500000.01,
			"sanctionsStatus": "CLEAR",
			"countryRisk": "LOW",
		},
		"evidence": financial_present,
	}
}

test_d6c_approves_existing_vendor if {
	study.decision.disposition == "approve" with input as {
		"vendor": {
			"riskScore": 40,
			"requestedSpend": 100000,
			"sanctionsStatus": "CLEAR",
			"countryRisk": "LOW",
			"newVendor": "no",
		},
		"evidence": financial_present,
	}
}

test_new_vendor_suspends_d6c if {
	study.decision.disposition == "review" with input as {
		"vendor": {
			"riskScore": 40,
			"requestedSpend": 100000,
			"sanctionsStatus": "CLEAR",
			"countryRisk": "LOW",
			"newVendor": "yes",
		},
		"evidence": financial_present,
	}
}

test_medium_country_approval_boundary if {
	study.decision.disposition == "approve" with input as {
		"vendor": {
			"riskScore": 39,
			"requestedSpend": 100000,
			"sanctionsStatus": "CLEAR",
			"countryRisk": "MEDIUM",
		},
		"evidence": financial_present,
	}
}

test_critical_supplier_overrides_automatic_rejection if {
	study.decision.disposition == "review" with input as {
		"vendor": {
			"riskScore": 99,
			"requestedSpend": 100,
			"sanctionsStatus": "CLEAR",
			"countryRisk": "LOW",
			"criticalSupplier": "yes",
		},
		"evidence": financial_present,
	}
}

test_critical_supplier_overrides_unreported_insurance if {
	study.decision.disposition == "review" with input as {
		"vendor": {
			"riskScore": 10,
			"requestedSpend": 1000000,
			"sanctionsStatus": "CLEAR",
			"countryRisk": "LOW",
			"criticalSupplier": "yes",
		},
		"evidence": financial_present,
	}
}

test_o3_escalation_precedes_critical_supplier_override if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["exception-escalation"],
	} with input as {
		"vendor": {
			"riskScore": 99,
			"requestedSpend": 2000000.01,
			"sanctionsStatus": "CLEAR",
			"countryRisk": "HIGH",
			"criticalSupplier": "yes",
		},
		"evidence": financial_present,
	}
}

test_unreadable_spend_can_make_high_country_unknown if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["unknown"],
	} with input as {
		"vendor": {
			"riskScore": 50,
			"sanctionsStatus": "CLEAR",
			"countryRisk": "HIGH",
			"criticalSupplier": "no",
		},
		"evidence": financial_present,
	}
}

test_critical_supplier_does_not_depend_on_unreadable_risk if {
	study.decision.disposition == "review" with input as {
		"vendor": {
			"requestedSpend": 100,
			"sanctionsStatus": "CLEAR",
			"countryRisk": "LOW",
			"criticalSupplier": "yes",
		},
		"evidence": financial_present,
	}
}

test_unreadable_country_and_spend_can_distinguish_o2_from_o3 if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["unknown"],
	} with input as {
		"vendor": {
			"riskScore": 10,
			"sanctionsStatus": "CLEAR",
			"criticalSupplier": "yes",
		},
		"evidence": financial_present,
	}
}

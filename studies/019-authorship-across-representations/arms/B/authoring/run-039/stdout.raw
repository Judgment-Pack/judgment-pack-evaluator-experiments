POLICY:
```rego
package study

# P1: Financial evidence is an absolute precondition.
decision := {
	"disposition": "unresolved",
	"reasons": ["missing-required-evidence"],
} if {
	object.get(input.evidence, "financial-evidence", "") == "absent"
}

decision := {
	"disposition": "unresolved",
	"reasons": ["unknown"],
} if {
	not "financial-evidence" in object.keys(input.evidence)
}

# U1: Evaluate every outcome class for each unreadable numeric/country input.
# A unanimous set contains exactly one outcome; otherwise the case is unknown.
decision := d if {
	input.evidence["financial-evidence"] == "present"
	outcomes := {
		outcome |
		some risk in risk_candidates
		some spend in spend_candidates
		some country in country_candidates
		vendor := object.union(input.vendor, {
			"riskScore": risk,
			"requestedSpend": spend,
			"countryRisk": country,
		})
		outcome := concrete_decision(vendor)
	}
	count(outcomes) == 1
	some d in outcomes
}

decision := {
	"disposition": "unresolved",
	"reasons": ["unknown"],
} if {
	input.evidence["financial-evidence"] == "present"
	outcomes := {
		outcome |
		some risk in risk_candidates
		some spend in spend_candidates
		some country in country_candidates
		vendor := object.union(input.vendor, {
			"riskScore": risk,
			"requestedSpend": spend,
			"countryRisk": country,
		})
		outcome := concrete_decision(vendor)
	}
	count(outcomes) > 1
}

# Each list contains one representative from every policy-relevant outcome
# interval. A reported input replaces the corresponding representative list.
risk_candidates := [input.vendor.riskScore] if {
	"riskScore" in object.keys(input.vendor)
} else := [0, 40, 70, 90]

spend_candidates := [input.vendor.requestedSpend] if {
	"requestedSpend" in object.keys(input.vendor)
} else := [0, 100000, 100001, 500000, 500001, 2000000, 2000001]

country_candidates := [input.vendor.countryRisk] if {
	"countryRisk" in object.keys(input.vendor)
} else := ["LOW", "MEDIUM", "HIGH"]

# O3: large exposure in a high-risk country.
concrete_decision(vendor) := {
	"disposition": "unresolved",
	"reasons": ["exception-escalation"],
} if {
	vendor.sanctionsStatus == "CLEAR"
	vendor.countryRisk == "HIGH"
	vendor.requestedSpend > 2000000
} else := {
	# O2: critical-supplier override.
	"disposition": "review",
	"reasons": [],
} if {
	vendor.sanctionsStatus == "CLEAR"
	object.get(vendor, "criticalSupplier", "no") == "yes"
} else := {
	# D1: sanctions match.
	"disposition": "reject",
	"reasons": [],
} if {
	vendor.sanctionsStatus == "MATCH"
} else := {
	# D2: screening ran but returned no result.
	"disposition": "unresolved",
	"reasons": ["no-match"],
} if {
	vendor.sanctionsStatus == "UNKNOWN"
} else := {
	# D3: critical risk.
	"disposition": "reject",
	"reasons": [],
} if {
	vendor.sanctionsStatus == "CLEAR"
	vendor.riskScore >= 90
} else := {
	# D4: elevated risk in a high-risk country.
	"disposition": "reject",
	"reasons": [],
} if {
	vendor.sanctionsStatus == "CLEAR"
	vendor.countryRisk == "HIGH"
	vendor.riskScore >= 70
} else := {
	# D5: prior enforcement action.
	"disposition": "reject",
	"reasons": [],
} if {
	vendor.sanctionsStatus == "CLEAR"
	object.get(vendor, "priorEnforcement", "no") == "yes"
} else := {
	# D6a.
	"disposition": "approve",
	"reasons": [],
} if {
	vendor.sanctionsStatus == "CLEAR"
	vendor.countryRisk == "LOW"
	vendor.riskScore < 40
	vendor.requestedSpend <= 500000
} else := {
	# D6b, insurance available.
	"disposition": "approve",
	"reasons": [],
} if {
	vendor.sanctionsStatus == "CLEAR"
	vendor.countryRisk == "LOW"
	vendor.riskScore < 40
	vendor.requestedSpend > 500000
	vendor.requestedSpend <= 2000000
	input.evidence["insurance-certificate"] == "present"
} else := {
	# D6b, insurance absent.
	"disposition": "enhanced-review",
	"reasons": [],
} if {
	vendor.sanctionsStatus == "CLEAR"
	vendor.countryRisk == "LOW"
	vendor.riskScore < 40
	vendor.requestedSpend > 500000
	vendor.requestedSpend <= 2000000
	input.evidence["insurance-certificate"] == "absent"
} else := {
	# D6b, insurance availability unreported.
	"disposition": "unresolved",
	"reasons": ["unknown"],
} if {
	vendor.sanctionsStatus == "CLEAR"
	vendor.countryRisk == "LOW"
	vendor.riskScore < 40
	vendor.requestedSpend > 500000
	vendor.requestedSpend <= 2000000
	not "insurance-certificate" in object.keys(input.evidence)
} else := {
	# D6c, subject to O1.
	"disposition": "approve",
	"reasons": [],
} if {
	vendor.sanctionsStatus == "CLEAR"
	vendor.countryRisk == "LOW"
	vendor.riskScore >= 40
	vendor.riskScore < 70
	vendor.requestedSpend <= 100000
	object.get(vendor, "newVendor", "no") != "yes"
} else := {
	# D7.
	"disposition": "approve",
	"reasons": [],
} if {
	vendor.sanctionsStatus == "CLEAR"
	vendor.countryRisk == "MEDIUM"
	vendor.riskScore < 40
	vendor.requestedSpend <= 100000
} else := {
	# D8.
	"disposition": "review",
	"reasons": [],
} if {
	vendor.sanctionsStatus == "CLEAR"
}
```

TESTS:
```rego
package study_test

import data.study

financial_present := {"financial-evidence": "present"}

test_p1_absent_blocks_rejection if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["missing-required-evidence"],
	} with input as {
		"vendor": {
			"sanctionsStatus": "MATCH",
			"riskScore": 95,
			"requestedSpend": 100,
			"countryRisk": "HIGH",
		},
		"evidence": {"financial-evidence": "absent"},
	}
}

test_p1_unreported_is_unknown if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["unknown"],
	} with input as {
		"vendor": {"sanctionsStatus": "MATCH"},
		"evidence": {},
	}
}

test_sanctions_match_rejects_despite_unreadable_fields if {
	study.decision == {
		"disposition": "reject",
		"reasons": [],
	} with input as {
		"vendor": {"sanctionsStatus": "MATCH"},
		"evidence": financial_present,
	}
}

test_unknown_sanctions_has_no_match if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["no-match"],
	} with input as {
		"vendor": {"sanctionsStatus": "UNKNOWN"},
		"evidence": financial_present,
	}
}

test_d3_rejects_at_90 if {
	study.decision.disposition == "reject" with input as {
		"vendor": {
			"sanctionsStatus": "CLEAR",
			"riskScore": 90,
			"requestedSpend": 100,
			"countryRisk": "LOW",
		},
		"evidence": financial_present,
	}
}

test_d4_rejects_high_country_at_70 if {
	study.decision.disposition == "reject" with input as {
		"vendor": {
			"sanctionsStatus": "CLEAR",
			"riskScore": 70,
			"requestedSpend": 100,
			"countryRisk": "HIGH",
		},
		"evidence": financial_present,
	}
}

test_prior_enforcement_rejects if {
	study.decision.disposition == "reject" with input as {
		"vendor": {
			"sanctionsStatus": "CLEAR",
			"riskScore": 10,
			"requestedSpend": 100,
			"countryRisk": "LOW",
			"priorEnforcement": "yes",
		},
		"evidence": financial_present,
	}
}

test_d6a_approves_boundary if {
	study.decision.disposition == "approve" with input as {
		"vendor": {
			"sanctionsStatus": "CLEAR",
			"riskScore": 39,
			"requestedSpend": 500000,
			"countryRisk": "LOW",
		},
		"evidence": financial_present,
	}
}

test_d6b_present_insurance_approves if {
	study.decision.disposition == "approve" with input as {
		"vendor": {
			"sanctionsStatus": "CLEAR",
			"riskScore": 20,
			"requestedSpend": 2000000,
			"countryRisk": "LOW",
		},
		"evidence": {
			"financial-evidence": "present",
			"insurance-certificate": "present",
		},
	}
}

test_d6b_absent_insurance_enhanced_review if {
	study.decision.disposition == "enhanced-review" with input as {
		"vendor": {
			"sanctionsStatus": "CLEAR",
			"riskScore": 20,
			"requestedSpend": 500001,
			"countryRisk": "LOW",
		},
		"evidence": {
			"financial-evidence": "present",
			"insurance-certificate": "absent",
		},
	}
}

test_d6b_unreported_insurance_unknown if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["unknown"],
	} with input as {
		"vendor": {
			"sanctionsStatus": "CLEAR",
			"riskScore": 20,
			"requestedSpend": 500001,
			"countryRisk": "LOW",
		},
		"evidence": financial_present,
	}
}

test_d6c_approves_existing_vendor if {
	study.decision.disposition == "approve" with input as {
		"vendor": {
			"sanctionsStatus": "CLEAR",
			"riskScore": 40,
			"requestedSpend": 100000,
			"countryRisk": "LOW",
			"newVendor": "no",
		},
		"evidence": financial_present,
	}
}

test_o1_suspends_d6c_for_new_vendor if {

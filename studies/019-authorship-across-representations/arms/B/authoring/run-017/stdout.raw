			"financial-evidence": "present",
			"insurance-certificate": "absent",
		},
	}
	actual == {"disposition": "enhanced-review", "reasons": []}
}

test_d6b_unreported_insurance_is_unknown if {
	actual := study.decision with input as {
		"vendor": object.union(base_vendor, {"requestedSpend": 600000}),
		"evidence": financial_present,
	}
	actual == {

POLICY:
```rego
package study

# P1: financial evidence is required before any other clause applies.
decision := {
	"disposition": "unresolved",
	"reasons": ["missing-required-evidence"],
} if {
	object.get(input.evidence, "financial-evidence", "unreported") == "absent"
}

decision := {
	"disposition": "unresolved",
	"reasons": ["unknown"],
} if {
	object.get(input.evidence, "financial-evidence", "unreported") == "unreported"
}

# D1 applies to MATCH without consulting unreadable numeric or country inputs.
decision := {
	"disposition": "reject",
	"reasons": [],
} if {
	input.evidence["financial-evidence"] == "present"
	input.vendor.sanctionsStatus == "MATCH"
}

# D2 applies to the present string value UNKNOWN.
decision := {
	"disposition": "unresolved",
	"reasons": ["no-match"],
} if {
	input.evidence["financial-evidence"] == "present"
	input.vendor.sanctionsStatus == "UNKNOWN"
}

# For CLEAR screening results, evaluate every readable assignment permitted by
# U1. If all assignments yield the same complete outcome, issue that outcome.
decision := result if {
	input.evidence["financial-evidence"] == "present"
	input.vendor.sanctionsStatus == "CLEAR"
	outcomes := {
		result |
		some risk in risk_values
		some spend in spend_values
		some country in country_values
		result := clear_outcome(risk, spend, country)
	}
	count(outcomes) == 1
	some result in outcomes
}

# The representative values cover every outcome-relevant equivalence class.
risk_values := [risk] if {
	risk := input.vendor.riskScore
} else := [0, 39, 40, 69, 70, 89, 90]

spend_values := [spend] if {
	spend := input.vendor.requestedSpend
} else := [0, 100000, 100000.01, 500000, 500000.01, 2000000, 2000000.01]

country_values := [country] if {
	country := input.vendor.countryRisk
} else := ["LOW", "MEDIUM", "HIGH"]

# O3 precedes O2 and every determination clause.
clear_outcome(_, spend, country) := {
	"disposition": "unresolved",
	"reasons": ["exception-escalation"],
} if {
	country == "HIGH"
	spend > 2000000
} else := {
	"disposition": "review",
	"reasons": [],
} if {
	object.get(input.vendor, "criticalSupplier", "no") == "yes"
} else := {
	"disposition": "reject",
	"reasons": [],
} if {
	risk >= 90
} else := {
	"disposition": "reject",
	"reasons": [],
} if {
	country == "HIGH"
	risk >= 70
} else := {
	"disposition": "reject",
	"reasons": [],
} if {
	object.get(input.vendor, "priorEnforcement", "no") == "yes"
} else := {
	"disposition": "approve",
	"reasons": [],
} if {
	country == "LOW"
	risk < 40
	spend <= 500000
} else := {
	"disposition": "approve",
	"reasons": [],
} if {
	country == "LOW"
	risk < 40
	spend > 500000
	spend <= 2000000
	input.evidence["insurance-certificate"] == "present"
} else := {
	"disposition": "enhanced-review",
	"reasons": [],
} if {
	country == "LOW"
	risk < 40
	spend > 500000
	spend <= 2000000
	input.evidence["insurance-certificate"] == "absent"
} else := {
	"disposition": "unresolved",
	"reasons": ["unknown"],
} if {
	country == "LOW"
	risk < 40
	spend > 500000
	spend <= 2000000
	object.get(input.evidence, "insurance-certificate", "unreported") == "unreported"
} else := {
	"disposition": "approve",
	"reasons": [],
} if {
	country == "LOW"
	risk >= 40
	risk < 70
	spend <= 100000
	object.get(input.vendor, "newVendor", "no") != "yes"
} else := {
	"disposition": "approve",
	"reasons": [],
} if {
	country == "MEDIUM"
	risk < 40
	spend <= 100000
} else := {
	"disposition": "review",
	"reasons": [],
}
```

TESTS:
```rego
package study_test

import data.study

financial_present := {
	"financial-evidence": "present",
}

base_vendor := {
	"riskScore": 20,
	"requestedSpend": 1000,
	"sanctionsStatus": "CLEAR",
	"countryRisk": "LOW",
	"newVendor": "no",
	"criticalSupplier": "no",
	"priorEnforcement": "no",
}

test_p1_absent_precedes_sanctions_match if {
	actual := study.decision with input as {
		"vendor": object.union(base_vendor, {"sanctionsStatus": "MATCH"}),
		"evidence": {"financial-evidence": "absent"},
	}
	actual == {
		"disposition": "unresolved",
		"reasons": ["missing-required-evidence"],
	}
}

test_p1_unreported_is_unknown if {
	actual := study.decision with input as {
		"vendor": object.union(base_vendor, {"sanctionsStatus": "MATCH"}),
		"evidence": {},
	}
	actual == {
		"disposition": "unresolved",
		"reasons": ["unknown"],
	}
}

test_d1_match_rejects_without_numeric_inputs if {
	actual := study.decision with input as {
		"vendor": {"sanctionsStatus": "MATCH"},
		"evidence": financial_present,
	}
	actual == {"disposition": "reject", "reasons": []}
}

test_d2_unknown_screening_has_no_match if {
	actual := study.decision with input as {
		"vendor": object.union(base_vendor, {"sanctionsStatus": "UNKNOWN"}),
		"evidence": financial_present,
	}
	actual == {
		"disposition": "unresolved",
		"reasons": ["no-match"],
	}
}

test_o3_precedes_critical_supplier_and_rejection if {
	actual := study.decision with input as {
		"vendor": {
			"riskScore": 95,
			"requestedSpend": 2000000.01,
			"sanctionsStatus": "CLEAR",
			"countryRisk": "HIGH",
			"criticalSupplier": "yes",
			"priorEnforcement": "yes",
		},
		"evidence": financial_present,
	}
	actual == {
		"disposition": "unresolved",
		"reasons": ["exception-escalation"],
	}
}

test_o3_boundary_at_two_million_does_not_escalate if {
	actual := study.decision with input as {
		"vendor": {
			"riskScore": 20,
			"requestedSpend": 2000000,
			"sanctionsStatus": "CLEAR",
			"countryRisk": "HIGH",
			"criticalSupplier": "yes",
		},
		"evidence": financial_present,
	}
	actual == {"disposition": "review", "reasons": []}
}

test_o2_displaces_critical_risk_rejection if {
	actual := study.decision with input as {
		"vendor": {
			"riskScore": 95,
			"requestedSpend": 100,
			"sanctionsStatus": "CLEAR",
			"countryRisk": "LOW",
			"criticalSupplier": "yes",
		},
		"evidence": financial_present,
	}
	actual == {"disposition": "review", "reasons": []}
}

test_o2_displaces_unreported_insurance_limb if {
	actual := study.decision with input as {
		"vendor": {
			"riskScore": 20,
			"requestedSpend": 600000,
			"sanctionsStatus": "CLEAR",
			"countryRisk": "LOW",
			"criticalSupplier": "yes",
		},
		"evidence": financial_present,
	}
	actual == {"disposition": "review", "reasons": []}
}

test_d3_rejects_at_ninety if {
	actual := study.decision with input as {
		"vendor": object.union(base_vendor, {"riskScore": 90}),
		"evidence": financial_present,
	}
	actual == {"disposition": "reject", "reasons": []}
}

test_d4_high_country_rejects_at_seventy if {
	actual := study.decision with input as {
		"vendor": object.union(base_vendor, {
			"riskScore": 70,
			"countryRisk": "HIGH",
		}),
		"evidence": financial_present,
	}
	actual == {"disposition": "reject", "reasons": []}
}

test_d5_prior_enforcement_rejects if {
	actual := study.decision with input as {
		"vendor": object.union(base_vendor, {"priorEnforcement": "yes"}),
		"evidence": financial_present,
	}
	actual == {"disposition": "reject", "reasons": []}
}

test_d6a_approves_at_five_hundred_thousand if {
	actual := study.decision with input as {
		"vendor": object.union(base_vendor, {"requestedSpend": 500000}),
		"evidence": financial_present,
	}
	actual == {"disposition": "approve", "reasons": []}
}

test_d6b_present_insurance_approves_at_two_million if {
	actual := study.decision with input as {
		"vendor": object.union(base_vendor, {"requestedSpend": 2000000}),
		"evidence": {
			"financial-evidence": "present",
			"insurance-certificate": "present",
		},
	}
	actual == {"disposition": "approve", "reasons": []}
}

test_d6b_absent_insurance_enhanced_review if {

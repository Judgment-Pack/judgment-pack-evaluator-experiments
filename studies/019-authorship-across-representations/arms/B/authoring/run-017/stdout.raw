			"requestedSpend": 1000000,
			"sanctionsStatus": "CLEAR",
			"criticalSupplier": "no",
			"priorEnforcement": "no",
		},
		"evidence": financial_present,
	}
	actual == {"disposition": "reject", "reasons": []}
}

test_u1_unreadable_spend_in_high_country_is_unknown if {
	actual := study.decision with input as {
		"vendor": {
			"riskScore": 50,
			"sanctionsStatus": "CLEAR",
			"countryRisk": "HIGH",
			"criticalSupplier": "no",
		},
		"evidence": financial_present,
	}
	actual == {
		"disposition": "unresolved",
		"reasons": ["unknown"],

POLICY:
```rego
package study

# Vendor Approval Policy.
#
# U1 is implemented by evaluating every policy-distinct assignment for omitted
# risk, spend, and country inputs. If all assignments produce the same outcome,
# that outcome stands; otherwise the case is unresolved as unknown.

financial_status := object.get(input.evidence, "financial-evidence", "unreported")

risk_values := [input.vendor.riskScore] if {
	"riskScore" in input.vendor
} else := [0, 39, 40, 69, 70, 89, 90]

spend_values := [input.vendor.requestedSpend] if {
	"requestedSpend" in input.vendor
} else := [
	0,
	100000,
	100000.01,
	500000,
	500000.01,
	2000000,
	2000000.01,
]

country_values := [input.vendor.countryRisk] if {
	"countryRisk" in input.vendor
} else := ["LOW", "MEDIUM", "HIGH"]

has_unreadable_policy_input if {
	not "riskScore" in input.vendor
}

has_unreadable_policy_input if {
	not "requestedSpend" in input.vendor
}

has_unreadable_policy_input if {
	not "countryRisk" in input.vendor
}

candidate_outcomes := {
	outcome |
	some risk in risk_values
	some spend in spend_values
	some country in country_values
	outcome := outcome_for(risk, spend, country)
}

sole_candidate_outcome := outcome if {
	count(candidate_outcomes) == 1
	some outcome in candidate_outcomes
}

decision := {
	"disposition": "unresolved",
	"reasons": ["missing-required-evidence"],
} if {
	financial_status == "absent"
} else := {
	"disposition": "unresolved",
	"reasons": ["unknown"],
} if {
	financial_status == "unreported"
} else := {
	"disposition": "unresolved",
	"reasons": ["unknown"],
} if {
	financial_status == "present"
	has_unreadable_policy_input
	count(candidate_outcomes) != 1
} else := sole_candidate_outcome if {
	financial_status == "present"
}

# P1 has already been satisfied before outcome_for is evaluated.
# The ordered else chain implements O3, O2, and D1-D8 precedence.

outcome_for(risk, spend, country) := {
	"disposition": "reject",
	"reasons": [],
} if {
	input.vendor.sanctionsStatus == "MATCH"
} else := {
	"disposition": "unresolved",
	"reasons": ["no-match"],
} if {
	input.vendor.sanctionsStatus == "UNKNOWN"
} else := {
	"disposition": "unresolved",
	"reasons": ["exception-escalation"],
} if {
	input.vendor.sanctionsStatus == "CLEAR"
	country == "HIGH"
	spend > 2000000
} else := {
	"disposition": "review",
	"reasons": [],
} if {
	input.vendor.sanctionsStatus == "CLEAR"
	object.get(input.vendor, "criticalSupplier", "no") == "yes"
} else := {
	"disposition": "reject",
	"reasons": [],
} if {
	input.vendor.sanctionsStatus == "CLEAR"
	risk >= 90
} else := {
	"disposition": "reject",
	"reasons": [],
} if {
	input.vendor.sanctionsStatus == "CLEAR"
	country == "HIGH"
	risk >= 70
} else := {
	"disposition": "reject",
	"reasons": [],
} if {
	input.vendor.sanctionsStatus == "CLEAR"
	object.get(input.vendor, "priorEnforcement", "no") == "yes"
} else := {
	"disposition": "approve",
	"reasons": [],
} if {
	input.vendor.sanctionsStatus == "CLEAR"
	country == "LOW"
	risk < 40
	spend <= 500000
} else := {
	"disposition": "approve",
	"reasons": [],
} if {
	input.vendor.sanctionsStatus == "CLEAR"
	country == "LOW"
	risk < 40
	spend > 500000
	spend <= 2000000
	object.get(input.evidence, "insurance-certificate", "unreported") == "present"
} else := {
	"disposition": "enhanced-review",
	"reasons": [],
} if {
	input.vendor.sanctionsStatus == "CLEAR"
	country == "LOW"
	risk < 40
	spend > 500000
	spend <= 2000000
	object.get(input.evidence, "insurance-certificate", "unreported") == "absent"
} else := {
	"disposition": "unresolved",
	"reasons": ["unknown"],
} if {
	input.vendor.sanctionsStatus == "CLEAR"
	country == "LOW"
	risk < 40
	spend > 500000
	spend <= 2000000
	object.get(input.evidence, "insurance-certificate", "unreported") == "unreported"
} else := {
	"disposition": "approve",
	"reasons": [],
} if {
	input.vendor.sanctionsStatus == "CLEAR"
	country == "LOW"
	risk >= 40
	risk < 70
	spend <= 100000
	object.get(input.vendor, "newVendor", "no") != "yes"
} else := {
	"disposition": "approve",
	"reasons": [],
} if {
	input.vendor.sanctionsStatus == "CLEAR"
	country == "MEDIUM"
	risk < 40
	spend <= 100000
	object.get(input.vendor, "priorEnforcement", "no") != "yes"
} else := {
	"disposition": "review",
	"reasons": [],
} if {
	input.vendor.sanctionsStatus == "CLEAR"
}
```

TESTS:
```rego
package study_test

import data.study

financial_present := {"financial-evidence": "present"}

test_p1_absent_evidence_precedes_sanctions_match if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["missing-required-evidence"],
	} with input as {
		"vendor": {
			"riskScore": 99,
			"requestedSpend": 10,
			"sanctionsStatus": "MATCH",
			"countryRisk": "HIGH",
		},
		"evidence": {"financial-evidence": "absent"},
	}
}

test_p1_unreported_evidence_is_unknown if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["unknown"],
	} with input as {
		"vendor": {
			"riskScore": 10,
			"requestedSpend": 10,
			"sanctionsStatus": "CLEAR",
			"countryRisk": "LOW",
		},
		"evidence": {},
	}
}

test_d1_sanctions_match_rejects_despite_other_missing_inputs if {
	study.decision == {
		"disposition": "reject",
		"reasons": [],
	} with input as {
		"vendor": {"sanctionsStatus": "MATCH"},
		"evidence": financial_present,
	}
}

test_d2_unknown_sanctions_has_no_match if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["no-match"],
	} with input as {
		"vendor": {"sanctionsStatus": "UNKNOWN"},
		"evidence": financial_present,
	}
}

test_o3_escalation_precedes_critical_supplier_and_rejection if {
	study.decision == {
		"disposition": "unresolved",
		"reasons": ["exception-escalation"],
	} with input as {
		"vendor": {
			"riskScore": 95,
			"requestedSpend": 2000000.01,
			"sanctionsStatus": "CLEAR",
			"countryRisk": "HIGH",
			"criticalSupplier": "yes",
			"priorEnforcement": "yes",
		},
		"evidence": financial_present,
	}
}

test_o3_boundary_at_two_million_does_not_escalate if {
	study.decision == {
		"disposition": "reject",
		"reasons": [],
	} with input as {
		"vendor": {
			"riskScore": 70,
			"requestedSpend": 2000000,
			"sanctionsStatus": "CLEAR",
			"countryRisk": "HIGH",
		},
		"evidence": financial_present,
	}
}

test_o2_critical_supplier_displaces_automatic_rejection if {
	study.decision == {
		"disposition": "review",
		"reasons": [],
	} with input as {
		"vendor": {
			"riskScore": 99,
			"requestedSpend": 100,
			"sanctionsStatus": "CLEAR",
			"countryRisk": "LOW",
			"criticalSupplier": "yes",
			"priorEnforcement": "yes",
		},
		"evidence": financial_present,
	}
}

test_o2_displaces_unreported_insurance_limb if {
	study.decision == {
		"disposition": "review",
		"reasons": [],
	} with input as {
		"vendor": {
			"riskScore": 20,
			"requestedSpend": 600000,
			"sanctionsStatus": "CLEAR",
			"countryRisk": "LOW",
			"criticalSupplier": "yes",
		},
		"evidence": financial_present,
	}
}

test_d3_rejects_at_ninety if {
	study.decision.disposition == "reject" with input as {
		"vendor": {
			"riskScore": 90,
			"requestedSpend": 1,
			"sanctionsStatus": "CLEAR",
			"countryRisk": "MEDIUM",
		},
		"evidence": financial_present,
	}
}

test_d4_high_country_rejects_at_seventy if {
	study.decision.disposition == "reject" with input as {
		"vendor": {
			"riskScore": 70,
			"requestedSpend": 1,
			"sanctionsStatus": "CLEAR",
			"countryRisk": "HIGH",
		},
		"evidence": financial_present,

            "value": "yes"
          }
        ]
      },
      "effect": "suppress-rule",
      "targetRule": "low-moderate-risk-small-spend-approve",
      "onUnknown": "ignore"
    },
    {
      "id": "prior-suppress-new-low-moderate-review",
      "description": "D5 precedence suppresses O1 review when prior enforcement is recorded.",
      "when": {
        "op": "all",
        "conditions": [
          {

      "effect": "suppress-rule",
      "targetRule": "clear-default-review",
      "onUnknown": "ignore"
    },
    {
      "id": "new-vendor-suppress-low-moderate",
      "description": "O1 suppresses D6c for a reported new vendor.",
      "when": {
        "op": "fact",
        "path": "/vendor/newVendor",
        "operator": "equals",
        "value": "yes"
      },
      "effect": "suppress-rule",
      "targetRule": "low-moderate-risk-small-spend-approve",
      "onUnknown": "ignore"
    },
    {
      "id": "critical-risk-suppress-high-elevated",

          }
        ]
      },
      "effect": "suppress-rule",
      "targetRule": "clear-default-review",
      "onUnknown": "ignore"
    },
    {
      "id": "high-elevated-suppress-clear-review",
      "description": "D4 suppresses D8 in its rejection band.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
